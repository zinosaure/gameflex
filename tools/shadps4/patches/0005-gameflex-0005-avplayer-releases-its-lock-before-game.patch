From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Gino D." <25200363+zinosaure@users.noreply.github.com>
Date: Wed, 11 Nov 2026 19:35:11 +0100
Subject: [PATCH] gameflex 0005: avplayer releases its lock before game events

AvPlayerState kept m_source_mutex while calling Stop(), which takes it,
and while raising the game's event, whose callback runs on the same
thread and calls back into AvPlayer. Relocking the rwlock it held for
writing (EDEADLK) threw, and the emulator ended at the first video of
Kingdom Hearts Melody of Memory. The lock is released before both.

Details: tools/shadps4/README.md in the GameFlex repository, entry 0005.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../libraries/avplayer/avplayer_state.cpp     | 40 ++++++++++++-------
 1 file changed, 26 insertions(+), 14 deletions(-)

diff --git a/src/core/libraries/avplayer/avplayer_state.cpp b/src/core/libraries/avplayer/avplayer_state.cpp
index c81f9e1c..aa6ae376 100644
--- a/src/core/libraries/avplayer/avplayer_state.cpp
+++ b/src/core/libraries/avplayer/avplayer_state.cpp
@@ -175,22 +175,31 @@ bool AvPlayerState::GetStreamInfo(u32 stream_index, AvPlayerStreamInfo& info) {
 
 // Called inside GAME thread
 bool AvPlayerState::Start() {
+    // GameFlex: m_source_mutex is released before Stop(), which takes it, and before the game's
+    // event, whose callback runs on this thread and calls back into AvPlayer. glibc refuses a
+    // thread relocking the rwlock it holds for writing (EDEADLK), std::shared_mutex throws, and
+    // the emulator ended: Kingdom Hearts Melody of Memory, at its first video. The same rule as
+    // UpdateEndOfFileState.
+    if (m_current_state != AvState::Ready && m_current_state != AvState::Stop && !Stop()) {
+        LOG_ERROR(Lib_AvPlayer, "Could not start playback.");
+        return false;
+    }
     std::unique_lock lock(m_source_mutex);
-    if (m_current_state == AvState::Ready || m_current_state == AvState::Stop || Stop()) {
-        m_eof_stop_event_sent = false;
-        SetState(AvState::Starting);
-        if (!m_up_source->Start()) {
-            LOG_ERROR(Lib_AvPlayer, "Could not start playback.");
-            SetState(AvState::Error);
-            return false;
-        }
-        SetState(AvState::Play);
-        OnPlaybackStateChanged(AvState::Play);
-        return true;
+    if (m_up_source == nullptr) {
+        LOG_ERROR(Lib_AvPlayer, "Could not start playback: no source.");
+        return false;
     }
-
-    LOG_ERROR(Lib_AvPlayer, "Could not start playback.");
-    return false;
+    m_eof_stop_event_sent = false;
+    SetState(AvState::Starting);
+    if (!m_up_source->Start()) {
+        LOG_ERROR(Lib_AvPlayer, "Could not start playback.");
+        SetState(AvState::Error);
+        return false;
+    }
+    SetState(AvState::Play);
+    lock.unlock();
+    OnPlaybackStateChanged(AvState::Play);
+    return true;
 }
 
 // Called inside GAME thread
@@ -209,6 +218,7 @@ bool AvPlayerState::Pause() {
     if (!SetState(AvState::Pause)) {
         return false;
     }
+    lock.unlock(); // GameFlex: not across the game's event, see Start()
     OnPlaybackStateChanged(AvState::Pause);
     return true;
 }
@@ -223,6 +233,7 @@ bool AvPlayerState::Resume() {
     m_up_source->Resume();
     const auto state = m_previous_state.load();
     SetState(state);
+    lock.unlock(); // GameFlex: not across the game's event, see Start()
     OnPlaybackStateChanged(state);
     return true;
 }
@@ -290,6 +301,7 @@ bool AvPlayerState::Stop() {
         return false;
     }
     m_eof_stop_event_sent = true;
+    lock.unlock(); // GameFlex: not across the game's event, see Start()
     OnPlaybackStateChanged(AvState::Stop);
     return true;
 }
