From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Gino D." <25200363+zinosaure@users.noreply.github.com>
Date: Wed, 11 Nov 2026 19:35:11 +0100
Subject: [PATCH] gameflex 0011: an empty iovec list is not an error

readv, writev, preadv and pwritev accept iovcnt == 0 again, like the
FreeBSD kernel the console's descends from. Upstream refuses it since
2026-10-28 (EINVAL), and FC 27 could no longer save its settings.

Details: tools/shadps4/README.md in the GameFlex repository, entry 0011.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/core/libraries/kernel/file_system.cpp | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/src/core/libraries/kernel/file_system.cpp b/src/core/libraries/kernel/file_system.cpp
index 93a870d8..e1481b8d 100644
--- a/src/core/libraries/kernel/file_system.cpp
+++ b/src/core/libraries/kernel/file_system.cpp
@@ -706,11 +706,11 @@ s64 ReadFile(Core::FileSys::File* file, void* buf, u64 nbytes) {
 }
 
 s64 PS4_SYSV_ABI readv(s32 fd, const OrbisKernelIovec* iov, s32 iovcnt) {
-    if (iovcnt <= 0 || iovcnt > 1024) {
+    if (iovcnt < 0 || iovcnt > 1024) {
         *__Error() = POSIX_EINVAL;
         return -1;
     }
-    if (iov == nullptr) {
+    if (iov == nullptr && iovcnt > 0) {
         *__Error() = POSIX_EFAULT;
         return -1;
     }
@@ -779,11 +779,11 @@ s64 PS4_SYSV_ABI sceKernelReadv(s32 fd, const OrbisKernelIovec* iov, s32 iovcnt)
 }
 
 s64 PS4_SYSV_ABI writev(s32 fd, const OrbisKernelIovec* iov, s32 iovcnt) {
-    if (iovcnt <= 0 || iovcnt > 1024) {
+    if (iovcnt < 0 || iovcnt > 1024) {
         *__Error() = POSIX_EINVAL;
         return -1;
     }
-    if (iov == nullptr) {
+    if (iov == nullptr && iovcnt > 0) {
         *__Error() = POSIX_EFAULT;
         return -1;
     }
@@ -1990,11 +1990,11 @@ s32 PS4_SYSV_ABI sceKernelRename(const char* from, const char* to) {
 }
 
 s64 PS4_SYSV_ABI posix_preadv(s32 fd, const OrbisKernelIovec* iov, s32 iovcnt, s64 offset) {
-    if (offset < 0 || iovcnt <= 0 || iovcnt > 1024) {
+    if (offset < 0 || iovcnt < 0 || iovcnt > 1024) {
         *__Error() = POSIX_EINVAL;
         return -1;
     }
-    if (iov == nullptr) {
+    if (iov == nullptr && iovcnt > 0) {
         *__Error() = POSIX_EFAULT;
         return -1;
     }
@@ -2375,11 +2375,11 @@ s64 PS4_SYSV_ABI sceKernelGetdirentries(s32 fd, char* buf, u64 nbytes, s64* base
 }
 
 s64 PS4_SYSV_ABI posix_pwritev(s32 fd, const OrbisKernelIovec* iov, s32 iovcnt, s64 offset) {
-    if (offset < 0 || iovcnt <= 0 || iovcnt > 1024) {
+    if (offset < 0 || iovcnt < 0 || iovcnt > 1024) {
         *__Error() = POSIX_EINVAL;
         return -1;
     }
-    if (iov == nullptr) {
+    if (iov == nullptr && iovcnt > 0) {
         *__Error() = POSIX_EFAULT;
         return -1;
     }
