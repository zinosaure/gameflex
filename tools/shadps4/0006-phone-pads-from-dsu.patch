+// SPDX-FileCopyrightText: Copyright 2026 GameFlex
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+namespace Input::GameflexDsu {
+
+// GameFlex: the pads of a DSU (cemuhook) server, GAMEFLEX_DSU_SERVER=<ipv4>:<port>, as four SDL
+// virtual gamepads — TryOpenSDLControllers gives them to players 1 to 4, as it does the uinput
+// pads of our server. Our Android app serves its players this way: its X keyboard only had keys
+// for one. Does nothing without the variable. Call once the gamepad subsystem is up.
+void Start();
+
+} // namespace Input::GameflexDsu
