+bool CpuPatchesCanApply() noexcept {
+#if defined(__APPLE__)
+    return true;
+#else
+    static const bool can_apply = [] {
+        Cpu cpu;
+        return !cpu.has(Cpu::tSSE4a) || cpu.has(Cpu::tINTEL);
+    }();
+    return can_apply;
+#endif
+}
