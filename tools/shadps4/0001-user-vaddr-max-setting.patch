diff --git a/src/core/address_space.cpp b/src/core/address_space.cpp
index 10b0bc3..faa79c2 100644
--- a/src/core/address_space.cpp
+++ b/src/core/address_space.cpp
@@ -677,6 +677,22 @@ struct AddressSpace::Impl {
         system_managed_size = SystemManagedSize;
         system_reserved_size = SystemReservedSize;
         user_size = UserSize;
+        // A smaller user range on request (user_vaddr_max_in_gbytes): a kernel
+        // with a 39-bit user address space (Android GKI, 512 GiB) cannot hold
+        // the default range. shadPS4 already caps it at 1 TiB on Windows for
+        // SDK >= 3.00 titles, and its arm64 fork at 256 GiB on Android.
+        const s32 user_vaddr_max_gb = EmulatorSettings.GetUserVaddrMaxInGBytes();
+        if (user_vaddr_max_gb > 0) {
+            const u64 requested_max = (static_cast<u64>(user_vaddr_max_gb) << 30) - 1;
+            if (requested_max > USER_MIN && requested_max < USER_MAX) {
+                user_size = requested_max - USER_MIN + 1;
+                LOG_WARNING(Kernel_Vmm, "User virtual range capped at {} GiB: {:#x} - {:#x}",
+                            user_vaddr_max_gb, USER_MIN, requested_max);
+            } else {
+                LOG_ERROR(Kernel_Vmm, "user_vaddr_max_in_gbytes={} ignored: outside {:#x}-{:#x}",
+                          user_vaddr_max_gb, USER_MIN, USER_MAX);
+            }
+        }
 
         constexpr int protection_flags = PROT_READ | PROT_WRITE;
         int map_flags = MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED; // compiler knows its constexpr
