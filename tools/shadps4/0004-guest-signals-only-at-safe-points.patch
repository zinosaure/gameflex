+#ifndef _WIN32
+// GameFlex: A GUEST SIGNAL RUNS ONLY AT A SAFE POINT.
+//
+// WakeForSignal sends SIGUSR1, and its host handler (signals.cpp) used to run the guest handler
+// on the spot, wherever the thread was — in host code too, holding a host lock. Unity's IL2CPP
+// collector stops the world that way (signal 30), and its handler then waits for the end of the
+// collection: Kingdom Hearts Melody of Memory hung for good with Game:Main suspended in the
+// middle of a log line (the spdlog mutex), then — logging off — in malloc, then holding the
+// mutex of an event flag, and the thread raising the next signal waiting on that lock.
+//
+// A guest signal now runs where a PS4 kernel would deliver it: in guest code, or in an emulated
+// wait that holds no host lock (ParkedWait — for a wait on a host mutex, only while that mutex
+// is free). Anywhere else it stays pending, and SignalKicker sends SIGUSR1 again until the
+// thread is at such a point. After MaxDeferredKicks refusals (~50 ms), it runs anyway: a thread
+// blocked in a wait nobody marked gets what it got before.
+namespace {
+
+constexpr u32 MaxDeferredKicks = 250;
+constexpr auto KickInterval = std::chrono::microseconds(200);
+
+std::atomic<VAddr> g_guest_lo{0};
+std::atomic<VAddr> g_guest_hi{0};
+
+// The guest's address range, read once outside any signal handler.
+void NoteGuestRange() {
+    if (g_guest_hi.load(std::memory_order_acquire) != 0) {
+        return;
+    }
+    auto& space = Core::Memory::Instance()->GetAddressSpace();
+    g_guest_lo.store(space.SystemManagedVirtualBase(), std::memory_order_release);
+    g_guest_hi.store(space.UserVirtualBase() + space.UserVirtualSize(), std::memory_order_release);
+}
+
+class SignalKicker {
+public:
+    static SignalKicker& Instance() {
+        static SignalKicker kicker;
+        return kicker;
+    }
+
+    void Add(Pthread* thread) {
+        auto* thread_state = ThrState::Instance();
+        if (thread_state->RefAdd(thread, /*include dead*/ false) != 0) {
+            return;
+        }
+        bool known = false;
+        {
+            std::scoped_lock lk{mutex};
+            known = std::ranges::find(threads, thread) != threads.end();
+            if (!known) {
+                threads.push_back(thread);
+            }
+            if (!worker.joinable()) {
+                worker = std::jthread([this](std::stop_token stop) { Run(stop); });
+            }
+        }
+        if (known) {
+            thread_state->RefDelete(thread);
+        }
+        cv.notify_one();
+    }
+
+private:
+    void Run(std::stop_token stop) {
+        Common::SetCurrentThreadName("shadPS4:SignalKick");
+        std::vector<Pthread*> delivered;
+        std::unique_lock lk{mutex};
+        while (cv.wait(lk, stop, [this] { return !threads.empty(); })) {
+            lk.unlock();
+            std::this_thread::sleep_for(KickInterval);
+            lk.lock();
+            for (auto it = threads.begin(); it != threads.end();) {
+                Pthread* thread = *it;
+                if (thread->state != PthreadState::Dead && thread->HasDeliverableSignal()) {
+                    pthread_kill(reinterpret_cast<pthread_t>(thread->native_thr->GetHandle()),
+                                 SIGUSR1);
+                    ++it;
+                } else {
+                    delivered.push_back(thread);
+                    it = threads.erase(it);
+                }
+            }
+            lk.unlock();
+            for (Pthread* thread : delivered) {
+                ThrState::Instance()->RefDelete(thread);
+            }
+            delivered.clear();
+            lk.lock();
+        }
+    }
+
+    std::mutex mutex;
+    std::condition_variable_any cv;
+    std::vector<Pthread*> threads;
+    std::jthread worker;
+};
+
+} // namespace
+
+bool GuestSignalSafePoint(Pthread* thread, const void* code_address) {
+    const VAddr hi = g_guest_hi.load(std::memory_order_acquire);
+    if (hi == 0) {
+        return true; // the guest range is not known yet: the previous behaviour
+    }
+    const auto pc = reinterpret_cast<VAddr>(code_address);
+    bool safe = (pc >= g_guest_lo.load(std::memory_order_acquire) && pc < hi) ||
+                thread->self_raise.exchange(false, std::memory_order_acq_rel);
+    if (!safe) {
+        void* lock = thread->parked_lock.load(std::memory_order_acquire);
+        if (lock == ParkedNoLock()) {
+            safe = true;
+        } else if (lock != nullptr) {
+            // Parked in a wait on a host mutex: safe only while nobody holds it — the wait
+            // releases it while it sleeps, and this thread may be taking it back.
+            auto* mutex = static_cast<pthread_mutex_t*>(lock);
+            if (pthread_mutex_trylock(mutex) == 0) {
+                pthread_mutex_unlock(mutex);
+                safe = true;
+            }
+        }
+    }
+    if (!safe &&
+        thread->deferred_kicks.fetch_add(1, std::memory_order_acq_rel) + 1 < MaxDeferredKicks) {
+        return false;
+    }
+    thread->deferred_kicks.store(0, std::memory_order_release);
+    return true;
+}
+#else
+bool GuestSignalSafePoint(Pthread*, const void*) {
+    return true;
+}
+#endif
+
 s32 PS4_SYSV_ABI posix_pthread_kill(PthreadT thread, s32 sig) {
     if (sig < 1 || sig > 128) {
         return POSIX_EINVAL;
     }
     LOG_INFO(Lib_Kernel, "Raising signal {} on thread '{}'", sig, thread->name);
+#ifndef _WIN32
+    NoteGuestRange();
+#endif
     thread->QueueSignal(sig);
 
     if (!thread->IsSignalBlocked(sig)) {
         thread->WakeForSignal();
+#ifndef _WIN32
+        // GameFlex: until it reaches a safe point (GuestSignalSafePoint).
+        if (thread != g_curthread) {
+            SignalKicker::Instance().Add(thread);
+        }
+#endif
     }
     return ORBIS_OK;
 }
