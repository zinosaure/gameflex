+#ifdef __aarch64__
+// The kernel appends an ESR record to the signal frame of a data abort (asm/sigcontext.h:
+// esr_context, ESR_MAGIC) and keeps its WnR bit for userspace: whether the native access
+// was a write. Data aborts are exception classes 0x24 (lower EL) and 0x25 (same EL).
+static int arm64_fault_esr(ucontext_t* uc, uint64_t* esr_out)
+{
+    typedef struct { uint32_t magic; uint32_t size; } aarch64_ctx_t;
+    const uint8_t* cursor = (const uint8_t*)uc->uc_mcontext.__reserved;
+    const uint8_t* end = cursor + sizeof(uc->uc_mcontext.__reserved);
+    while(cursor + sizeof(aarch64_ctx_t) + sizeof(uint64_t) <= end) {
+        const aarch64_ctx_t* head = (const aarch64_ctx_t*)cursor;
+        if(!head->magic || head->size < sizeof(aarch64_ctx_t))
+            return 0;
+        if(head->magic == 0x45535201) {   // ESR_MAGIC
+            *esr_out = *(const uint64_t*)(cursor + sizeof(aarch64_ctx_t));
+            return 1;
+        }
+        cursor += head->size;
+    }
+    return 0;
+}
+
+static int arm64_fault_is_write(ucontext_t* uc)
+{
+    uint64_t esr = 0;
+    if(!arm64_fault_esr(uc, &esr))
+        return 0;
+    uint32_t ec = (uint32_t)(esr >> 26) & 0x3f;
+    return (ec == 0x24 || ec == 0x25) && ((esr >> 6) & 1);
+}
+#endif
