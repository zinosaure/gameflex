     int Locks = unlockMutex();
@@ -511,8 +543,34 @@ int my_sigactionhandler_oldcode_64(x64emu_t* emu, int32_t sig, int simple, sigin
         } else {
             sigcontext->uc_mcontext.gregs[X64_TRAPNO] = 14;
             sigcontext->uc_mcontext.gregs[X64_ERR] = 4|((sysmapped && !(real_prot&PROT_READ))?0:1);
-            if(write_opcode(sigcontext->uc_mcontext.gregs[X64_RIP], (uintptr_t)pc, (R_CS==0x23)))
+            int opcode_write = write_opcode(sigcontext->uc_mcontext.gregs[X64_RIP], (uintptr_t)pc, (R_CS==0x23));
+            if(opcode_write)
+                sigcontext->uc_mcontext.gregs[X64_ERR] |= 2;
+#ifdef __aarch64__
+            // The native access says it, whatever x86 opcode led to it: write_opcode decodes
+            // only some stores, and one it does not know (a VEX store, a string op, a wrapped
+            // native memcpy...) was reported as a read. Emulators that track guest memory by
