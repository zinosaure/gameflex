+                if(!opcode_write && reported < 5) {
+                    ++reported;
+                    printf_log(LOG_INFO, "Write fault at %p (x86 rip %p): opcode not decoded as a write, ESR says write\n", info->si_addr, (void*)sigcontext->uc_mcontext.gregs[X64_RIP]);
+                }
                 sigcontext->uc_mcontext.gregs[X64_ERR] |= 2;
+            }
+#endif
         }
         if(info->si_code == SEGV_ACCERR && old_code)
             *old_code = -1;
