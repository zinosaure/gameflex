+                    ++forwarded;
+                    uint64_t esr = 0;
+                    int has_esr = ucntx ? arm64_fault_esr((ucontext_t*)ucntx, &esr) : 0;
+                    printf_log(LOG_INFO, "SIGSEGV to x86 handler #%d: addr=%p rip=%p code=%d prot=0x%x opcode_write=%d native_ctx=%d esr=%s0x%llx\n", forwarded, info->si_addr, (void*)sigcontext->uc_mcontext.gregs[X64_RIP], info->si_code, prot, opcode_write, ucntx?1:0, has_esr?"":"(none) ", (unsigned long long)esr);
+                }
+            }
+            if(ucntx && arm64_fault_is_write((ucontext_t*)ucntx)) {
