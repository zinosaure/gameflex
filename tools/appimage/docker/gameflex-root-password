#!/bin/sh
# Un nouveau mot de passe pour root, montré une fois — « Réinitialiser le mot de passe root » de la console du PC, que
# seule la machine elle-même peut demander. Depuis l'hôte :
#   docker exec gameflex gameflex-root-password
set -eu
curl -fsS -X POST "http://127.0.0.1:${GAMEFLEX_CONSOLE_PORT:-10199}/api/v1/desktop/root-password" \
    | sed -n 's/.*"password" *: *"\([^"]*\)".*/root : \1\n/p'
