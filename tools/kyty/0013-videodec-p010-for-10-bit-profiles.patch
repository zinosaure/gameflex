+bool HighBitDepthProfile(uint32_t codec_type, uint32_t profile) {
+	return (codec_type == CODEC_TYPE_VP9 && profile >= 2u) ||
+	       (codec_type == CODEC_TYPE_HEVC && profile == 2u);
+}
