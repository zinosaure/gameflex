From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Senaxx <michelbeld@gmail.com>
Date: Mon, 16 Nov 2026 21:33:58 +0100
Subject: [PATCH] audio: decode Opus mapping family 1 with up to 8 channels in
 element order

(cherry picked from commit 0db0e022c102496597369aef8a604f35220f03b6)
---
 src/libs/ajm/opus_decoder.h | 39 +++++++++++++++-------
 tests/AjmResampleTests.cpp  | 64 +++++++++++++++++++++++++++++++++++--
 2 files changed, 89 insertions(+), 14 deletions(-)

diff --git a/src/libs/ajm/opus_decoder.h b/src/libs/ajm/opus_decoder.h
index bee26b86..a305e7fc 100644
--- a/src/libs/ajm/opus_decoder.h
+++ b/src/libs/ajm/opus_decoder.h
@@ -21,6 +21,19 @@ struct AjmSidebandDecOpusCodecInfo {
 static_assert(sizeof(AjmDecOpusInitializeParameters) == 12);
 static_assert(sizeof(AjmSidebandDecOpusCodecInfo) == 4);
 
+// Stream count, coupled stream count and channel mapping in output order (OpusHead bytes 19 on)
+// for mapping family 1 with 1-8 channels.
+inline constexpr uint8_t AJM_OPUS_SURROUND_LAYOUTS[8][10] {
+    {1, 0, 0},
+    {1, 1, 0, 1},
+    {2, 1, 0, 2, 1},
+    {2, 2, 0, 1, 2, 3},
+    {3, 2, 0, 4, 1, 2, 3},
+    {4, 2, 0, 4, 1, 2, 3, 5},
+    {4, 3, 0, 4, 1, 2, 3, 5, 6},
+    {5, 3, 0, 6, 1, 2, 3, 4, 5, 7},
+};
+
 class AjmOpusDecoder final: public AjmDecoder {
 public:
 	AjmOpusDecoder(uint32_t max_channels, AjmSampleEncoding encoding)
@@ -37,8 +50,9 @@ public:
 			return result;
 		}
 		const auto& params = *static_cast<const AjmDecOpusInitializeParameters*>(parameters);
-		// Families 0 and 1 code 1-2 channels identically; 255 codes each channel independently.
-		if (params.channel_num == 0 || params.channel_num > 2 || params.sample_rate != 48000 ||
+		const uint32_t channels_max = params.mapping_family == 1 ? 8 : 2;
+		if (params.channel_num == 0 || params.channel_num > channels_max ||
+		    params.sample_rate != 48000 ||
 		    (params.mapping_family > 1 && params.mapping_family != 255)) {
 			result.result = AJM_RESULT_INVALID_PARAMETER | AJM_RESULT_FATAL;
 			return result;
@@ -55,8 +69,8 @@ public:
 			m_context->sample_rate = static_cast<int>(params.sample_rate);
 
 			bool ready = true;
-			if (params.mapping_family == 255) {
-				ready = SetIndependentStreams(m_context, params.channel_num);
+			if (params.mapping_family != 0) {
+				ready = SetStreams(m_context, params.channel_num, params.mapping_family == 1);
 			}
 			if (ready) {
 				ready = avcodec_open2(m_context, codec, nullptr) >= 0;
@@ -190,22 +204,21 @@ public:
 	}
 
 private:
-	// One uncoupled mono stream per channel, in channel order. Marked family 1, the OpusHead block
-	// decodes 1-2 channels as 255 would but orders them for sample conversion.
-	static bool SetIndependentStreams(AVCodecContext* context, uint32_t channels) {
+	// Family 1 streams follow the surround layout; family 255 codes one uncoupled mono stream per
+	// channel. Marking the head family 255 keeps the decoded channels in output order.
+	static bool SetStreams(AVCodecContext* context, uint32_t channels, bool surround) {
 		const auto size = 21 + channels;
 		auto*      head = static_cast<uint8_t*>(av_mallocz(size + AV_INPUT_BUFFER_PADDING_SIZE));
 		if (head == nullptr) {
 			return false;
 		}
+		const uint8_t independent[] {static_cast<uint8_t>(channels), 0, 0, 1};
 		std::memcpy(head, "OpusHead", 8);
 		head[8]  = 1;
 		head[9]  = static_cast<uint8_t>(channels);
-		head[18] = 1;
-		head[19] = static_cast<uint8_t>(channels);
-		for (uint32_t channel = 0; channel < channels; channel++) {
-			head[21 + channel] = static_cast<uint8_t>(channel);
-		}
+		head[18] = 255;
+		std::memcpy(head + 19, surround ? AJM_OPUS_SURROUND_LAYOUTS[channels - 1] : independent,
+		            2 + channels);
 		context->extradata      = head;
 		context->extradata_size = static_cast<int>(size);
 		return true;
@@ -233,6 +246,8 @@ private:
 			result->internal_result = 0x1043;
 			return nullptr;
 		}
+		// A family 255 head leaves the layout unspecified, which sample conversion rejects.
+		av_channel_layout_default(&frame->ch_layout, frame->ch_layout.nb_channels);
 		AVFrame* converted = AjmConvertFfmpegFrame(frame, m_sample_encoding, result);
 		av_frame_free(&frame);
 		return converted;
diff --git a/tests/AjmResampleTests.cpp b/tests/AjmResampleTests.cpp
index 77911ed1..9bebedad 100644
--- a/tests/AjmResampleTests.cpp
+++ b/tests/AjmResampleTests.cpp
@@ -32,8 +32,8 @@ struct Fixture {
 	AjmBatchInfo              batch {};
 
 	explicit Fixture(uint32_t channels = 1, AjmSampleEncoding encoding = AjmSampleEncoding::S16,
-	                 uint64_t flags = 0x1000)
-	    : channels(channels) {
+	                 uint64_t flags = 0x1000, uint32_t mapping_family = 0)
+	    : channels(channels), mapping_family(mapping_family) {
 		Check(AjmInstanceCreate(1, 24, flags | channels | (uint64_t(encoding) << 7), &instance) ==
 		          OK,
 		      "create Opus instance");
@@ -374,6 +374,63 @@ void MappingFamilies() {
 
 	f.mapping_family = 2;
 	f.Initialize(AJM_RESULT_INVALID_PARAMETER | AJM_RESULT_FATAL);
+	f.channels       = 3;
+	f.mapping_family = 0;
+	f.Initialize(AJM_RESULT_INVALID_PARAMETER | AJM_RESULT_FATAL);
+	f.channels       = 9;
+	f.mapping_family = 1;
+	f.Initialize(AJM_RESULT_INVALID_PARAMETER | AJM_RESULT_FATAL);
+	f.channels = 6;
+	f.Initialize(AJM_RESULT_TOO_MANY_CHANNELS | AJM_RESULT_FATAL);
+}
+
+// Family 1 surround streams decode in element order: each output channel matches the reference
+// decoder's channel with the same index.
+void SurroundFamily(uint32_t channels) {
+	int           error = 0, streams = 0, coupled = 0;
+	unsigned char mapping[8];
+	auto*         encoder =
+	    opus_multistream_surround_encoder_create(48000, static_cast<int>(channels), 1, &streams,
+		                                         &coupled, mapping, OPUS_APPLICATION_AUDIO, &error);
+	Check(encoder != nullptr && error == OPUS_OK, "create surround test encoder");
+	auto* reference = opus_multistream_decoder_create(48000, static_cast<int>(channels), streams,
+	                                                  coupled, mapping, &error);
+	Check(reference != nullptr && error == OPUS_OK, "create surround reference decoder");
+	Fixture              f(channels, AjmSampleEncoding::S16, 0, 1);
+	std::vector<int16_t> pcm(960 * channels), expected(960 * channels), actual(960 * channels);
+	std::vector<double>  distance(channels * channels);
+	std::vector<uint8_t> packet(4096);
+	for (int p = 0; p < 4; ++p) {
+		for (size_t i = 0; i < pcm.size(); ++i) {
+			const auto c = i % channels;
+			pcm[i] = static_cast<int16_t>((4000 + 1000 * c) *
+			                              std::sin((i / channels + p * 960) * (0.03 + 0.017 * c)));
+		}
+		const int size = opus_multistream_encode(encoder, pcm.data(), 960, packet.data() + 2, 4094);
+		Check(size > 0, "encode surround test packet");
+		packet[0] = static_cast<uint8_t>(size);
+		packet[1] = static_cast<uint8_t>(size >> 8);
+		Check(opus_multistream_decode(reference, packet.data() + 2, size, expected.data(), 960,
+		                              0) == 960,
+		      "reference surround decode");
+		const auto decoded = f.Decode(packet.data(), size + 2, actual.data(), actual.size() * 2);
+		Check(decoded.stream.size_consumed == size + 2 &&
+		          decoded.stream.size_produced == static_cast<int>(actual.size() * 2),
+		      "family 1 decodes the whole surround packet");
+		for (size_t i = 0; i < actual.size(); ++i) {
+			for (uint32_t r = 0; r < channels; ++r) {
+				distance[(i % channels) * channels + r] +=
+				    std::abs(actual[i] - expected[i - i % channels + r]);
+			}
+		}
+	}
+	opus_multistream_encoder_destroy(encoder);
+	opus_multistream_decoder_destroy(reference);
+	for (uint32_t c = 0; c < channels; ++c) {
+		const auto* row = distance.data() + c * channels;
+		Check(std::min_element(row, row + channels) - row == c,
+		      "family 1 keeps each channel in element order");
+	}
 }
 
 void Mp3ParseFrame() {
@@ -414,6 +471,9 @@ int main(int argc, char** argv) {
 	FormatChangeRequiresReset();
 	EndPersistsUntilReset(packet);
 	MappingFamilies();
+	for (uint32_t channels = 3; channels <= 8; ++channels) {
+		SurroundFamily(channels);
+	}
 	if (argc >= 2) {
 		std::ifstream        file(argv[1], std::ios::binary);
 		std::vector<uint8_t> real_packet((std::istreambuf_iterator<char>(file)), {});
