From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Senaxx <michelbeld@gmail.com>
Date: Thu, 5 Nov 2026 09:48:04 +0100
Subject: [PATCH] kernel: let fsync succeed on directories, devices and
 read-only descriptors

(cherry picked from commit 5ff1085f29350aade353be3be6e8a6733b17e42b)
---
 src/kernel/fileSystem.cpp       | 7 ++++++-
 tests/KernelFileSystemTests.cpp | 7 +++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/src/kernel/fileSystem.cpp b/src/kernel/fileSystem.cpp
index 90fc901f..8e734b2f 100644
--- a/src/kernel/fileSystem.cpp
+++ b/src/kernel/fileSystem.cpp
@@ -1597,8 +1597,13 @@ int KYTY_SYSV_ABI KernelFsync(int d) {
 		return KERNEL_ERROR_EBADF;
 	}
 
+	// Directories, devices and read-only descriptors have no written data to flush
+	if (!file->writable || file->special != SpecialFile::None) {
+		return OK;
+	}
+
 	Common::LockGuard lock(file->mutex);
-	if (file->f.IsInvalid() || !file->f.Flush()) {
+	if (!file->f.Flush()) {
 		return KERNEL_ERROR_EIO;
 	}
 
diff --git a/tests/KernelFileSystemTests.cpp b/tests/KernelFileSystemTests.cpp
index 1b7fbb17..2f2fec78 100644
--- a/tests/KernelFileSystemTests.cpp
+++ b/tests/KernelFileSystemTests.cpp
@@ -731,6 +731,13 @@ void TestFsync() {
   Check(FileSystem::KernelClose(fd) == OK && fsync(fd) == -1 &&
             *Libs::Posix::GetErrorAddr() == Libs::Posix::POSIX_EBADF,
         "closed fsync descriptor reports POSIX EBADF");
+
+  for (const auto& [path, flags] : {std::pair {"/savedata0", 0x00020000}, std::pair {Path, 0},
+                                    std::pair {"/dev/urandom", 0x2}}) {
+    const int descriptor = FileSystem::KernelOpen(path, flags, 0);
+    Check(descriptor >= 3 && fsync(descriptor) == OK && FileSystem::KernelClose(descriptor) == OK,
+          "fsync succeeds on a directory, a read-only file and a writable device");
+  }
 }
 
 void TestSaveTruncate() {
