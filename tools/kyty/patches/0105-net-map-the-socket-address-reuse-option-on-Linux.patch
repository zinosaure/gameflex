From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nmzik <Nmzik@mail.ru>
Date: Sat, 7 Nov 2026 11:32:22 +0100
Subject: [PATCH] net: map the socket address-reuse option on Linux

(cherry picked from commit 4a034fe5fa899330e7632c9a5211e28d0c0b2d18)
---
 src/libs/network.cpp       |  1 +
 tests/NetResolverTests.cpp | 13 +++++++++++++
 2 files changed, 14 insertions(+)

diff --git a/src/libs/network.cpp b/src/libs/network.cpp
index 6b44ea42..29e12445 100644
--- a/src/libs/network.cpp
+++ b/src/libs/network.cpp
@@ -1095,6 +1095,7 @@ static int ConvertSocketOptionLevel(int level) {
 static int ConvertSocketOptionName(int level, int option) {
 	if (level == 0xffff) {
 		switch (option) {
+			case 0x0004: return SO_REUSEADDR;
 			case 0x0020: return SO_BROADCAST;
 			case 0x1001: return SO_SNDBUF;
 			case 0x1002: return SO_RCVBUF;
diff --git a/tests/NetResolverTests.cpp b/tests/NetResolverTests.cpp
index 96fa969a..988c5333 100644
--- a/tests/NetResolverTests.cpp
+++ b/tests/NetResolverTests.cpp
@@ -92,6 +92,19 @@ TEST_F(NetResolverTest, NtoaStoresFirstAddress) {
   EXPECT_EQ(addr, 0x0100007fu);
 }
 
+TEST_F(NetResolverTest, SocketReuseAddressOption) {
+  const int s = Network::Net::Socket(2, 1, 6);
+  ASSERT_GE(s, 0);
+  const int enable = 1;
+  EXPECT_EQ(Network::Net::Setsockopt(s, 0xffff, 0x4, &enable, sizeof(enable)),
+            0);
+  int value = 0;
+  uint32_t length = sizeof(value);
+  EXPECT_EQ(Network::Net::Getsockopt(s, 0xffff, 0x4, &value, &length), 0);
+  EXPECT_NE(value, 0);
+  EXPECT_EQ(Network::Net::SocketClose(s), 0);
+}
+
 } // namespace
 
 int main(int argc, char **argv) {
