From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: superkeka <55901716+superkeka@users.noreply.github.com>
Date: Thu, 5 Nov 2026 15:27:58 +0100
Subject: [PATCH] kernel: a semaphore signal wakes only the waiters it hands
 counts to

(cherry picked from commit a0268f1de49079700dfbbbbd014822e65faeebc5)
---
 src/kernel/semaphore.cpp | 31 +++++++++++--------------------
 1 file changed, 11 insertions(+), 20 deletions(-)

diff --git a/src/kernel/semaphore.cpp b/src/kernel/semaphore.cpp
index 54d6fa62..ddac51c1 100644
--- a/src/kernel/semaphore.cpp
+++ b/src/kernel/semaphore.cpp
@@ -50,12 +50,14 @@ public:
 private:
 	enum class Status { Set, Deleted };
 
+	// Each waiter sleeps on its own condition variable, so a signal wakes only the waiters it
+	// gives counts to.
 	struct WaitingThread {
-		int    id         = 0;
-		int    priority   = 700;
-		int    need_count = 0;
-		Result result     = Result::TimedOut;
-		bool   ready      = false;
+		int             priority   = 700;
+		int             need_count = 0;
+		Result          result     = Result::TimedOut;
+		bool            ready      = false;
+		Common::CondVar cond_var;
 	};
 
 	void AddWaiter(WaitingThread* waiter);
@@ -63,7 +65,6 @@ private:
 	void WakeWaiters();
 
 	Common::Mutex               m_mutex;
-	Common::CondVar             m_cond_var;
 	std::string                 m_name;
 	Status                      m_status = Status::Set;
 	std::vector<WaitingThread*> m_waiting_threads;
@@ -88,11 +89,10 @@ KernelSemaPrivate::~KernelSemaPrivate() {
 		if (!waiter->ready) {
 			waiter->result = Result::Deleted;
 			waiter->ready  = true;
+			waiter->cond_var.Signal();
 		}
 	}
 
-	m_cond_var.SignalAll();
-
 	while (!m_waiting_threads.empty()) {
 		m_mutex.Unlock();
 		Common::Thread::SleepMicro(10);
@@ -123,11 +123,10 @@ KernelSemaPrivate::Result KernelSemaPrivate::Cancel(int set_count, int* num_wait
 		if (!waiter->ready) {
 			waiter->result = Result::Canceled;
 			waiter->ready  = true;
+			waiter->cond_var.Signal();
 		}
 	}
 
-	m_cond_var.SignalAll();
-
 	return Result::Ok;
 }
 
@@ -146,8 +145,6 @@ KernelSemaPrivate::Result KernelSemaPrivate::Signal(int signal_count) {
 
 	WakeWaiters();
 
-	m_cond_var.SignalAll();
-
 	return Result::Ok;
 }
 
@@ -177,6 +174,7 @@ void KernelSemaPrivate::WakeWaiters() {
 			m_count -= waiter->need_count;
 			waiter->result = Result::Ok;
 			waiter->ready  = true;
+			waiter->cond_var.Signal();
 		}
 	}
 }
@@ -214,10 +212,7 @@ KernelSemaPrivate::Result KernelSemaPrivate::Wait(int need_count, uint32_t* ptr_
 	uint32_t      elapsed = 0;
 	Common::Timer t;
 
-	int id = Common::Thread::GetThreadIdUnique();
-
 	WaitingThread waiter {};
-	waiter.id         = id;
 	waiter.priority   = (m_fifo_order ? 0 : Libs::LibKernel::PthreadGetCurrentPriorityForKernel());
 	waiter.need_count = need_count;
 	AddWaiter(&waiter);
@@ -229,11 +224,7 @@ KernelSemaPrivate::Result KernelSemaPrivate::Wait(int need_count, uint32_t* ptr_
 			return Result::TimedOut;
 		}
 
-		if (infinitely) {
-			m_cond_var.WaitFor(&m_mutex, SIGNAL_APC_POLL_MICROS);
-		} else {
-			m_cond_var.WaitFor(&m_mutex, micros - elapsed);
-		}
+		waiter.cond_var.WaitFor(&m_mutex, infinitely ? SIGNAL_APC_POLL_MICROS : micros - elapsed);
 
 		m_mutex.Unlock();
 		LibKernel::KernelDispatchPendingSignalForCurrentThread();
