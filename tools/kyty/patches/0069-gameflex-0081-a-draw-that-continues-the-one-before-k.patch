@@ -231,6 +231,7 @@ void TextureCache::RegisterImage(ImageId id) {
 }
 
 void TextureCache::TouchGenerations(uint64_t address, uint64_t size) noexcept {
+	m_epoch++;
 	const uint64_t last = (address + size - 1) >> GenerationBlockBits;
 	for (uint64_t block = address >> GenerationBlockBits; block <= last; block++) {
 		m_block_generations[block & (GenerationBlocks - 1u)]++;
diff --git a/src/graphics/host_gpu/renderer/cache/textureCache.h b/src/graphics/host_gpu/renderer/cache/textureCache.h
index 6e96189f..5ac8f1be 100644
--- a/src/graphics/host_gpu/renderer/cache/textureCache.h
+++ b/src/graphics/host_gpu/renderer/cache/textureCache.h
@@ -57,6 +57,8 @@ public:
 	// Grows whenever an image over a block of that memory is registered or freed: what FindImage returns for a
 	// description over it may change then, not before. A sum over 1 MiB blocks (hashed): equal sums, no change.
 	[[nodiscard]] uint64_t      RegionGeneration(uint64_t address, uint64_t size) const noexcept;
+	// Advances whenever an image is registered or unregistered anywhere (replacements and expansions included).
+	[[nodiscard]] uint64_t      Epoch() const noexcept { return m_epoch; }
 	// Whether a texture binding found before can still take this image as it is: registered, not handed to a
 	// depth image, not replaced or expanded since (FindTexture's conditions).
 	[[nodiscard]] bool          BindingUsable(ImageId id);
@@ -182,6 +184,7 @@ private:
 	std::vector<uint32_t>                             m_block_generations =
 	    std::vector<uint32_t>(GenerationBlocks);
 	void                                              TouchGenerations(uint64_t address, uint64_t size) noexcept;
+	uint64_t                                          m_epoch = 0;
 	Common::LeastRecentlyUsedCache<ImageId, uint64_t> m_lru_cache;
 	std::unordered_set<ImageId>                       m_download_images;
 	std::map<uint64_t, MetaDataInfo>                  m_surface_metas;
diff --git a/src/graphics/host_gpu/renderer/colorRenderTarget.cpp b/src/graphics/host_gpu/renderer/colorRenderTarget.cpp
index 40400622..49bec789 100644
--- a/src/graphics/host_gpu/renderer/colorRenderTarget.cpp
+++ b/src/graphics/host_gpu/renderer/colorRenderTarget.cpp
@@ -70,6 +70,17 @@ void RenderExecutor::ResolveRenderColorTarget(CommandBuffer& buffer, RenderColor
 
 		return;
 	}
+	auto&      texture_cache = m_context.GetTextureCache();
+	auto&      buffer_cache  = m_context.GetBufferCache();
+	auto&      continued     = m_continued_targets[rt_slot];
+	const auto tick          = m_context.GetCommandScheduler().CurrentTick();
+	if (continued.valid && continued.tick == tick && continued.breaks == m_chain_breaks &&
+	    continued.textures == texture_cache.Epoch() && continued.transfers == buffer_cache.Transfers() &&
+	    continued.mask == mask && continued.exact_format == exact_format && continued.registers == rt) {
+		r = continued.info;
+		BindRenderTarget(r.image_id);
+		return;
+	}
 	const auto samples = render_sample_count(rt.attrib.num_fragments);
 	// TODO(PPSA24156): Replace this 2x MSAA approximation with proper 4-coverage/2-fragment EQAA.
 	const bool approximate_eqaa = rt.attrib.num_samples == 2 && rt.attrib.num_fragments == 1;
@@ -265,12 +276,20 @@ void RenderExecutor::ResolveRenderColorTarget(CommandBuffer& buffer, RenderColor
 	desc.view_info.base_layer  = view.base_layer;
 	desc.view_info.layer_count = view.layer_count;
 	desc.view_info.usage       = vk::ImageUsageFlagBits::eColorAttachment;
-	auto& texture_cache        = m_context.GetTextureCache();
 	r.guest_mip_level          = mip;
 	r.guest_array_layer        = view.base_layer;
 	r.image_id                 = texture_cache.FindImage(r.desc, exact_format);
 	r.export_mapping           = target_format.export_mapping;
 	BindRenderTarget(r.image_id);
+	continued = {rt,
+	             mask,
+	             exact_format,
+	             true,
+	             m_context.GetCommandScheduler().CurrentTick(),
+	             texture_cache.Epoch(),
+	             buffer_cache.Transfers(),
+	             m_chain_breaks,
+	             r};
 }
 
