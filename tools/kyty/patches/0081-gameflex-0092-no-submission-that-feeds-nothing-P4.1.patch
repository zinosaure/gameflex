 	auto matches = [&cfg, index](const auto& r) { return r.cfg == &cfg && r.index == index; };
 	return std::any_of(m_requests.begin(), m_requests.end(), matches) ||
@@ -1598,18 +1600,12 @@ void VideoOutDriver::WaitForSubmitSlot(int handle) {
