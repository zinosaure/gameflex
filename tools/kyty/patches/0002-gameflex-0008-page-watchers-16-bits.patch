From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Gino D." <25200363+zinosaure@users.noreply.github.com>
Date: Sun, 8 Nov 2026 21:49:25 +0000
Subject: [PATCH] gameflex 0008: page watchers 16 bits
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Détail : tools/kyty/README.md du dépôt GameFlex, entrée 0008.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/graphics/host_gpu/pageManager.cpp | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/src/graphics/host_gpu/pageManager.cpp b/src/graphics/host_gpu/pageManager.cpp
index bde427d0..a9b6f386 100644
--- a/src/graphics/host_gpu/pageManager.cpp
+++ b/src/graphics/host_gpu/pageManager.cpp
@@ -77,9 +77,11 @@ void ValidateRange(uint64_t vaddr, uint64_t size) {
 } // namespace
 
 struct PageManager::Impl {
+	// Sixteen bits per page: a page full of small GPU buffers (Final Fantasy VII Rebirth, past its
+	// main menu) gathers more than the 127 write watchers that seven bits could count.
 	struct PageState {
-		uint8_t write_watchers  : 7 = 0;
-		uint8_t access_watchers : 1 = 0;
+		uint16_t write_watchers  : 15 = 0;
+		uint16_t access_watchers : 1 = 0;
 
 		[[nodiscard]] Common::VirtualMemory::Mode Perms() const noexcept {
 			if (access_watchers != 0) {
@@ -110,7 +112,7 @@ struct PageManager::Impl {
 				}
 			} else {
 				if constexpr (delta == 1) {
-					if (write_watchers == 0x7f) {
+					if (write_watchers == 0x7fff) {
 						Fatal("write-watcher overflow at 0x%016" PRIx64, address);
 					}
 					return ++write_watchers;
@@ -125,7 +127,7 @@ struct PageManager::Impl {
 			}
 		}
 	};
-	static_assert(sizeof(PageState) == 1);
+	static_assert(sizeof(PageState) == 2);
 
 	struct Region {
 		std::atomic_flag                    lock = ATOMIC_FLAG_INIT;
