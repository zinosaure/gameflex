 	void V_MAD_U64_U32(const Decoder::Instruction& inst);
 	void V_SAD_U32(const Decoder::Instruction& inst);
+	void V_MSAD_U8(const Decoder::Instruction& inst);
 	void S_BITSET_B32(const Decoder::Instruction& inst, bool set);
 	void S_BITSET_B64(const Decoder::Instruction& inst, bool set);
 	void V_BCNT_U32_B32(const Decoder::Instruction& inst);
diff --git a/src/graphics/shader/recompiler/frontend/translate/Vector.cpp b/src/graphics/shader/recompiler/frontend/translate/Vector.cpp
index 59719320..22c96c94 100644
--- a/src/graphics/shader/recompiler/frontend/translate/Vector.cpp
+++ b/src/graphics/shader/recompiler/frontend/translate/Vector.cpp
@@ -594,6 +594,7 @@ void Translator::EmitVector(const Decoder::Instruction& inst) {
 		case O::V_MUL_HI_U32_U24: return Integer24(inst, false, false, true);
 		case O::V_MAD_U64_U32: return V_MAD_U64_U32(inst);
 		case O::V_SAD_U32: return V_SAD_U32(inst);
+		case O::V_MSAD_U8: return V_MSAD_U8(inst);
