Subject: [PATCH] shader: translate V_MSAD_U8

(cherry picked from commit 174ec91265d58bdb8d86ef2f47a439c38e1f2e9b)
---
 .../frontend/decode/ShaderDecoder.h           |  1 +
 .../frontend/decode/VectorAluOps.cpp          |  1 +
 .../recompiler/frontend/translate/Integer.cpp | 20 ++++++++++++++
 .../frontend/translate/Translator.h           |  1 +
 .../recompiler/frontend/translate/Vector.cpp  |  1 +
 tests/ShaderRecompilerComputeTests.cpp        | 26 +++++++++++++++++++
 6 files changed, 50 insertions(+)

diff --git a/src/graphics/shader/recompiler/frontend/decode/ShaderDecoder.h b/src/graphics/shader/recompiler/frontend/decode/ShaderDecoder.h
index 14bd631b..2efacd34 100644
--- a/src/graphics/shader/recompiler/frontend/decode/ShaderDecoder.h
+++ b/src/graphics/shader/recompiler/frontend/decode/ShaderDecoder.h
@@ -297,6 +297,7 @@ enum class Opcode {
 	V_MED3_I16,
 	V_MED3_U16,
 	V_SAD_U32,
+	V_MSAD_U8,
 	V_ADD3_U32,
 	V_LSHL_ADD_U32,
 	V_ADD_LSHL_U32,
diff --git a/src/graphics/shader/recompiler/frontend/decode/VectorAluOps.cpp b/src/graphics/shader/recompiler/frontend/decode/VectorAluOps.cpp
index 6e6cf047..2fec35e0 100644
