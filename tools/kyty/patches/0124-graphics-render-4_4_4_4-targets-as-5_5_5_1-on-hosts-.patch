From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nmzik <Nmzik@mail.ru>
Date: Sun, 15 Nov 2026 21:45:50 +0100
Subject: [PATCH] graphics: render 4_4_4_4 targets as 5_5_5_1 on hosts that
 cannot render them

(cherry picked from commit 41e2147c07bcc6d2206cb2b84e4646497896a18e)
---
 src/graphics/host_gpu/graphicContext.h             |  1 +
 .../host_gpu/renderer/colorRenderTarget.cpp        |  3 ++-
 .../host_gpu/renderer/image/textureCommon.cpp      | 14 +++++++++++++-
 .../host_gpu/renderer/image/textureCommon.h        |  5 ++++-
 .../host_gpu/renderer/pipeline/pipelineCache.cpp   |  2 +-
 src/graphics/presentation/window/vulkanWindow.cpp  |  5 +++++
 6 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/src/graphics/host_gpu/graphicContext.h b/src/graphics/host_gpu/graphicContext.h
index b21af569..d04d1e9c 100644
--- a/src/graphics/host_gpu/graphicContext.h
+++ b/src/graphics/host_gpu/graphicContext.h
@@ -43,6 +43,7 @@ struct GraphicContext {
 	bool                               robust_buffer_access_enabled          = false;
 	bool                               r8_srgb_views                         = false;
 	bool                               r8g8_srgb_views                       = false;
+	bool                               r4g4b4a4_render_targets               = false;
 	bool                               conditional_rendering_enabled         = false;
 	// End-of-pipe writes that do not stall the command processor (the labels of RELEASE_MEM).
 	bool                               buffer_marker_enabled                 = false;
diff --git a/src/graphics/host_gpu/renderer/colorRenderTarget.cpp b/src/graphics/host_gpu/renderer/colorRenderTarget.cpp
index 8c4eca11..7ae35217 100644
--- a/src/graphics/host_gpu/renderer/colorRenderTarget.cpp
+++ b/src/graphics/host_gpu/renderer/colorRenderTarget.cpp
@@ -165,7 +165,8 @@ void RenderExecutor::ResolveRenderColorTarget(CommandBuffer& buffer, RenderColor
 	const uint32_t width  = rt.attrib2.width + 1;
 	const uint32_t height = rt.attrib2.height + 1;
 	const auto target_format =
-	    TextureGetRenderTargetFormat(rt.info.format, rt.info.channel_type, rt.info.channel_order);
+	    TextureGetRenderTargetFormat(m_context.GetGraphics(), rt.info.format, rt.info.channel_type,
+	                                 rt.info.channel_order);
 	// A surface with one stored level starts every MIP_LEVEL at the base address, so a level with
 	// mip 0's padded pitch aliases mip 0's top-left texels.
 	uint32_t mip = rt.view.current_mip_level;
diff --git a/src/graphics/host_gpu/renderer/image/textureCommon.cpp b/src/graphics/host_gpu/renderer/image/textureCommon.cpp
index cfcdb47f..215d6bc7 100644
--- a/src/graphics/host_gpu/renderer/image/textureCommon.cpp
+++ b/src/graphics/host_gpu/renderer/image/textureCommon.cpp
@@ -1,13 +1,16 @@
 #include "graphics/host_gpu/renderer/image/textureCommon.h"
 
 #include "common/assert.h"
+#include "common/logging/log.h"
 #include "graphics/guest_gpu/gpu_defs.h"
 #include "graphics/guest_gpu/gpu_format.h"
+#include "graphics/host_gpu/graphicContext.h"
 #include "graphics/host_gpu/vulkanCommon.h"
 #include "graphics/shader/shader.h"
 
 #include <algorithm>
 #include <array>
+#include <atomic>
 
 namespace Libs::Graphics {
 namespace {
@@ -63,9 +66,18 @@ HostFormatInfo ResolveHostFormat(Prospero::BufferFormat guest_format,
 
 } // namespace
 
-RenderTargetFormatInfo TextureGetRenderTargetFormat(Prospero::ChannelLayout layout,
+RenderTargetFormatInfo TextureGetRenderTargetFormat(const GraphicContext&   graphics,
+                                                    Prospero::ChannelLayout layout,
                                                     Prospero::ChannelType   type,
                                                     Prospero::ChannelOrder  order) {
+	// A host without 4_4_4_4 render targets gets 5_5_5_1: the same size, 1 bit for component 3.
+	if (layout == Prospero::ChannelLayout::k4_4_4_4 && !graphics.r4g4b4a4_render_targets) {
+		static std::atomic_bool warned = false;
+		if (!warned.exchange(true, std::memory_order_relaxed)) {
+			Log::WriteToConsoleAndLog("Warning: rendering 4_4_4_4 targets as 5_5_5_1.\n");
+		}
+		layout = Prospero::ChannelLayout::k5_5_5_1;
+	}
 	const auto encoding = Prospero::ResolveRenderTargetFormat(layout, type);
 	if (encoding.SupportsOrder(order)) {
 		const auto backing_format = encoding.buffer_format == Prospero::BufferFormat::k11_11_10UNorm
diff --git a/src/graphics/host_gpu/renderer/image/textureCommon.h b/src/graphics/host_gpu/renderer/image/textureCommon.h
index de85f542..65dbc411 100644
--- a/src/graphics/host_gpu/renderer/image/textureCommon.h
+++ b/src/graphics/host_gpu/renderer/image/textureCommon.h
@@ -6,6 +6,8 @@
 
 namespace Libs::Graphics {
 
+struct GraphicContext;
+
 struct RenderTargetFormatInfo {
 	vk::Format                      format            = vk::Format::eUndefined;
 	uint32_t                        bytes_per_element = 0;
@@ -22,7 +24,8 @@ struct SurfaceFormatInfo {
 vk::ComponentMapping   TextureGetComponentMapping(uint32_t                        swizzle,
                                                   Prospero::ColorComponentMapping host_to_storage);
 SurfaceFormatInfo      TextureGetSurfaceFormatInfo(Prospero::BufferFormat format);
-RenderTargetFormatInfo TextureGetRenderTargetFormat(Prospero::ChannelLayout layout,
+RenderTargetFormatInfo TextureGetRenderTargetFormat(const GraphicContext&   graphics,
+                                                    Prospero::ChannelLayout layout,
                                                     Prospero::ChannelType   type,
                                                     Prospero::ChannelOrder  order);
 
diff --git a/src/graphics/host_gpu/renderer/pipeline/pipelineCache.cpp b/src/graphics/host_gpu/renderer/pipeline/pipelineCache.cpp
index 48c62cb4..73c9295f 100644
--- a/src/graphics/host_gpu/renderer/pipeline/pipelineCache.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/pipelineCache.cpp
@@ -903,7 +903,7 @@ void PipelineCache::GetGraphicsPrograms(const CommandBuffer& command, DrawRender
 			const auto& rt = context.GetRenderTarget(slot);
 			if ((color_output_mask & (1u << slot)) != 0 && rt.base.addr != 0) {
 				target_export_mapping[slot] =
-				    TextureGetRenderTargetFormat(rt.info.format, rt.info.channel_type,
+				    TextureGetRenderTargetFormat(m_graphics, rt.info.format, rt.info.channel_type,
 				                                 rt.info.channel_order)
 				        .export_mapping;
 			}
diff --git a/src/graphics/presentation/window/vulkanWindow.cpp b/src/graphics/presentation/window/vulkanWindow.cpp
index afaa2811..859c1a0c 100644
--- a/src/graphics/presentation/window/vulkanWindow.cpp
+++ b/src/graphics/presentation/window/vulkanWindow.cpp
@@ -527,6 +527,11 @@ static vk::Device VulkanCreateDevice(GraphicContext&          graphics,
 	    robustness2_props.robustStorageBufferAccessSizeAlignment == 1u;
 	graphics.r8_srgb_views   = graphics.SamplesFiltered(vk::Format::eR8Srgb);
 	graphics.r8g8_srgb_views = graphics.SamplesFiltered(vk::Format::eR8G8Srgb);
+	constexpr auto blended_target = vk::FormatFeatureFlagBits::eColorAttachment |
+	                                vk::FormatFeatureFlagBits::eColorAttachmentBlend;
+	graphics.r4g4b4a4_render_targets =
+	    (graphics.GetFormatProperties(vk::Format::eR4G4B4A4UnormPack16).optimalTilingFeatures &
+	     blended_target) == blended_target;
 	// The device clock ticks at timestampPeriod nanoseconds.
 	if (shader_clock.shaderDeviceClock) {
 		graphics.device_clock_period_ps = static_cast<uint32_t>(
