From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Gino D." <25200363+zinosaure@users.noreply.github.com>
Date: Tue, 10 Nov 2026 05:11:58 +0000
Subject: [PATCH] gameflex 0091: the shader store survives builds that leave
 shaders and pipelines alone

0032 keyed the store by the sources its records depend on, but its header kept the Kyty revision as well
(added by 0016 for Box64, where the executable's date is Box64's): every build threw away the store of every
account, and every first session after a delivery compiled all its shaders again, drawing without the draws
that wait for them.

- The revision counts only when the sources are unknown, with the executable's date.
- The sources are the recompiler (shader/), the code that describes and creates pipelines
  (host_gpu/renderer/pipeline/) and the render target headers it includes; no longer the rest of the
  renderer (barriers, scheduler, draws).
- The remap of 0034's stamp goes: no store from before it can match the new set.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/generate_version.cmake                    | 20 +++++++++----------
 .../pipeline/pipelineSerialization.cpp        | 12 +++++------
 2 files changed, 15 insertions(+), 17 deletions(-)

diff --git a/src/generate_version.cmake b/src/generate_version.cmake
index 89c89339..c9ddfbdb 100644
--- a/src/generate_version.cmake
+++ b/src/generate_version.cmake
@@ -38,14 +38,17 @@ if(GIT_EXECUTABLE)
 		endif()
 	endif()
 endif()
-# GameFlex: what the shader store's records depend on - the recompiler, and the renderer that
-# describes and creates pipelines (not its memory caches). A build that leaves these sources alone
-# keeps the store, whatever else it changes.
+# GameFlex: what the shader store's records depend on - the recompiler, which builds the programs
+# and their keys, and the code that describes and creates pipelines, with the render target headers
+# it includes. A build that leaves these sources alone keeps the store, whatever else it changes:
+# barriers, the scheduler, the draws, the caches of memory (they used to count, with all of
+# host_gpu/renderer, and the Kyty revision on top: every build threw the accounts' stores away).
 set(KYTY_SHADER_STORE_STAMP "unknown")
 if(GRAPHICS_SOURCE_DIR)
 	file(GLOB_RECURSE store_sources LIST_DIRECTORIES false RELATIVE "${GRAPHICS_SOURCE_DIR}"
-		"${GRAPHICS_SOURCE_DIR}/shader/*" "${GRAPHICS_SOURCE_DIR}/host_gpu/renderer/*")
-	list(FILTER store_sources EXCLUDE REGEX "^host_gpu/renderer/cache/")
+		"${GRAPHICS_SOURCE_DIR}/shader/*" "${GRAPHICS_SOURCE_DIR}/host_gpu/renderer/pipeline/*")
+	list(APPEND store_sources "host_gpu/renderer/colorRenderTarget.h"
+		"host_gpu/renderer/depthRenderTarget.h" "host_gpu/renderer/renderTarget.h")
 	list(SORT store_sources)
 	set(store_digests "")
 	foreach(source IN LISTS store_sources)
@@ -56,10 +59,5 @@ if(GRAPHICS_SOURCE_DIR)
 		string(SHA256 KYTY_SHADER_STORE_STAMP "${store_digests}")
 	endif()
 endif()
-# GameFlex: 0034 only translates what used to stop Kyty, and 0038 only moves when the store is read,
-# so the records stored before them stay valid.
-# Any other change to these sources gives another stamp, and a new store.
-if(KYTY_SHADER_STORE_STAMP STREQUAL "58af55fba97c6709ae1c05a25943a503c1fe2bec899d2f11ba69c593a259f71c")
-	set(KYTY_SHADER_STORE_STAMP "1a2216d3d966cf7b1b6e8ec85cd3a0a1a0f2115d9453cbf36d9a6c909aa85b7d")
-endif()
+# Any change to these sources gives another stamp, and a new store.
 configure_file("${INPUT_FILE}" "${OUTPUT_FILE}")
diff --git a/src/graphics/host_gpu/renderer/pipeline/pipelineSerialization.cpp b/src/graphics/host_gpu/renderer/pipeline/pipelineSerialization.cpp
index f0e5cecd..a52df830 100644
--- a/src/graphics/host_gpu/renderer/pipeline/pipelineSerialization.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/pipelineSerialization.cpp
@@ -64,13 +64,16 @@ uint64_t BuildStamp() {
 }
 
 // GameFlex: the sources the records depend on (generate_version.cmake), so a build that changes
-// neither the recompiler nor the pipelines keeps the store. Without them, the executable's date.
+// neither the recompiler nor the pipelines keeps the store. Without them, the executable's date
+// and the Kyty revision: under Box64, /proc/self/exe is Box64 itself, whose date stays the same
+// when Kyty changes - a store written by another Kyty would pass for this one's.
 uint64_t StoreStamp() {
 	constexpr std::string_view sources = KYTY_SHADER_STORE_STAMP;
 	if (sources != "unknown") {
 		return XXH3_64bits(sources.data(), sources.size());
 	}
-	return BuildStamp();
+	const uint64_t date = BuildStamp();
+	return date == 0 ? 0 : date ^ XXH3_64bits(KYTY_GIT_REVISION, sizeof(KYTY_GIT_REVISION) - 1);
 }
 
 // What every record depends on besides its own fields; empty when the build is unknown.
@@ -79,11 +82,8 @@ std::vector<uint8_t> StoreHeader(const GraphicContext& graphics) {
 	if (stamp == 0) {
 		return {};
 	}
-	// The Kyty revision as well: under Box64, /proc/self/exe is Box64 itself, whose date stays the
-	// same when Kyty changes - a store written by another Kyty would pass for this one's.
-	const uint64_t revision = XXH3_64bits(KYTY_GIT_REVISION, sizeof(KYTY_GIT_REVISION) - 1);
 	Writer header;
-	IoAll(header, stamp, revision, SpirvProfile(graphics),
+	IoAll(header, stamp, SpirvProfile(graphics),
 	      graphics.GetPhysicalDeviceProperties().limits.maxComputeSharedMemorySize);
 	return std::move(header.bytes);
 }
