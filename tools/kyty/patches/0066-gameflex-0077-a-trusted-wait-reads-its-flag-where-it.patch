From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Gino D." <25200363+zinosaure@users.noreply.github.com>
Date: Mon, 9 Nov 2026 10:34:08 +0000
Subject: [PATCH] gameflex 0077: a trusted wait reads its flag where it is in
 the stream

0072 let a guest wait for a value a shader recorded before go on behind
a barrier, once four waits at that address ended with the value, and
checked each trusted wait by reading the flag in memory once the
writer's work was done. That can be long after the wait: the game
clears its flags once it saw them, and Astro Bot's three busiest
flags (graphics queue, 0x5..0fc60) were revoked while the level loaded,
each of their waits then a drain of everything queued, ~40 ms.

At each trusted wait the GPU now copies the flag, behind a barrier, to
a slot of a small readback buffer, at the wait's place in the stream:
the value the command processor would have seen. The check reads the
slot once that command buffer is done. Checks end in the order they
were recorded; with 1 024 slots, a wait that finds them all in use
suspends as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../host_gpu/renderer/cache/bufferCache.cpp   | 70 ++++++++++++-------
 .../host_gpu/renderer/cache/bufferCache.h     | 25 ++++---
 2 files changed, 62 insertions(+), 33 deletions(-)

diff --git a/src/graphics/host_gpu/renderer/cache/bufferCache.cpp b/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
index da931686..fed0d797 100644
--- a/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
+++ b/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
@@ -1171,38 +1171,35 @@ bool TestWaitRegMemValue(uint64_t value, uint64_t ref, uint64_t mask, uint32_t f
 // Astro Bot's graphics queue waits about nine times an image for a flag its compute work sets to 1, each time
 // submitting, then polling until the GPU wrote it: 35 ms an image, the GPU and the thread taking turns. The
 // compute work is recorded before, on the same Vulkan queue: the wait needs only a barrier, if the flag lands.
+// The check read the flag in memory once the writer's work was done, which may be long after: the game clears
+// its flags once it saw them, and Astro Bot's three busiest ones were revoked while the level loaded, each wait
+// then a 40 ms drain. The GPU copies the value where the wait is in the stream, which is what the wait saw.
 namespace {
 constexpr uint32_t kFlagConfirmations = 4;
+constexpr uint32_t kFlagCaptureSlots  = 1024; // trusted waits not checked yet, 8 bytes each
 } // namespace
 
 void BufferCache::VerifyFlagSpeculations() {
 	const auto done = m_scheduler.GetMasterSemaphore().KnownGpuTick();
-	std::erase_if(m_flag_verifications, [&](uint64_t address) {
-		auto& flag = m_flag_speculation[address];
-		if (flag.verify_tick == 0) {
-			return true;
-		}
-		if (flag.verify_tick > done) {
+	std::erase_if(m_flag_verifications, [&](const FlagCheck& check) {
+		if (check.tick > done) {
 			return false;
 		}
-		const auto verify_tick = flag.verify_tick;
-		flag.verify_tick       = 0;
-		// A shader recorded later may write it again: nothing to say then.
-		if (const auto* range = m_pending_gpu_writes.Find(address); range != nullptr && range->tick > verify_tick) {
-			return true;
-		}
-		uint64_t landed = 0;
-		if (!LibKernel::Memory::TryReadBacking(address, &landed, flag.size) ||
-		    TestWaitRegMemValue(landed, flag.ref, flag.mask, flag.func)) {
+		const auto offset = uint64_t {check.slot} * sizeof(uint64_t);
+		m_flag_captures->Invalidate(offset, sizeof(uint64_t));
+		uint64_t seen = 0;
+		std::memcpy(&seen, m_flag_captures->Mapped().data() + offset, check.size);
+		if (TestWaitRegMemValue(seen, check.ref, check.mask, check.func)) {
 			return true;
 		}
+		auto& flag   = m_flag_speculation[check.address];
 		flag.trusted = false;
 		flag.revoked = true;
 		static uint32_t misses = 0;
 		if (misses++ < 50) {
-			std::printf("Guest wait speculation: 0x%016" PRIx64 " holds 0x%" PRIx64 " once the shader's work is done, "
-			            "the wait wanted 0x%" PRIx64 "; this address waits again from now on\n",
-			            address, landed, flag.ref);
+			std::printf("Guest wait speculation: 0x%016" PRIx64 " held 0x%" PRIx64 " where the wait was, which "
+			            "wanted 0x%" PRIx64 "; this address waits again from now on\n",
+			            check.address, seen, check.ref);
 		}
 		return true;
 	});
@@ -1228,14 +1225,37 @@ bool BufferCache::TrustPendingGpuWrite(uint64_t vaddr, uint64_t size, uint32_t f
 		flag.waiting = true;
 		return false;
 	}
-	flag.func        = func;
-	flag.size        = static_cast<uint32_t>(size);
-	flag.ref         = ref;
-	flag.mask        = mask;
-	if (flag.verify_tick == 0) {
-		m_flag_verifications.push_back(vaddr);
+	// Checks end in the order they were recorded: with fewer than kFlagCaptureSlots waiting, the next slot is free.
+	const auto window = UnifiedWindow(vaddr, size);
+	if (!window || m_flag_verifications.size() >= kFlagCaptureSlots) {
+		return false;
+	}
+	if (!m_flag_captures) {
+		m_flag_captures = std::make_unique<Buffer>(m_graphics, m_scheduler, MemoryUsage::Download, 0,
+		                                           vk::BufferUsageFlagBits::eTransferDst,
+		                                           kFlagCaptureSlots * sizeof(uint64_t));
 	}
-	flag.verify_tick = std::max(flag.verify_tick, range->tick);
+	const auto slot = m_flag_capture_next;
+	m_flag_capture_next = (m_flag_capture_next + 1) % kFlagCaptureSlots;
+	auto& source  = m_slot_buffers[window];
+	auto& command = m_scheduler.Current();
+	command.EndRendering();
+	const auto native = command.Handle();
+	// Everything recorded before is done and its writes land first, as the wait asks of the command processor.
+	vk::MemoryBarrier before {};
+	before.srcAccessMask = vk::AccessFlagBits::eMemoryWrite;
+	before.dstAccessMask = vk::AccessFlagBits::eTransferRead;
+	native.pipelineBarrier(vk::PipelineStageFlagBits::eAllCommands, vk::PipelineStageFlagBits::eTransfer, {}, 1,
+	                       &before, 0, nullptr, 0, nullptr);
+	const vk::BufferCopy copy {source.Offset(vaddr), uint64_t {slot} * sizeof(uint64_t), size};
+	native.copyBuffer(source.Handle(), m_flag_captures->Handle(), 1, &copy);
+	vk::MemoryBarrier after {};
+	after.srcAccessMask = vk::AccessFlagBits::eTransferWrite;
+	after.dstAccessMask = vk::AccessFlagBits::eHostRead;
+	native.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer, vk::PipelineStageFlagBits::eHost, {}, 1, &after, 0,
+	                       nullptr, 0, nullptr);
+	m_flag_verifications.push_back({vaddr, m_scheduler.CurrentTick(), ref, mask, func, static_cast<uint32_t>(size),
+	                                slot});
 	return true;
 }
 
diff --git a/src/graphics/host_gpu/renderer/cache/bufferCache.h b/src/graphics/host_gpu/renderer/cache/bufferCache.h
index 61df3b12..a2f1b408 100644
--- a/src/graphics/host_gpu/renderer/cache/bufferCache.h
+++ b/src/graphics/host_gpu/renderer/cache/bufferCache.h
@@ -14,6 +14,7 @@
 
 #include <array>
 #include <map>
+#include <memory>
 #include <tuple>
 #include <unordered_map>
 #include <mutex>
@@ -112,8 +113,8 @@ public:
 	// GameFlex: a guest wait (WAIT_REG_MEM) for a value a shader recorded before will write. The GPU runs the
 	// stream in order: behind a barrier, everything recorded after the wait runs after that shader, which is all
 	// the wait asks, as long as the shader writes the value. An address is trusted once four waits there ended
-	// with the value; each trusted wait is checked when the writer's work is done, and a miss revokes the
-	// address for good. True: the wait may go on.
+	// with the value. At each trusted wait the GPU copies the value at that place in the stream, and the copy
+	// is checked once its work is done: a miss revokes the address for good. True: the wait may go on.
 	[[nodiscard]] bool TrustPendingGpuWrite(uint64_t vaddr, uint64_t size, uint32_t func, uint64_t ref, uint64_t mask);
 	// The guest wait at vaddr found its value in memory.
 	void GuestWaitPassed(uint64_t vaddr);
@@ -240,18 +241,26 @@ private:
 	// The words and addresses whose prediction waits to be checked, with the GPU tick in their entry: the checks
 	// walk these, not every address ever seen (a ring of flags grows the maps for good).
 	std::vector<uint64_t>                             m_srt_verifications;
-	std::vector<uint64_t>                             m_flag_verifications;
 	struct FlagSpeculation {
 		uint32_t confirmations = 0;
 		bool     waiting       = false; // suspended on a pending shader write, value not found yet
 		bool     trusted       = false;
 		bool     revoked       = false; // once wrong, never trusted again
-		uint32_t func          = 0;     // the last trusted wait's condition, checked at verify_tick
-		uint32_t size          = 0;
-		uint64_t ref           = 0;
-		uint64_t mask          = 0;
-		uint64_t verify_tick   = 0;     // the writer's work; 0 when nothing is to verify
 	};
+	// A trusted wait: the condition, and the slot of m_flag_captures the GPU copies the value to in the command
+	// buffer of `tick`, at the wait's place in the stream.
+	struct FlagCheck {
+		uint64_t address = 0;
+		uint64_t tick    = 0;
+		uint64_t ref     = 0;
+		uint64_t mask    = 0;
+		uint32_t func    = 0;
+		uint32_t size    = 0;
+		uint32_t slot    = 0;
+	};
+	std::vector<FlagCheck>                            m_flag_verifications;
+	std::unique_ptr<Buffer>                           m_flag_captures;
+	uint32_t                                          m_flag_capture_next = 0;
 	void VerifyFlagSpeculations();
 	std::unordered_map<uint64_t, FlagSpeculation>     m_flag_speculation;
 	// Ranges bound for writing that no TakeUnifiedGpuWrites has taken yet, and all of them.
