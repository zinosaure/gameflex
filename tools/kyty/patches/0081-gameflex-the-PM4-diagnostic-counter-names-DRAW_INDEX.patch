From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Gino D." <25200363+zinosaure@users.noreply.github.com>
Date: Tue, 17 Nov 2026 23:39:11 +0100
Subject: [PATCH] gameflex: the PM4 diagnostic counter names
 DRAW_INDEX_MULTI_INST

Upstream bf2af528 renamed opcode 0x3A from DISPATCH_DRAW_PREAMBLE to DRAW_INDEX_MULTI_INST; the
command-thread breakdown of 0056 still counts it as a draw.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/graphics/guest_gpu/graphicsRun.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/graphics/guest_gpu/graphicsRun.cpp b/src/graphics/guest_gpu/graphicsRun.cpp
index eda9484a..48e4842b 100644
--- a/src/graphics/guest_gpu/graphicsRun.cpp
+++ b/src/graphics/guest_gpu/graphicsRun.cpp
@@ -754,7 +754,7 @@ constexpr std::array<Common::CommandThreadProfile::Cause, 256> MakePacketCauses(
 	for (const auto op: {Pm4::IT_DISPATCH_DIRECT, Pm4::IT_DISPATCH_INDIRECT, Pm4::IT_DRAW_INDIRECT,
 	                     Pm4::IT_DRAW_INDEX_INDIRECT, Pm4::IT_DRAW_INDEX_2, Pm4::IT_DRAW_INDIRECT_MULTI,
 	                     Pm4::IT_DRAW_INDEX_AUTO, Pm4::IT_DRAW_INDEX_OFFSET_2, Pm4::IT_DRAW_INDEX_INDIRECT_MULTI,
-	                     Pm4::IT_DISPATCH_DRAW_PREAMBLE, Pm4::IT_DISPATCH_DRAW}) {
+	                     Pm4::IT_DRAW_INDEX_MULTI_INST, Pm4::IT_DISPATCH_DRAW}) {
 		causes[op] = Cause::Draw;
 	}
 	for (const auto op: {Pm4::IT_COPY_DATA, Pm4::IT_CP_DMA, Pm4::IT_DMA_DATA}) {
