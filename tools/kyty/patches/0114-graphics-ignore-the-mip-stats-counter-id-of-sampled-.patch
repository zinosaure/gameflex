From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheCruZ <thecruzwtf@gmail.com>
Date: Mon, 9 Nov 2026 04:16:00 +0100
Subject: [PATCH] graphics: ignore the mip-stats counter id of sampled depth
 T#s

(cherry picked from commit 4fa10abbf59a0860184772c7d08a83c6de88ce63)
---
 .../renderer/pipeline/descriptors.cpp         |  5 +++--
 tests/ShaderRecompilerComputeTests.cpp        | 19 +++++++++++++++++++
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp b/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp
index 5304146e..45c90c56 100644
--- a/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp
@@ -175,8 +175,9 @@ bool IsSupportedDepthTextureEncoding(const ShaderTextureResource& descriptor, bo
 	if (descriptor.MsaaDepth() && !IsMultisampledTexture(descriptor.Type())) {
 		return false;
 	}
-	// META_PIPE_ALIGNED only affects metadata addressing, which a clear COMPRESSION_EN disables.
-	const auto         metadata_control = descriptor.fields[6] & 0x00ffffffu;
+	// Bits 0-7 name the mip-stats counter. META_PIPE_ALIGNED only affects metadata addressing,
+	// which a clear COMPRESSION_EN disables.
+	const auto         metadata_control = descriptor.fields[6] & 0x00ffff00u;
 	constexpr uint32_t pipe_aligned     = 1u << 19u;
 	if ((metadata_control & ~pipe_aligned) == 0) {
 		return true;
diff --git a/tests/ShaderRecompilerComputeTests.cpp b/tests/ShaderRecompilerComputeTests.cpp
index e2d11e73..44c0bc93 100644
--- a/tests/ShaderRecompilerComputeTests.cpp
+++ b/tests/ShaderRecompilerComputeTests.cpp
@@ -50659,6 +50659,25 @@ void CheckDepthTextureEncoding() {
               IsSupportedDepthTextureEncoding(pipe_aligned_metadata),
           "uncompressed depth rejected inactive metadata address bits");
 
+  // Demon's Souls samples an uncompressed depth target whose T# names mip-stats
+  // counter 8 with the counter disabled.
+  const ShaderTextureResource mip_stats_counter{{
+      0x02766800u,
+      0xc1600000u,
+      0x0167c27fu,
+      0x91800924u,
+      0x00000000u,
+      0x00700000u,
+      0x00000008u,
+      0x00000002u,
+  }};
+  auto compressed_mip_stats_counter = compressed_descriptor;
+  compressed_mip_stats_counter.fields[6] |= 0xffu;
+  Require("DepthTextureEncoding", "mip-stats counter id",
+          IsSupportedDepthTextureEncoding(mip_stats_counter) &&
+              IsSupportedDepthTextureEncoding(compressed_mip_stats_counter),
+          "depth descriptor rejected its mip-stats counter id");
+
   const ShaderTextureResource first_use_depth{{
       0x0225fc00u, 0x01600000u, 0x00000000u, 0x91800924u,
       0x00000000u, 0x00700000u, 0x80280000u, 0x000225fdu,
