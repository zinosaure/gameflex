From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nmzik <Nmzik@mail.ru>
Date: Sun, 15 Nov 2026 21:14:23 +0100
Subject: [PATCH] shader: emit point and line output primitives for NGG
 geometry shaders

(cherry picked from commit 90b34153513533e4ca2502d98ccca887d79bf9f2)
---
 .../backend/spirv/spirvEmitterMesh.cpp        | 38 ++++++++++++-------
 .../backend/spirv/spirvEmitterModule.cpp      |  8 +++-
 src/graphics/shader/shader.cpp                | 14 ++++---
 src/graphics/shader/shader.h                  | 15 ++++----
 4 files changed, 48 insertions(+), 27 deletions(-)

diff --git a/src/graphics/shader/recompiler/backend/spirv/spirvEmitterMesh.cpp b/src/graphics/shader/recompiler/backend/spirv/spirvEmitterMesh.cpp
index c4c9d094..e0080793 100644
--- a/src/graphics/shader/recompiler/backend/spirv/spirvEmitterMesh.cpp
+++ b/src/graphics/shader/recompiler/backend/spirv/spirvEmitterMesh.cpp
@@ -35,6 +35,11 @@ uint32_t MeshOutputType(EmitterState& state, IR::StageOutputKind kind) {
 	}
 }
 
+uint32_t MeshPrimitiveType(EmitterState& state) {
+	const auto size = state.input_info.vertex->mesh.output_primitive_size;
+	return size == 1u ? TypeU32(state) : TypeU32Vector(state, size);
+}
+
 } // namespace
 
 void DefineMeshOutputs(EmitterState& state, uint32_t clip_distance_count,
@@ -81,15 +86,17 @@ void DefineMeshOutputs(EmitterState& state, uint32_t clip_distance_count,
 	state.mesh_allocation = MeshArray(state, spv::StorageClassWorkgroup, TypeU32(state), 2);
 	state.mesh_primitive_data =
 	    MeshArray(state, spv::StorageClassPrivate, TypeU32(state), state.lane_count);
-	state.mesh_primitives =
-	    MeshArray(state, spv::StorageClassOutput, TypeU32Vector(state, 3), mesh.max_primitives);
+	state.mesh_primitives = MeshArray(state, spv::StorageClassOutput, MeshPrimitiveType(state),
+	                                  mesh.max_primitives);
 	state.mesh_cull =
 	    MeshArray(state, spv::StorageClassOutput, TypeBool(state), mesh.max_primitives);
 	state.interface_variables.push_back(state.mesh_primitives);
 	state.interface_variables.push_back(state.mesh_cull);
-	state.builder.AddAnnotation(
-	    spv::OpDecorate, state.mesh_primitives, spv::DecorationBuiltIn,
-	    spv::BuiltInPrimitiveTriangleIndicesEXT); // PrimitiveTriangleIndicesEXT
+	constexpr spv::BuiltIn indices[] = {spv::BuiltInPrimitivePointIndicesEXT,
+	                                    spv::BuiltInPrimitiveLineIndicesEXT,
+	                                    spv::BuiltInPrimitiveTriangleIndicesEXT};
+	state.builder.AddAnnotation(spv::OpDecorate, state.mesh_primitives, spv::DecorationBuiltIn,
+	                            indices[mesh.output_primitive_size - 1u]);
 	state.builder.AddAnnotation(spv::OpDecorate, state.mesh_cull, spv::DecorationBuiltIn,
 	                            spv::BuiltInCullPrimitiveEXT); // CullPrimitiveEXT
 	state.builder.AddAnnotation(spv::OpDecorate, state.mesh_cull, spv::DecorationPerPrimitiveEXT);
@@ -182,20 +189,25 @@ void EmitMeshEntryPoint(EmitterState& state) {
 		EmitIfCondition(state, is_primitive, [&] {
 			const auto packed = MeshLoad(state, state.mesh_primitive_data, spv::StorageClassPrivate,
 			                             TypeU32(state), ConstantU32(state, half));
+			const auto size = state.input_info.vertex->mesh.output_primitive_size;
+			const auto type = MeshPrimitiveType(state);
 			uint32_t   vertex[3] {};
-			for (uint32_t component = 0; component < 3; component++) {
+			for (uint32_t component = 0; component < size; component++) {
 				vertex[component] = state.builder.AllocateId();
 				state.builder.AddFunction(
 				    spv::OpBitFieldUExtract, TypeU32(state), vertex[component], packed,
 				    ConstantU32(state, component * 10u), ConstantU32(state, 9));
 			}
-			const auto triangle = state.builder.AllocateId();
-			state.builder.AddFunction(spv::OpCompositeConstruct, TypeU32Vector(state, 3), triangle,
-			                          vertex[0], vertex[1], vertex[2]);
-			const auto triangle_pointer =
-			    MeshElement(state, state.mesh_primitives, spv::StorageClassOutput,
-			                TypeU32Vector(state, 3), index);
-			state.builder.AddFunction(spv::OpStore, triangle_pointer, triangle);
+			auto primitive = vertex[0];
+			if (size > 1u) {
+				primitive = state.builder.AllocateId();
+				state.builder.AddFunction(spv::OpCompositeConstruct, type, primitive,
+				                          std::span<const uint32_t>(vertex, size));
+			}
+			state.builder.AddFunction(
+			    spv::OpStore,
+			    MeshElement(state, state.mesh_primitives, spv::StorageClassOutput, type, index),
+			    primitive);
 			const auto null_bit =
 			    EmitBinaryU32(state, spv::OpBitwiseAnd, packed, ConstantU32(state, 0x80000000u));
 			const auto culled = state.builder.AllocateId();
diff --git a/src/graphics/shader/recompiler/backend/spirv/spirvEmitterModule.cpp b/src/graphics/shader/recompiler/backend/spirv/spirvEmitterModule.cpp
index 59c62b7b..337d80be 100644
--- a/src/graphics/shader/recompiler/backend/spirv/spirvEmitterModule.cpp
+++ b/src/graphics/shader/recompiler/backend/spirv/spirvEmitterModule.cpp
@@ -735,8 +735,12 @@ void DefineModule(EmitterState& state) {
 		state.mesh_guest_func = state.builder.AllocateId();
 		state.builder.RequireCapability(spv::CapabilityMeshShadingEXT); // MeshShadingEXT
 		state.builder.RequireExtension("SPV_EXT_mesh_shader");
-		state.builder.AddExecutionMode(state.main_func,
-		                               spv::ExecutionModeOutputTrianglesEXT); // OutputTrianglesEXT
+		constexpr spv::ExecutionMode output_modes[] = {spv::ExecutionModeOutputPoints,
+		                                               spv::ExecutionModeOutputLinesEXT,
+		                                               spv::ExecutionModeOutputTrianglesEXT};
+		state.builder.AddExecutionMode(
+		    state.main_func,
+		    output_modes[state.input_info.vertex->mesh.output_primitive_size - 1u]);
 		state.builder.AddExecutionMode(state.main_func, spv::ExecutionModeOutputVertices,
 		                               state.input_info.vertex->mesh.max_vertices);
 		state.builder.AddExecutionMode(state.main_func, spv::ExecutionModeOutputPrimitivesEXT,
diff --git a/src/graphics/shader/shader.cpp b/src/graphics/shader/shader.cpp
index 73a3f8d0..e74797ad 100644
--- a/src/graphics/shader/shader.cpp
+++ b/src/graphics/shader/shader.cpp
@@ -444,9 +444,9 @@ void BuildStageStaticKey(const ShaderVertexInputInfo& info, std::vector<uint32_t
 		const auto& mesh = info.mesh;
 		key.insert(key.end(), {mesh.wave_size, mesh.host_subgroup_size, mesh.lds_size_dwords,
 		                       mesh.scratch_size_dwords, mesh.input_primitive,
-		                       mesh.primitives_per_group, mesh.vertices_per_group,
-		                       mesh.max_vertices, mesh.max_primitives, mesh.provoking_vertex,
-		                       static_cast<uint32_t>(mesh.fast_launch)});
+		                       mesh.output_primitive_size, mesh.primitives_per_group,
+		                       mesh.vertices_per_group, mesh.max_vertices, mesh.max_primitives,
+		                       mesh.provoking_vertex, static_cast<uint32_t>(mesh.fast_launch)});
 	}
 	key.push_back(info.tess.input_control_points);
 	if (info.tess.input_control_points != 0) {
@@ -558,9 +558,12 @@ ShaderParams PrepareProgram(const HW::VertexShaderInfo& regs, const HW::Context&
 	mesh.input_primitive     = static_cast<uint32_t>(user_config.GetPrimType());
 	mesh.wave_size           = (context.GetShaderStages() & 0x00400000u) != 0 ? 32u : 64u;
 	mesh.max_vertices        = sh.m_geMaxOutputPerSubgroup;
-	mesh.provoking_vertex    = context.GetModeControl().provoking_vtx_last ? 2u : 0u;
 	mesh.lds_size_dwords     = static_cast<uint32_t>(regs.gs_regs.rsrc2.lds_size) * 128u;
 	mesh.scratch_size_dwords = data.scratch_size_dwords;
+	// VGT_GS_OUT_PRIM_TYPE 0, 1 and 2 output points, lines and triangles.
+	mesh.output_primitive_size = sh.m_vgtGsOutPrimType + 1u;
+	mesh.provoking_vertex =
+	    context.GetModeControl().provoking_vtx_last ? mesh.output_primitive_size - 1u : 0u;
 	const auto fast_launch = (context.GetShaderStages() >> 19u) & 3u;
 	EXIT_NOT_IMPLEMENTED(fast_launch > 1u);
 	mesh.fast_launch = fast_launch != 0;
@@ -595,7 +598,8 @@ ShaderParams PrepareProgram(const HW::VertexShaderInfo& regs, const HW::Context&
 	     user_config.GetPrimType() != Prospero::PrimitiveType::kTriFan &&
 	     user_config.GetPrimType() != Prospero::PrimitiveType::kTriStrip &&
 	     user_config.GetPrimType() != Prospero::PrimitiveType::kTriList) ||
-	    sh.m_vgtGsOutPrimType != 2u || (!native_ngg && sh.m_vgtGsMaxVertOut < 3u) ||
+	    sh.m_vgtGsOutPrimType > 2u ||
+	    (!native_ngg && sh.m_vgtGsMaxVertOut < mesh.output_primitive_size) ||
 	    group.vertex_group_size < mesh.InputPrimitiveSize() ||
 	    mesh.max_vertices == 0u) {
 		EXIT("unsupported GS assembly: input=%u output=%u vertices=%u GE=%u/%u max_output=%u\n",
diff --git a/src/graphics/shader/shader.h b/src/graphics/shader/shader.h
index f4986308..bbb01e56 100644
--- a/src/graphics/shader/shader.h
+++ b/src/graphics/shader/shader.h
@@ -80,13 +80,14 @@ struct ShaderWorkgroupInputInfo {
 };
 
 struct ShaderMeshInputInfo: ShaderWorkgroupInputInfo {
-	uint32_t input_primitive      = 0;
-	uint32_t primitives_per_group = 0;
-	uint32_t vertices_per_group   = 0;
-	uint32_t max_vertices         = 0;
-	uint32_t max_primitives       = 0;
-	uint32_t provoking_vertex     = 0;
-	bool     fast_launch          = false;
+	uint32_t input_primitive       = 0;
+	uint32_t output_primitive_size = 3;
+	uint32_t primitives_per_group  = 0;
+	uint32_t vertices_per_group    = 0;
+	uint32_t max_vertices          = 0;
+	uint32_t max_primitives        = 0;
+	uint32_t provoking_vertex      = 0;
+	bool     fast_launch           = false;
 
 	[[nodiscard]] constexpr uint32_t InputPrimitiveSize() const {
 		switch (static_cast<Prospero::PrimitiveType>(input_primitive)) {
