 .../host_gpu/renderer/cache/textureCache.h    | 11 ++++++-
 .../renderer/pipeline/descriptors.cpp         | 33 ++++++++++++++++++-
 src/graphics/host_gpu/renderer/render.h       | 23 +++++++++++++
 4 files changed, 82 insertions(+), 3 deletions(-)

diff --git a/src/graphics/host_gpu/renderer/cache/textureCache.cpp b/src/graphics/host_gpu/renderer/cache/textureCache.cpp
index b811171b..06f94b65 100644
--- a/src/graphics/host_gpu/renderer/cache/textureCache.cpp
+++ b/src/graphics/host_gpu/renderer/cache/textureCache.cpp
@@ -227,6 +227,7 @@ void TextureCache::RegisterImage(ImageId id) {
 	image.registered = true;
 	image.lru_id     = m_lru_cache.Insert(id, m_gc_tick);
 	m_total_used_memory += image.AccountedSize();
+	m_generation++;
 }
 
 void TextureCache::UnregisterImage(ImageId id) {
@@ -242,6 +243,7 @@ void TextureCache::UnregisterImage(ImageId id) {
 	m_lru_cache.Free(image.lru_id);
 	m_total_used_memory -= image.AccountedSize();
 	image.registered = false;
+	m_generation++;
 }
 
 void TextureCache::DeleteImage(ImageId id) {
@@ -1247,7 +1249,17 @@ ImageId TextureCache::AssociateStencil(ImageId depth_id, GuestRange stencil) {
 	return association;
 }
 
-ImageId TextureCache::FindImage(ImageDesc& desc, bool exact_format) {
+void TextureCache::TouchFoundImage(ImageId id, const ImageDesc& desc, uint32_t metadata_base_layer) {
+	{
+		std::scoped_lock lock {m_lock};
+		auto& image              = m_slot_images[id];
+		image.tick_accessed_last = m_scheduler.CurrentTick();
+		TouchImage(image);
+	}
+	MaterializeColorClear(id, desc, metadata_base_layer);
+}
+
+ImageId TextureCache::FindImage(ImageDesc& desc, bool exact_format, bool* exclusive) {
 	ValidateImageDesc(desc);
 	EXIT_IF(desc.info.data.Empty());
 	const auto metadata_base_layer = desc.view_info.base_layer;
@@ -1359,6 +1371,10 @@ ImageId TextureCache::FindImage(ImageDesc& desc, bool exact_format) {
 		}
 		image.tick_accessed_last = m_scheduler.CurrentTick();
 		TouchImage(image);
+		if (exclusive != nullptr) {
+			*exclusive = !block_alias && std::none_of(candidates.begin(), candidates.end(),
+			                                          [result](ImageId id) { return id != result; });
+		}
 	}
 	MaterializeColorClear(result, desc, metadata_base_layer);
 	if (desc.type == BindingType::VideoOut &&
diff --git a/src/graphics/host_gpu/renderer/cache/textureCache.h b/src/graphics/host_gpu/renderer/cache/textureCache.h
index a0bacf1e..468b6d7c 100644
--- a/src/graphics/host_gpu/renderer/cache/textureCache.h
+++ b/src/graphics/host_gpu/renderer/cache/textureCache.h
@@ -50,7 +50,15 @@ public:
 	~TextureCache();
 	KYTY_CLASS_NO_COPY(TextureCache);
 
-	[[nodiscard]] ImageId       FindImage(ImageDesc& desc, bool exact_format = false);
+	// `exclusive`, when asked: the image found is the only one registered over its memory, so that the same
+	// description finds it again as long as the cache registers or frees nothing (Generation).
+	[[nodiscard]] ImageId       FindImage(ImageDesc& desc, bool exact_format = false,
+	                                      bool* exclusive = nullptr);
+	// Grows whenever an image is registered or freed: what FindImage returns may change then, not before.
+	[[nodiscard]] uint64_t      Generation() const noexcept { return m_generation; }
+	// An image FindImage found before, bound again: what FindImage does once it holds the image.
+	void                        TouchFoundImage(ImageId id, const ImageDesc& desc,
+	                                            uint32_t metadata_base_layer);
 	void                        UpdateImage(ImageId id);
 	[[nodiscard]] ImageId       FindImageFromRange(uint64_t address, uint64_t size,
 	                                               bool ensure_valid = true);
@@ -165,6 +173,7 @@ private:
 	BufferCache&                                      m_buffer_cache;
 	Common::SlotVector<Image>                         m_slot_images;
 	ImagePageTable                                    m_image_page_table;
+	uint64_t                                          m_generation = 0;
 	Common::LeastRecentlyUsedCache<ImageId, uint64_t> m_lru_cache;
 	std::unordered_set<ImageId>                       m_download_images;
 	std::map<uint64_t, MetaDataInfo>                  m_surface_metas;
diff --git a/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp b/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp
index ff7b11d5..b59ac30e 100644
--- a/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp
@@ -30,6 +30,7 @@
 #include "kernel/memory.h"
 
 #include <algorithm>
+#include <functional>
 #include <atomic>
 #include <bit>
 #include <fmt/format.h>
@@ -37,6 +38,8 @@
 #include <span>
 #include <vector>
 
+#include <xxhash.h>
+
 namespace Libs::Graphics {
 
 namespace {
@@ -479,6 +482,11 @@ static bool ResolveTextureMipView(ImageInfo& info, uint32_t physical_levels, boo
 	return false;
 }
 
+size_t RenderExecutor::TextureBindingKeyHash::operator()(const TextureBindingKey& key) const noexcept {
+	return XXH3_64bits(key.dwords.data(), key.dwords.size() * sizeof(uint32_t)) ^
+	       std::hash<const void*> {}(key.resource);
+}
+
 TextureBinding RenderExecutor::ResolveTexture(const ShaderRecompiler::IR::ImageResource&   resource,
                                               const ShaderRecompiler::IR::DescriptorValue& value) {
 	if (resource.atomic64 && !m_context.GetGraphics().shader_image_int64_atomics_enabled) {
@@ -494,6 +502,19 @@ TextureBinding RenderExecutor::ResolveTexture(const ShaderRecompiler::IR::ImageR
 	if (descriptor.IsNull()) {
 		return {.layout = vk::ImageLayout::eGeneral};
 	}
+	// Found before, for this descriptor and this shader resource, with nothing registered or freed since: the
+	// same image. Heap descriptors depend on what is mapped: they are resolved every time.
+	const TextureBindingKey key {value.dwords, &resource};
+	if (!resource.heap) {
+		if (const auto found = m_texture_bindings.find(key); found != m_texture_bindings.end()) {
+			if (found->second.generation == texture_cache.Generation()) {
+				const auto& cached = found->second;
+				texture_cache.TouchFoundImage(cached.found_id, cached.desc, cached.metadata_base_layer);
+				return {cached.image_id, nullptr, cached.desc};
+			}
+			m_texture_bindings.erase(found);
+		}
+	}
 
 	const auto address         = descriptor.Base40();
 	const auto width           = static_cast<uint32_t>(descriptor.Width5()) + 1u;
@@ -615,11 +636,14 @@ TextureBinding RenderExecutor::ResolveTexture(const ShaderRecompiler::IR::ImageR
 	desc.type = storage ? TextureCache::BindingType::Storage : TextureCache::BindingType::Texture;
 	desc.heap = resource.heap;
 
-	auto id = texture_cache.FindImage(desc, shader_conversion);
+	const auto metadata_base_layer = desc.view_info.base_layer;
+	bool       exclusive           = false;
+	auto       id                  = texture_cache.FindImage(desc, shader_conversion, &exclusive);
 	if (!id) {
 		// Another extent at the address holds it; the heap retries once an image is created.
 		return {.desc = std::move(desc), .layout = vk::ImageLayout::eGeneral};
 	}
+	const auto found_id            = id;
 	auto*      image               = &texture_cache.GetImage(id);
 	const bool stencil_association = static_cast<bool>(image->depth_id);
 	if (stencil_association) {
@@ -640,6 +664,13 @@ TextureBinding RenderExecutor::ResolveTexture(const ShaderRecompiler::IR::ImageR
 		(void)SelectSampledColorView(image->info.pixel_format, desc.view_info.format,
 		                             descriptor.DstSelXYZW());
 	}
+	if (!resource.heap && exclusive) {
+		if (m_texture_bindings.size() >= 4096) {
+			m_texture_bindings.clear();
+		}
+		m_texture_bindings.insert_or_assign(
+		    key, CachedTextureBinding {found_id, id, desc, metadata_base_layer, texture_cache.Generation()});
+	}
 	return {id, nullptr, std::move(desc)};
 }
 
diff --git a/src/graphics/host_gpu/renderer/render.h b/src/graphics/host_gpu/renderer/render.h
index 580da626..f8513472 100644
--- a/src/graphics/host_gpu/renderer/render.h
