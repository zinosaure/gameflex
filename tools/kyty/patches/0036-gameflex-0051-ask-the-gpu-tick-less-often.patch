From: "Gino D." <25200363+zinosaure@users.noreply.github.com>
Date: Sun, 8 Nov 2026 21:49:26 +0000
Subject: [PATCH] gameflex 0051: ask the gpu tick less often
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

demander moins souvent au pilote où en est le GPU

Détail : tools/kyty/README.md du dépôt GameFlex, entrée 0051.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/graphics/host_gpu/renderer/commandScheduler.cpp | 11 +++++++++++
 src/graphics/host_gpu/renderer/commandScheduler.h   |  2 ++
 2 files changed, 13 insertions(+)

diff --git a/src/graphics/host_gpu/renderer/commandScheduler.cpp b/src/graphics/host_gpu/renderer/commandScheduler.cpp
index 930a5a83..7d344574 100644
--- a/src/graphics/host_gpu/renderer/commandScheduler.cpp
+++ b/src/graphics/host_gpu/renderer/commandScheduler.cpp
@@ -173,6 +173,17 @@ void CommandScheduler::Wait(uint64_t tick) {
 }
 
 void CommandScheduler::PopPendingOperations() {
+	// GameFlex: this runs at every draw, and asking the driver where the GPU is costs a system call
+	// (vkGetSemaphoreCounterValue, an ioctl): 9 % of the command thread in Kingdom Hearts III. While
+	// the oldest pending operation is not known to be done, IsFree below asks at most once every 16
+	// calls; these operations wait for the GPU anyway, a few draws later changes nothing.
+	{
+		std::lock_guard lock(m_operation_mutex);
+		if (m_pending_operations.empty() ||
+		    (!m_master.IsFree(m_pending_operations.front().tick) && (++m_refresh_skips & 15u) != 0)) {
+			return;
+		}
+	}
 	for (;;) {
 		PendingOperation operation;
 		{
diff --git a/src/graphics/host_gpu/renderer/commandScheduler.h b/src/graphics/host_gpu/renderer/commandScheduler.h
index ab0b8058..05bcd3fd 100644
--- a/src/graphics/host_gpu/renderer/commandScheduler.h
+++ b/src/graphics/host_gpu/renderer/commandScheduler.h
@@ -94,6 +94,8 @@ private:
 	std::queue<PendingOperation> m_pending_operations;
 	std::queue<PendingOperation> m_priority_operations;
 	std::mutex                   m_operation_mutex;
+	// GameFlex: PopPendingOperations calls since the driver was last asked where the GPU is.
+	uint32_t m_refresh_skips = 0;
 	std::condition_variable      m_operation_available;
 	std::jthread                 m_priority_thread;
 	uint64_t                     m_priority_active_tick = 0; // 0 while none runs
