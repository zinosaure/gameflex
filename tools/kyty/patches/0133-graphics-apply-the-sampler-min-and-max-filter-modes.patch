Subject: [PATCH] graphics: apply the sampler min and max filter modes

(cherry picked from commit 07e87b950a9cbe590c13e8dcc5346bc1f5480506)
---
 src/graphics/host_gpu/graphicContext.h        |  1 +
 .../host_gpu/renderer/cache/samplerCache.cpp  |  8 ++++
 .../presentation/window/vulkanWindow.cpp      |  2 +
 tests/ShaderRecompilerComputeTests.cpp        | 48 +++++++++++++++++++
 4 files changed, 59 insertions(+)

diff --git a/src/graphics/host_gpu/graphicContext.h b/src/graphics/host_gpu/graphicContext.h
index d04d1e9c..265b5cb9 100644
--- a/src/graphics/host_gpu/graphicContext.h
+++ b/src/graphics/host_gpu/graphicContext.h
@@ -47,6 +47,7 @@ struct GraphicContext {
 	bool                               conditional_rendering_enabled         = false;
 	// End-of-pipe writes that do not stall the command processor (the labels of RELEASE_MEM).
 	bool                               buffer_marker_enabled                 = false;
+	bool                               sampler_filter_minmax_enabled         = false;
 	bool                               occlusion_queries_enabled             = false;
 	bool                               host_query_reset_enabled              = false;
 	bool                               occlusion_query_precise_enabled       = false;
diff --git a/src/graphics/host_gpu/renderer/cache/samplerCache.cpp b/src/graphics/host_gpu/renderer/cache/samplerCache.cpp
index 117ba161..fab2871f 100644
--- a/src/graphics/host_gpu/renderer/cache/samplerCache.cpp
+++ b/src/graphics/host_gpu/renderer/cache/samplerCache.cpp
@@ -148,6 +148,14 @@ vk::Sampler SamplerCache::GetSampler(const ShaderSamplerResource& r, bool intege
 		sampler_info.mipLodBias       = 0.0f;
 	}
 
+	// FILTER_MODE 0-2 equal VkSamplerReductionMode; 3 is undefined, compare samplers average.
+	vk::SamplerReductionModeCreateInfo reduction {};
+	if (m_graphics.sampler_filter_minmax_enabled && !sampler_info.compareEnable &&
+	    r.FilterMode() < 3) {
+		reduction.reductionMode = static_cast<vk::SamplerReductionMode>(r.FilterMode());
+	}
+	sampler_info.pNext = &reduction;
+
 	vk::Sampler vk_sampler = nullptr;
 	const auto  result     = m_graphics.device.createSampler(&sampler_info, nullptr, &vk_sampler);
 	EXIT_NOT_IMPLEMENTED(result != vk::Result::eSuccess || vk_sampler == nullptr);
diff --git a/src/graphics/presentation/window/vulkanWindow.cpp b/src/graphics/presentation/window/vulkanWindow.cpp
index 859c1a0c..bf216c2e 100644
--- a/src/graphics/presentation/window/vulkanWindow.cpp
