Subject: [PATCH] libs: stub the web browser and player invitation dialog
 status updates

(cherry picked from commit 4da95bd8d0f389d168812b98e58791055912e880)
---
 src/libs/libDialog.cpp           | 19 +++++++++++++++++++
 src/libs/libWebBrowserDialog.cpp |  1 +
 2 files changed, 20 insertions(+)

diff --git a/src/libs/libDialog.cpp b/src/libs/libDialog.cpp
index a4707c07..38b7505a 100644
--- a/src/libs/libDialog.cpp
+++ b/src/libs/libDialog.cpp
@@ -150,6 +150,24 @@ LIB_DEFINE(InitDialog_1_ErrorDialog) {
 
 } // namespace LibErrorDialog
 
+namespace LibPlayerInvitationDialog {
+
+LIB_VERSION("PlayerInvitationDialog", 1, "PlayerInvitationDialog", 1, 1);
+
+constexpr int PLAYER_INVITATION_DIALOG_STATUS_NONE = 0;
+
+static int KYTY_SYSV_ABI PlayerInvitationDialogUpdateStatus() {
+	PRINT_NAME();
+
+	return PLAYER_INVITATION_DIALOG_STATUS_NONE;
+}
+
+LIB_DEFINE(InitDialog_1_PlayerInvitationDialog) {
+	LIB_FUNC("kFhuwHrIUqs", PlayerInvitationDialogUpdateStatus);
+}
+
+} // namespace LibPlayerInvitationDialog
+
 LIB_DEFINE(InitDialog_1) {
 	LibCommonDialog::InitDialog_1_CommonDialog(s);
 	LibImeDialog::InitDialog_1_ImeDialog(s);
@@ -159,6 +177,7 @@ LIB_DEFINE(InitDialog_1) {
 	LibSaveDataDialogNative::InitDialog_1_SaveDataDialogNative(s);
 	LibMsgDialog::InitDialog_1_MsgDialog(s);
 	LibErrorDialog::InitDialog_1_ErrorDialog(s);
+	LibPlayerInvitationDialog::InitDialog_1_PlayerInvitationDialog(s);
 }
 
 } // namespace Libs
diff --git a/src/libs/libWebBrowserDialog.cpp b/src/libs/libWebBrowserDialog.cpp
index 7c295b2c..0740d3e7 100644
--- a/src/libs/libWebBrowserDialog.cpp
+++ b/src/libs/libWebBrowserDialog.cpp
@@ -20,6 +20,7 @@ static int KYTY_SYSV_ABI WebBrowserDialogGetStatus() {
 
 LIB_DEFINE(InitWebBrowserDialog_1) {
 	LIB_FUNC("CFTG6a8TjOU", WebBrowserDialog::WebBrowserDialogGetStatus);
+	LIB_FUNC("h1dR-t5ISgg", WebBrowserDialog::WebBrowserDialogGetStatus);
 }
 
 } // namespace Libs
