From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nawid3333 <102778966+Nawid3333@users.noreply.github.com>
Date: Wed, 4 Nov 2026 23:59:00 +0100
Subject: [PATCH] controller: do not send light bar colours to mono-LED pads
 (ASTRO BOT) (#2116)

* controller: do not send light bar colours to mono-LED pads

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

* tests: check the light bar for every LED capability combination

A pad gets the colour unless it reports a mono LED and no RGB LED; pads with both LEDs or
none reported keep receiving it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

* controller: check only the mono LED, rename the LED helper and shorten its test

---------

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 4c890e90857bab980bd4654f7cb9ca9d7c31e6f5)
---
 src/libs/controller.cpp           | 14 +++++++++++---
 tests/ControllerSettingsTests.cpp | 24 ++++++++++++++++++++++++
 2 files changed, 35 insertions(+), 3 deletions(-)

diff --git a/src/libs/controller.cpp b/src/libs/controller.cpp
index 527d5dbc..60b762f6 100644
--- a/src/libs/controller.cpp
+++ b/src/libs/controller.cpp
@@ -202,6 +202,14 @@ static uint32_t g_keyboard_player = 0;
 static void RefreshPlayers();
 static void StopHostPad(SDL_Gamepad* pad);
 
+// A mono LED cannot show the colour, and on Switch pads each write waits for the pad's reply.
+static void SetHostPadLED(SDL_Gamepad* pad, uint8_t r, uint8_t g, uint8_t b) {
+	if (!SDL_GetBooleanProperty(SDL_GetGamepadProperties(pad),
+	                            SDL_PROP_GAMEPAD_CAP_MONO_LED_BOOLEAN, false)) {
+		(void)SDL_SetGamepadLED(pad, r, g, b);
+	}
+}
+
 static int KeyboardPlayer() {
 	return g_keyboard_player == 0 ? 0 : static_cast<int>(g_keyboard_player) - 1;
 }
@@ -499,7 +507,7 @@ void GameController::SetDevices(int active_id) {
 		if (auto* pad = SDL_GetGamepadFromID(static_cast<SDL_JoystickID>(active_id));
 		    pad != nullptr) {
 			if (const auto& color = Config::GetControllerColor()) {
-				(void)SDL_SetGamepadLED(pad, (*color)[0], (*color)[1], (*color)[2]);
+				SetHostPadLED(pad, (*color)[0], (*color)[1], (*color)[2]);
 			}
 			for (auto sensor: {SDL_SENSOR_ACCEL, SDL_SENSOR_GYRO}) {
 				if (SDL_GamepadHasSensor(pad, sensor) &&
@@ -851,7 +859,7 @@ static void StopHostPad(SDL_Gamepad* pad) {
 		(void)SDL_SendGamepadEffect(pad, &effect, sizeof(effect));
 	}
 	(void)SDL_RumbleGamepad(pad, 0, 0, 0);
-	(void)SDL_SetGamepadLED(pad, 0, 0, 0);
+	SetHostPadLED(pad, 0, 0, 0);
 }
 
 void GameController::SetVibration(uint8_t large_motor, uint8_t small_motor) {
@@ -904,7 +912,7 @@ void GameController::SetLightBar(uint8_t r, uint8_t g, uint8_t b) {
 	}
 	if (auto* pad = SDL_GetGamepadFromID(static_cast<SDL_JoystickID>(m_active_id));
 	    pad != nullptr) {
-		(void)SDL_SetGamepadLED(pad, r, g, b);
+		SetHostPadLED(pad, r, g, b);
 	}
 }
 
diff --git a/tests/ControllerSettingsTests.cpp b/tests/ControllerSettingsTests.cpp
index 531c36d6..bd48db92 100644
--- a/tests/ControllerSettingsTests.cpp
+++ b/tests/ControllerSettingsTests.cpp
@@ -27,6 +27,7 @@ bool                               haptics_handles_rumble = false;
 std::array<Rumble, 6>               pad_rumble {};
 std::vector<int>                    closed_pads;
 std::array<std::array<Uint8, 3>, 6> pad_colors {};
+std::array<bool, 6>                 mono_led {};
 } // namespace
 
 namespace Fake {
@@ -66,6 +67,12 @@ void CloseGamepad(SDL_Gamepad* pad) {
 	closed_pads.push_back(static_cast<int>(reinterpret_cast<uintptr_t>(pad)));
 }
 void Delay(Uint32) {}
+SDL_PropertiesID GetGamepadProperties(SDL_Gamepad* pad) {
+	return static_cast<SDL_PropertiesID>(reinterpret_cast<uintptr_t>(pad));
+}
+bool GetBooleanProperty(SDL_PropertiesID pad, const char* name, bool) {
+	return std::strcmp(name, SDL_PROP_GAMEPAD_CAP_MONO_LED_BOOLEAN) == 0 && mono_led[pad];
+}
 } // namespace Fake
 
 #define SDL_GetTicks                Fake::GetTicks
@@ -78,6 +85,8 @@ void Delay(Uint32) {}
 #define SDL_SetGamepadSensorEnabled Fake::SetGamepadSensorEnabled
 #define SDL_CloseGamepad            Fake::CloseGamepad
 #define SDL_Delay                   Fake::Delay
+#define SDL_GetGamepadProperties    Fake::GetGamepadProperties
+#define SDL_GetBooleanProperty      Fake::GetBooleanProperty
 #include "libs/controller.cpp"
 #undef SDL_GetTicks
 #undef SDL_GetGamepadFromID
@@ -89,6 +98,8 @@ void Delay(Uint32) {}
 #undef SDL_SetGamepadSensorEnabled
 #undef SDL_CloseGamepad
 #undef SDL_Delay
+#undef SDL_GetGamepadProperties
+#undef SDL_GetBooleanProperty
 
 namespace Libs::Controller {
 // No virtual headset in these tests (padVr.cpp is not linked here).
@@ -433,6 +444,18 @@ void TestIndependentOutputsAndPadSwitch() {
 	}
 }
 
+void TestMonoLedPadGetsNoLightBar() {
+	Controller             controller;
+	const PadLightBarParam first {10, 20, 30, 0};
+	const PadLightBarParam second {40, 50, 60, 0};
+	Check(PadSetLightBar(1, &first) == 0 && pad_colors[1] == std::array<Uint8, 3> {10, 20, 30},
+	      "a pad without an LED capability did not receive the light bar");
+	mono_led[1] = true;
+	Check(PadSetLightBar(1, &second) == 0 && pad_colors[1] == std::array<Uint8, 3> {10, 20, 30},
+	      "a mono-LED pad received the light bar");
+	mono_led[1] = false;
+}
+
 void TestPlayerUserIds() {
 	Check(Config::IsConfiguredUserIdValid(Config::MAX_USER_ID) &&
 	          !Config::IsConfiguredUserIdValid(Config::MAX_USER_ID + 1) &&
@@ -742,6 +765,7 @@ int main() {
 	TestVibrationLifetime();
 	TestMaskedTriggersAndValidation();
 	TestIndependentOutputsAndPadSwitch();
+	TestMonoLedPadGetsNoLightBar();
 	TestTriggerEffectState();
 	TestUnreadPressSurvivesStickBurst();
 	TestMultiplayerRouting();
