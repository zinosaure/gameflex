+	const auto in_bounds = EmitStorageElementInBounds(ctx.state, resource, index);
+	const auto read      = [&]() { return LoadSubwordInBounds(ctx, resource, address, index, bits); };
+	if (ReadCannotFault(resource.kind, mem.coherent)) {
