 .../backend/spirv/spirvEmitterMemory.cpp      | 82 +++++++++++++------
 2 files changed, 103 insertions(+), 27 deletions(-)

diff --git a/src/graphics/shader/recompiler/backend/spirv/spirvEmitterInternal.h b/src/graphics/shader/recompiler/backend/spirv/spirvEmitterInternal.h
index b3ec5dce..0cd51774 100644
--- a/src/graphics/shader/recompiler/backend/spirv/spirvEmitterInternal.h
+++ b/src/graphics/shader/recompiler/backend/spirv/spirvEmitterInternal.h
@@ -112,6 +112,9 @@ struct EmitterState {
 	uint32_t                                         lane_half               = 0;
 	std::array<BufferDefinition, 4>                  storage_buffers {};
 	std::vector<uint32_t>                           memory_byte_offsets;
+	// GameFlex: while a buffer read issued for every lane is emitted (EmitReadOrDefault), the guest lanes it reads
+	// for; the others address past every binding, where the device returns zero without touching memory.
+	uint32_t                                        read_lanes = 0;
 	std::vector<uint32_t>                           memory_byte_sizes;
 	uint32_t                                         bda_pagetable_variable  = 0;
 	uint32_t                                         fault_buffer_variable   = 0;
@@ -621,6 +624,51 @@ uint32_t EmitValueOrZeroIfCondition(EmitterState& state, uint32_t condition, Fn&
 	                                     std::forward<Fn>(fn));
 }
 
+// GameFlex: memory a read cannot fault on, whatever its index. Kyty requires robustBufferAccess and nullDescriptor,
+// so a storage buffer descriptor keeps any index in its binding or reads zero, and a missing buffer is a null
+// descriptor. Physical addresses, LDS, GDS and scratch are not robust; a coherent read keeps its place.
+[[nodiscard]] inline bool ReadCannotFault(IR::ResourceKind kind, bool coherent) {
+	return !coherent && (kind == IR::ResourceKind::Buffer || kind == IR::ResourceKind::ScalarBuffer);
+}
+
+// GameFlex: the read is issued whatever the guest's condition, which only picks the value. Branching around each
+// read made the device wait for it before the next one could start and reload its descriptor every time: issued
+// unconditionally, reads are grouped and widened, and the device waits once. fn must only read.
+// GameFlex: the guest lanes of a buffer read issued for every lane, for the time it is emitted.
+class ReadLanesScope {
+public:
+	ReadLanesScope(EmitterState& state, uint32_t lanes): m_state(state), m_previous(state.read_lanes) {
+		state.read_lanes = lanes;
+	}
+	~ReadLanesScope() { m_state.read_lanes = m_previous; }
+	ReadLanesScope(const ReadLanesScope&)            = delete;
+	ReadLanesScope& operator=(const ReadLanesScope&) = delete;
+
+private:
+	EmitterState& m_state;
+	uint32_t      m_previous;
+};
+
+template <typename Fn>
+uint32_t EmitReadOrDefault(EmitterState& state, uint32_t condition, uint32_t components,
+                           uint32_t default_value, Fn&& fn) {
+	const auto value = fn();
+	if (condition == ConstantBool(state, true)) return value;
+	if (components == 1u) return Select(state, TypeU32(state), condition, value, default_value);
+	// A pair is a structure, which SPIR-V 1.3 does not select: one component at a time.
+	std::vector<uint32_t> words {spv::OpCompositeConstruct, TypeU32Composite(state, components), 0u};
+	for (uint32_t component = 0; component < components; component++) {
+		const auto read     = state.builder.AllocateId();
+		const auto fallback = state.builder.AllocateId();
+		state.builder.AddFunction(spv::OpCompositeExtract, TypeU32(state), read, value, component);
+		state.builder.AddFunction(spv::OpCompositeExtract, TypeU32(state), fallback, default_value, component);
+		words.push_back(Select(state, TypeU32(state), condition, read, fallback));
+	}
+	words[2] = state.builder.AllocateId();
+	state.builder.AddFunction(words);
+	return words[2];
+}
+
 template <typename Fn>
 uint32_t AtomicUpdate(EmitterState& state, uint32_t pointer, IR::ResourceKind kind, Fn&& desired) {
 	const auto scope     = kind == IR::ResourceKind::Lds ? spv::ScopeWorkgroup : spv::ScopeDevice;
diff --git a/src/graphics/shader/recompiler/backend/spirv/spirvEmitterMemory.cpp b/src/graphics/shader/recompiler/backend/spirv/spirvEmitterMemory.cpp
index 4c6d4b9a..cf788240 100644
--- a/src/graphics/shader/recompiler/backend/spirv/spirvEmitterMemory.cpp
+++ b/src/graphics/shader/recompiler/backend/spirv/spirvEmitterMemory.cpp
@@ -257,9 +257,10 @@ uint32_t ByteAddress(ValueEmitContext& ctx, const IR::Inst& inst, const IR::Memo
 		const auto address = Binary(ctx.state, spv::OpIAdd, TypeU32(ctx.state),
 		                            BufferByteAddress(ctx, inst, mem), prefix);
 		// The host binding prefix must not wrap an out-of-range guest address into the buffer.
-		return Select(ctx.state, TypeU32(ctx.state),
-		              Binary(ctx.state, spv::OpUGreaterThanEqual, TypeBool(ctx.state), address, prefix),
-		              address, ConstantU32(ctx.state, UINT32_MAX));
+		auto in_range = Binary(ctx.state, spv::OpUGreaterThanEqual, TypeBool(ctx.state), address, prefix);
+		// A read issued for every lane: the lanes the guest does not read for fetch nothing.
+		if (ctx.state.read_lanes != 0u) in_range = AndCondition(ctx.state, ctx.state.read_lanes, in_range);
+		return Select(ctx.state, TypeU32(ctx.state), in_range, address, ConstantU32(ctx.state, UINT32_MAX));
 	}
 	if (mem.kind == IR::ResourceKind::Lds || mem.kind == IR::ResourceKind::Gds) {
 		if (mem.offset == 0u) {
@@ -378,17 +379,26 @@ uint32_t BufferIndexInBounds(ValueEmitContext& ctx, const IR::Inst& inst,
 
 uint32_t LoadWordPrepared(ValueEmitContext& ctx, const IR::Inst& inst, const IR::MemoryInfo& mem,
                           const MemoryResourceAccess& resource) {
-	const auto index = DwordIndex(ctx, inst, mem, resource.byte_offset);
-	return EmitValueOrZeroIfCondition(
-	    ctx.state, EmitStorageElementInBounds(ctx.state, resource, index),
-	    [&]() { return LoadWordInBounds(ctx, resource, index); });
+	const auto index     = DwordIndex(ctx, inst, mem, resource.byte_offset);
+	const auto in_bounds = EmitStorageElementInBounds(ctx.state, resource, index);
+	const auto read      = [&]() { return LoadWordInBounds(ctx, resource, index); };
+	if (ReadCannotFault(resource.kind, mem.coherent)) {
+		return EmitReadOrDefault(ctx.state, in_bounds, 1u, ConstantU32(ctx.state, 0), read);
+	}
+	return EmitValueOrZeroIfCondition(ctx.state, in_bounds, read);
 }
 
 uint32_t LoadWord(ValueEmitContext& ctx, const IR::Inst& inst, IR::MemoryInfo mem) {
-	return EmitValueOrZeroIfCondition(ctx.state, ctx.Arg(inst, inst.NumArgs() - 1), [&]() {
+	const auto active = ctx.Arg(inst, inst.NumArgs() - 1);
+	const auto read   = [&]() {
 		const auto resource = PrepareMemoryResourceAccess(ctx.state, mem);
 		return LoadWordPrepared(ctx, inst, mem, resource);
-	});
+	};
+	if (ReadCannotFault(mem.kind, mem.coherent)) {
+		const ReadLanesScope lanes(ctx.state, active);
+		return EmitReadOrDefault(ctx.state, active, 1u, ConstantU32(ctx.state, 0), read);
+	}
+	return EmitValueOrZeroIfCondition(ctx.state, active, read);
 }
 
