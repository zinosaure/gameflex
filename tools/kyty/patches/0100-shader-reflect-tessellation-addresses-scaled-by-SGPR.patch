From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nmzik <Nmzik@mail.ru>
Date: Fri, 6 Nov 2026 04:33:45 +0100
Subject: [PATCH] shader: reflect tessellation addresses scaled by SGPR-staged
 SDWA literals

(cherry picked from commit 65cfffe88fdfadbfc89615136603879a2c0934e5)
---
 .../shader/recompiler/Tessellation.cpp        | 19 +++++++++++++--
 .../recompiler/frontend/cfg/ShaderCFG.cpp     | 24 +++++++++----------
 .../recompiler/frontend/cfg/ShaderCFG.h       |  1 +
 tests/ShaderRecompilerComputeTests.cpp        | 16 ++++++++++---
 4 files changed, 43 insertions(+), 17 deletions(-)

diff --git a/src/graphics/shader/recompiler/Tessellation.cpp b/src/graphics/shader/recompiler/Tessellation.cpp
index d3ebc5de..c32149d5 100644
--- a/src/graphics/shader/recompiler/Tessellation.cpp
+++ b/src/graphics/shader/recompiler/Tessellation.cpp
@@ -3,6 +3,7 @@
 #include "common/assert.h"
 #include "common/logging/log.h"
 #include "graphics/shader/recompiler/ShaderRecompiler.h"
+#include "graphics/shader/recompiler/frontend/cfg/ShaderCFG.h"
 #include "graphics/shader/recompiler/frontend/decode/ShaderDecoder.h"
 #include "graphics/shader/recompiler/ir/ShaderIR.h"
 #include "graphics/shader/recompiler/ir/passes/ConstantPropagation.h"
@@ -28,10 +29,12 @@ struct TessellationAddress {
 // Reflects the LS output stride, or the HS output stride and patch constant range.
 void ReflectTessellationLayout(const Decoder::Program& program, bool local,
                                ShaderTessellationInputInfo& info) {
+	// Registers tracks the VGPRs, then the SGPR codes through VCC_HI.
+	constexpr uint32_t scalars = IR::NumScalarRegs + 2u;
 	using namespace Decoder;
 	using Address   = TessellationAddress;
 	using Kind      = Address::Kind;
-	using Registers = std::array<Address, IR::NumVectorRegs>;
+	using Registers = std::array<Address, IR::NumVectorRegs + scalars>;
 
 	const auto control_points = local ? info.input_control_points : info.output_control_points;
 	Registers  entry {}, registers;
@@ -54,6 +57,8 @@ void ReflectTessellationLayout(const Decoder::Program& program, bool local,
 			value = constant(operand.value);
 		} else if (operand.kind == OperandKind::Vgpr) {
 			value = registers.at(operand.reg);
+		} else if (uint32_t code = 0; CFG::ScalarOperandCode(operand, code) && code < scalars) {
+			value = registers[IR::NumVectorRegs + code];
 		}
 		if (value.kind == Kind::PackedControlPoint && operand.sdwa_sel == 0u) return patch;
 		return operand.sdwa_sel == 6u ? value : Address {};
@@ -141,6 +146,16 @@ void ReflectTessellationLayout(const Decoder::Program& program, bool local,
 					patch_end        = std::max(patch_end, begin + 4u * inst.data_dwords);
 				}
 			}
+			// SDWA takes no literal, so S_MOVK_I32 stages factors in SGPRs. Other writes clear
+			// them; a lane mask may span two SGPRs, as in wave64.
+			for (uint32_t code = 0; code < scalars; code++) {
+				auto& scalar = registers[IR::NumVectorRegs + code];
+				if (scalar != Address {} && CFG::MayWriteScalarRegister(inst, code, 64u))
+					scalar = {};
+			}
+			if (uint32_t code = 0; inst.opcode == Opcode::S_MOVK_I32 &&
+			                       CFG::ScalarOperandCode(inst.dst, code) && code < scalars)
+				registers[IR::NumVectorRegs + code] = constant(inst.src0.value);
 			// Store vdata is a source, despite occupying the decoder's dst field.
 			if (local_store || buffer_store || inst.dst.kind != OperandKind::Vgpr) continue;
 			const auto lhs   = read(inst.src0);
@@ -190,7 +205,7 @@ void ReflectTessellationLayout(const Decoder::Program& program, bool local,
 			    inst.dst.dpp)
 				value = {};
 			for (uint32_t index = 0;
-			     index < std::max(inst.data_dwords, 1u) && inst.dst.reg + index < registers.size();
+			     index < std::max(inst.data_dwords, 1u) && inst.dst.reg + index < IR::NumVectorRegs;
 			     index++) {
 				registers[inst.dst.reg + index] = {};
 			}
diff --git a/src/graphics/shader/recompiler/frontend/cfg/ShaderCFG.cpp b/src/graphics/shader/recompiler/frontend/cfg/ShaderCFG.cpp
index af350e5a..cb33a9e4 100644
--- a/src/graphics/shader/recompiler/frontend/cfg/ShaderCFG.cpp
+++ b/src/graphics/shader/recompiler/frontend/cfg/ShaderCFG.cpp
@@ -70,18 +70,6 @@ BranchCondition ConditionForOpcode(Opcode opcode) {
 	}
 }
 
-bool ScalarOperandCode(const Decoder::Operand& operand, uint32_t& code) {
-	switch (operand.kind) {
-		case Decoder::OperandKind::Sgpr: code = operand.reg; return true;
-		case Decoder::OperandKind::VccLo: code = 106u; return true;
-		case Decoder::OperandKind::VccHi: code = 107u; return true;
-		case Decoder::OperandKind::M0: code = 124u; return true;
-		case Decoder::OperandKind::ExecLo: code = 126u; return true;
-		case Decoder::OperandKind::ExecHi: code = 127u; return true;
-		default: return false;
-	}
-}
-
 bool IsScalarCode(const Decoder::Operand& operand, uint32_t code) {
 	uint32_t operand_code = 0;
 	return ScalarOperandCode(operand, operand_code) && operand_code == code;
@@ -1661,6 +1649,18 @@ Graph Structurize(const Graph& graph) {
 	return GotoStructurizer(graph).Run();
 }
 
+bool ScalarOperandCode(const Decoder::Operand& operand, uint32_t& code) {
+	switch (operand.kind) {
+		case Decoder::OperandKind::Sgpr: code = operand.reg; return true;
+		case Decoder::OperandKind::VccLo: code = 106u; return true;
+		case Decoder::OperandKind::VccHi: code = 107u; return true;
+		case Decoder::OperandKind::M0: code = 124u; return true;
+		case Decoder::OperandKind::ExecLo: code = 126u; return true;
+		case Decoder::OperandKind::ExecHi: code = 127u; return true;
+		default: return false;
+	}
+}
+
 bool MayWriteScalarRegister(const Decoder::Instruction& inst, uint32_t code, uint32_t wave_size) {
 	// A vector lane mask (comparison or carry) spans wave_size / 32 SGPRs; a lane read writes one.
 	if (inst.family == Decoder::Family::VOP1 || inst.family == Decoder::Family::VOP2 ||
diff --git a/src/graphics/shader/recompiler/frontend/cfg/ShaderCFG.h b/src/graphics/shader/recompiler/frontend/cfg/ShaderCFG.h
index a9561b65..bceffd3c 100644
--- a/src/graphics/shader/recompiler/frontend/cfg/ShaderCFG.h
+++ b/src/graphics/shader/recompiler/frontend/cfg/ShaderCFG.h
@@ -114,6 +114,7 @@ struct Graph {
 };
 
 Graph       BuildGraph(const Decoder::Program& program);
+bool        ScalarOperandCode(const Decoder::Operand& operand, uint32_t& code);
 bool MayWriteScalarRegister(const Decoder::Instruction& inst, uint32_t code, uint32_t wave_size);
 // Returns the one instruction defining `code` that reaches `before` (UINT32_MAX: the entry value),
 // or nullopt if several do.
diff --git a/tests/ShaderRecompilerComputeTests.cpp b/tests/ShaderRecompilerComputeTests.cpp
index 6cf30e90..2dc9ce5d 100644
--- a/tests/ShaderRecompilerComputeTests.cpp
+++ b/tests/ShaderRecompilerComputeTests.cpp
@@ -49251,9 +49251,11 @@ void CheckTessellationSingleControlPoint() {
   local.push_back(EncodeDs1Ex(0, 5, 2, 16));
   local.push_back(EncodeSop1(0x20, 0, 6));
 
-  // v_lshlrev_b32_sdwa v33, 7, v1 src1_sel:BYTE_0
-  control.push_back(EncodeVop2(0x1a, 33, 249u, 1));
-  control.push_back(EncodeVop2Sdwa(InlineU32(7), 6, 0, 6, 0, 0, 0, 0, 0, 0, 0, 1));
+  // SDWA takes no literal: s_movk_i32 vcc_lo, hs_stride
+  control.push_back(EncodeSopk(0x00, 106, hs_stride));
+  // v_mul_u32_u24_sdwa v33, vcc_lo, v1 src1_sel:BYTE_0
+  control.push_back(EncodeVop2(0x0b, 33, 249u, 1));
+  control.push_back(EncodeVop2Sdwa(106, 6, 0, 6, 0, 0, 0, 0, 0, 0, 0, 1));
   control.push_back(EncodeMubuf0(0x1d)); // buffer_store_dwordx2 v[10:11], v33, s[8:11], s2 offen
   control.push_back(EncodeMubuf1(10, 2, 33, 2));
   control.push_back(EncodeVop2(0x1b, 32, 255u, 1)); // v_and_b32 v32, 0xff, v1
@@ -49281,6 +49283,14 @@ void CheckTessellationSingleControlPoint() {
           "patch-ordinal control point stores and descending patch constants must reflect "
           "the layout");
   std::printf("[host]    %-32s ok\n", name);
+#if KYTY_PLATFORM != KYTY_PLATFORM_WINDOWS
+  // v_cmp_lt_f32 vcc, 0, v10 after s_movk_i32 replaces the staged stride.
+  control.insert(control.begin() + 1, EncodeVopc(0x01, InlineU32(0), 10));
+  ExpectFatal("TessellationClobberedScalar", [&] {
+    ShaderTessellationInputInfo info{.input_control_points = 1, .output_control_points = 1};
+    AnalyzeTessellationPrograms(local, control, info);
+  });
+#endif
 }
 
