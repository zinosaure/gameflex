+namespace Detail {
+template <size_t N>
+void LoadAll(const std::atomic<uint64_t> (&counters)[N], std::array<uint64_t, N>& values) noexcept {
+	for (size_t i = 0; i < N; i++) {
+		values[i] = counters[i].load(std::memory_order_relaxed);
+	}
+}
