From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nmzik <Nmzik@mail.ru>
Date: Fri, 6 Nov 2026 00:51:32 +0100
Subject: [PATCH] shader: specialize a null image as the dimension and cube its
 instructions declare

(cherry picked from commit 9a29dc62cf144236a1aaa800fb9030e34bf201cc)
---
 .../recompiler/frontend/decode/ImageOps.cpp   |  1 +
 .../frontend/decode/ShaderDecoder.h           |  1 +
 .../recompiler/frontend/translate/Memory.cpp  |  1 +
 src/graphics/shader/recompiler/ir/Serialize.h |  3 +-
 src/graphics/shader/recompiler/ir/ShaderIR.h  |  1 +
 .../ir/passes/ResourceMaterialization.cpp     |  3 +-
 .../recompiler/ir/passes/ResourceTracking.cpp |  2 ++
 tests/shaderCfgTests.cpp                      | 32 +++++++++++++++++++
 8 files changed, 41 insertions(+), 3 deletions(-)

diff --git a/src/graphics/shader/recompiler/frontend/decode/ImageOps.cpp b/src/graphics/shader/recompiler/frontend/decode/ImageOps.cpp
index 2133ea6b..f459d2b2 100644
--- a/src/graphics/shader/recompiler/frontend/decode/ImageOps.cpp
+++ b/src/graphics/shader/recompiler/frontend/decode/ImageOps.cpp
@@ -390,6 +390,7 @@ void DecodeMimg(uint32_t pc, std::span<const uint32_t> code, uint32_t word_index
 	}
 	inst.image_dimension  = dimension;
 	inst.image_r128       = r128;
+	inst.image_cube       = ((word0 >> 3u) & 0x7u) == 3u;
 	inst.image_nsa_dwords = nsa_dwords;
 	for (uint32_t i = 0; i < nsa_dwords * 4u; i++) {
 		inst.image_nsa_addr[i] = (code[word_index + 2u + i / 4u] >> ((i % 4u) * 8u)) & 0xffu;
diff --git a/src/graphics/shader/recompiler/frontend/decode/ShaderDecoder.h b/src/graphics/shader/recompiler/frontend/decode/ShaderDecoder.h
index 3855797b..62b2417e 100644
--- a/src/graphics/shader/recompiler/frontend/decode/ShaderDecoder.h
+++ b/src/graphics/shader/recompiler/frontend/decode/ShaderDecoder.h
@@ -878,6 +878,7 @@ struct Instruction {
 	bool           idxen                                        = false;
 	bool           offen                                        = false;
 	bool           image_r128                                   = false;
+	bool           image_cube                                   = false; // DIM is CUBE.
 	uint32_t       branch_target                                = 0;
 	struct {
 		uint32_t target = 0;
diff --git a/src/graphics/shader/recompiler/frontend/translate/Memory.cpp b/src/graphics/shader/recompiler/frontend/translate/Memory.cpp
index 816e540f..b208ed8b 100644
--- a/src/graphics/shader/recompiler/frontend/translate/Memory.cpp
+++ b/src/graphics/shader/recompiler/frontend/translate/Memory.cpp
@@ -85,6 +85,7 @@ IR::MemoryInfo MemoryInfoFromDecoded(const Decoder::Instruction& decoded) {
 	memory.image_has_mip = decoded.opcode == Decoder::Opcode::IMAGE_LOAD_MIP ||
 	                       decoded.opcode == Decoder::Opcode::IMAGE_STORE_MIP;
 	memory.image_r128    = decoded.image_r128;
+	memory.image_cube    = decoded.image_cube;
 	memory.idxen         = decoded.idxen;
 	memory.offen         = decoded.offen;
 	// Vector loads use GLC/DLC to bypass L0/GL1; atomics use GLC only to return data.
diff --git a/src/graphics/shader/recompiler/ir/Serialize.h b/src/graphics/shader/recompiler/ir/Serialize.h
index ecb1bbf9..24e7bb2b 100644
--- a/src/graphics/shader/recompiler/ir/Serialize.h
+++ b/src/graphics/shader/recompiler/ir/Serialize.h
@@ -147,7 +147,8 @@ template <class S, class T> void Io(S& io, T& value) {
 		auto& [__VA_ARGS__] = object;                                                              \
 		IoAll(io, __VA_ARGS__);                                                                    \
