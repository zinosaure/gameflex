+++ b/src/common/platform/sysLinuxFileIO.cpp
@@ -151,13 +151,6 @@ bool SysFileCreateDirectory(const std::filesystem::path& path) {
 	return true;
 }
 
-bool SysFileDeleteDirectory(const std::filesystem::path& path) {
