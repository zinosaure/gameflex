diff --git a/src/kernel/fileSystem.cpp b/src/kernel/fileSystem.cpp
index b22b96f9..e2beea32 100644
--- a/src/kernel/fileSystem.cpp
+++ b/src/kernel/fileSystem.cpp
@@ -63,6 +63,7 @@ public:
 
 	[[nodiscard]] std::filesystem::path ResolvePath(const std::string& mounted_name);
 	void SetUnrealSavedConfig(const std::string& project);
+	[[nodiscard]] bool                  IsMountPoint(const std::string& point);
 
 private:
 	std::vector<MountPair> m_mount_pairs;
@@ -310,6 +311,22 @@ void MountPoints::Umount(const std::string& folder_or_point) {
 	}
 }
 
+// Guests join mount points and names with extra slashes (e.g. "/addcont0//file").
+static std::string NormalizeGuestPath(const std::string& mounted_name) {
+	std::string normalized = Common::FixFilenameSlash(mounted_name);
+	normalized.erase(std::unique(normalized.begin(), normalized.end(),
+	                             [](char a, char b) { return a == '/' && b == '/'; }),
+	                 normalized.end());
+	return normalized;
+}
+
+bool MountPoints::IsMountPoint(const std::string& point) {
+	Common::LockGuard lock(m_mutex);
+
+	return std::ranges::any_of(m_mount_pairs,
+	                           [&point](const MountPair& p) { return p.point == point; });
+}
+
 #if KYTY_PLATFORM != KYTY_PLATFORM_WINDOWS
 // Resolve guest paths case-insensitively on case-sensitive hosts.
 static std::filesystem::path ResolvePathIgnoringCase(const std::filesystem::path& path) {
@@ -372,11 +389,7 @@ void MountPoints::SetUnrealSavedConfig(const std::string& project) {
 std::filesystem::path MountPoints::ResolvePath(const std::string& mounted_name) {
 	Common::LockGuard lock(m_mutex);
 
-	// Guests join mount points and names with extra slashes (e.g. "/addcont0//file").
-	std::string normalized = Common::FixFilenameSlash(mounted_name);
-	normalized.erase(std::unique(normalized.begin(), normalized.end(),
-	                             [](char a, char b) { return a == '/' && b == '/'; }),
-	                 normalized.end());
+	std::string normalized = NormalizeGuestPath(mounted_name);
 	if (normalized == m_unreal_config_in_game_folder) {
 		normalized = m_unreal_saved_config;
 	}
@@ -1751,22 +1764,41 @@ int KYTY_SYSV_ABI KernelRmdir(const char* path) {
 	PRINT_NAME();
 
 	if (path == nullptr) {
-		return KERNEL_ERROR_EINVAL;
+		return KERNEL_ERROR_EFAULT;
+	}
+
+	if (std::strlen(path) > 255) {
+		return KERNEL_ERROR_ENAMETOOLONG;
 	}
 
 	LOGF("\t path = %s\n", path);
 
-	auto real_name = g_mount_points->ResolvePath(std::string(path));
+	const auto directory = Common::FixDirectorySlash(NormalizeGuestPath(path));
+	if (directory.ends_with("/./") || directory.ends_with("/../")) {
+		return KERNEL_ERROR_EINVAL;
+	}
+
+	if (g_mount_points->IsMountPoint(directory)) {
+		return KERNEL_ERROR_EBUSY;
+	}
+
+	const auto real_name = g_mount_points->ResolvePath(path);
 	if (Common::IsArchivePath(real_name)) {
 		return KERNEL_ERROR_EROFS;
 	}
 
-	if (!Common::File::IsDirectoryExisting(real_name)) {
+	const auto info = Common::File::GetInfo(real_name);
+	if (!info) {
 		return KERNEL_ERROR_ENOENT;
 	}
 
-	if (!Common::File::DeleteDirectory(real_name)) {
-		return KERNEL_ERROR_EIO;
+	if (info->is_file) {
+		return KERNEL_ERROR_ENOTDIR;
+	}
+
+	std::error_code error;
+	if (!std::filesystem::remove(real_name, error)) {
+		return error == std::errc::directory_not_empty ? KERNEL_ERROR_ENOTEMPTY : KERNEL_ERROR_EIO;
 	}
 
 	return OK;
diff --git a/src/libs/libKernel.cpp b/src/libs/libKernel.cpp
index 88921eb8..e83b56fd 100644
--- a/src/libs/libKernel.cpp
+++ b/src/libs/libKernel.cpp
@@ -1885,6 +1885,12 @@ int KYTY_SYSV_ABI mkdir(const char* path, uint16_t mode) {
 	return POSIX_CALL(LibKernel::FileSystem::KernelMkdir(path, mode));
 }
 
+int KYTY_SYSV_ABI rmdir(const char* path) {
+	PRINT_NAME();
+
+	return POSIX_CALL(LibKernel::FileSystem::KernelRmdir(path));
+}
+
 int64_t KYTY_SYSV_ABI lseek(int d, int64_t offset, int whence) {
 	PRINT_NAME();
 
@@ -3334,6 +3340,7 @@ LIB_DEFINE(InitLibKernel_1_Pthread) {
 	LIB_FUNC("z0dtnPxYgtg", chmod);
 	LIB_FUNC("VAzswvTOCzI", FileSystem::KernelUnlink);
 	LIB_FUNC("JGMio+21L4c", Posix::mkdir);
+	LIB_FUNC("c7ZnT7V1B98", Posix::rmdir);
 	LIB_FUNC("wuCroIGjt2g", FileSystem::KernelOpen);
 	LIB_FUNC("bY-PO6JhzhQ", FileSystem::KernelClose);
 	LIB_FUNC("FN4gaPmuFV8", FileSystem::KernelWrite);
