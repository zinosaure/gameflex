 	auto real_name_str = real_name.string();
diff --git a/src/common/platform/sysWindowsFileIO.cpp b/src/common/platform/sysWindowsFileIO.cpp
index 416d09db..8b751c03 100644
--- a/src/common/platform/sysWindowsFileIO.cpp
+++ b/src/common/platform/sysWindowsFileIO.cpp
@@ -141,11 +141,6 @@ bool SysFileCreateDirectory(const std::filesystem::path& path) {
 	return CreateDirectoryW(wide.c_str(), nullptr) != 0;
 }
 
-bool SysFileDeleteDirectory(const std::filesystem::path& path) {
