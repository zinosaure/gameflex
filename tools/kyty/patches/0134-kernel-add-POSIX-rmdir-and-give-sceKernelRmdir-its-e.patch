 src/kernel/fileSystem.cpp                | 52 +++++++++++++++++++-----
 src/libs/libKernel.cpp                   |  7 ++++
 7 files changed, 49 insertions(+), 32 deletions(-)

diff --git a/src/common/file.cpp b/src/common/file.cpp
index 568b877f..4c724b2d 100644
