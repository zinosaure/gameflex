diff --git a/src/graphics/host_gpu/graphicContext.h b/src/graphics/host_gpu/graphicContext.h
index 5efcdc57..47b7b2e7 100644
--- a/src/graphics/host_gpu/graphicContext.h
+++ b/src/graphics/host_gpu/graphicContext.h
@@ -35,6 +35,9 @@ struct GraphicContext {
 	bool                               compute_subgroup_size_control_enabled = false;
 	bool                               shader_image_int64_atomics_enabled    = false;
 	bool                               attachment_feedback_loop_enabled      = false;
+	// GameFlex: one pixel in four is shaded in draws at least twice as tall as the window, where the
+	// presentation scales the image down anyway (VK_KHR_fragment_shading_rate, --coarse-shading).
+	bool                               coarse_shading_enabled                = false;
 	bool                               provoking_vertex_last_enabled         = false;
 	bool                               maintenance8_enabled                  = false;
 	bool                               robust_buffer_access_enabled          = false;
diff --git a/src/graphics/host_gpu/renderer/dynamicState.cpp b/src/graphics/host_gpu/renderer/dynamicState.cpp
index b38b1f2d..e44f6e6b 100644
--- a/src/graphics/host_gpu/renderer/dynamicState.cpp
+++ b/src/graphics/host_gpu/renderer/dynamicState.cpp
@@ -2,9 +2,26 @@
 
 #include "graphics/host_gpu/graphicContext.h"
 
+#include <cmath>
+
 namespace Libs::Graphics {
 
 void DynamicState::Commit(const GraphicContext& graphics, vk::CommandBuffer cmdbuf) {
+	if (graphics.coarse_shading_enabled) {
+		// The window is the size the image is shown at: a draw at least twice as tall gives four
+		// shaded pixels for each one shown, so it shades one in four. Smaller draws stay exact.
+		const bool coarse = num_viewports != 0 && graphics.screen_height != 0 &&
+		                    std::abs(viewports[0].height) >= 2.0f * static_cast<float>(graphics.screen_height);
+		if (dirty_state.shading_rate || coarse != coarse_shading) {
+			dirty_state.shading_rate = false;
+			coarse_shading           = coarse;
+			const vk::Extent2D                         size(coarse ? 2 : 1, coarse ? 2 : 1);
+			const vk::FragmentShadingRateCombinerOpKHR combiners[2] = {
+			    vk::FragmentShadingRateCombinerOpKHR::eKeep,
+			    vk::FragmentShadingRateCombinerOpKHR::eKeep};
+			cmdbuf.setFragmentShadingRateKHR(&size, combiners);
+		}
+	}
 	if (dirty_state.viewports) {
 		dirty_state.viewports = false;
 		cmdbuf.setViewportWithCount(num_viewports, viewports.data());
diff --git a/src/graphics/host_gpu/renderer/dynamicState.h b/src/graphics/host_gpu/renderer/dynamicState.h
index 97aa594e..0b328c4c 100644
--- a/src/graphics/host_gpu/renderer/dynamicState.h
+++ b/src/graphics/host_gpu/renderer/dynamicState.h
@@ -57,11 +57,13 @@ struct DynamicState {
 		bool blend_constants       : 1;
 		bool line_width            : 1;
 		bool feedback_loop_aspects : 1;
+		bool shading_rate          : 1;
 	} dirty_state {};
 
 	std::array<vk::Viewport, 16> viewports {};
 	std::array<vk::Rect2D, 16>   scissors {};
 	uint32_t                   num_viewports {};
+	bool                       coarse_shading {};
 	uint32_t                   num_scissors {};
 
 	bool          depth_test_enabled {};
diff --git a/src/graphics/host_gpu/renderer/pipeline/shaders.cpp b/src/graphics/host_gpu/renderer/pipeline/shaders.cpp
index c8d845d7..c3b3de93 100644
--- a/src/graphics/host_gpu/renderer/pipeline/shaders.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/shaders.cpp
@@ -397,6 +397,9 @@ void CreatePipelineInternal(GraphicContext& graphics, PipelineCache::Pipeline& p
 	if (graphics.attachment_feedback_loop_enabled) {
 		dynamic_states.push_back(vk::DynamicState::eAttachmentFeedbackLoopEnableEXT);
 	}
+	if (graphics.coarse_shading_enabled) {
+		dynamic_states.push_back(vk::DynamicState::eFragmentShadingRateKHR);
+	}
 
 	vk::PipelineDynamicStateCreateInfo dynamic_state {};
 	dynamic_state.dynamicStateCount = static_cast<uint32_t>(dynamic_states.size());
diff --git a/src/graphics/presentation/window/vulkanWindow.cpp b/src/graphics/presentation/window/vulkanWindow.cpp
index ee1eeffa..7cdd5652 100644
--- a/src/graphics/presentation/window/vulkanWindow.cpp
+++ b/src/graphics/presentation/window/vulkanWindow.cpp
@@ -404,12 +404,13 @@ static vk::Device VulkanCreateDevice(GraphicContext&          graphics,
 	                   vk::PhysicalDeviceAccelerationStructureFeaturesKHR,
 	                   vk::PhysicalDeviceRayQueryFeaturesKHR,
 	                   vk::PhysicalDeviceCooperativeMatrixFeaturesKHR,
-	                   vk::PhysicalDeviceShaderFloat8FeaturesEXT>
+	                   vk::PhysicalDeviceShaderFloat8FeaturesEXT,
+	                   vk::PhysicalDeviceFragmentShadingRateFeaturesKHR>
 	    supported;
 	auto& [supported2, supported12, supported13, robustness2, workgroup_layout, mesh,
 	       feedback_layout, feedback_dynamic, provoking_vertex, maintenance8, shader_clock,
 	       image_atomic_int64, conditional_rendering, barycentric, compute_derivatives,
-	       acceleration_structure, ray_query, cooperative_matrix, float8] = supported;
+	       acceleration_structure, ray_query, cooperative_matrix, float8, shading_rate] = supported;
 	graphics.memory_budget_ext_enabled = add(VK_EXT_MEMORY_BUDGET_EXTENSION_NAME);
 	graphics.buffer_marker_enabled     = add(VK_AMD_BUFFER_MARKER_EXTENSION_NAME);
 	add(VK_EXT_DEPTH_RANGE_UNRESTRICTED_EXTENSION_NAME);
@@ -471,6 +472,11 @@ static vk::Device VulkanCreateDevice(GraphicContext&          graphics,
 	if (!fsr || !add(VK_EXT_SHADER_FLOAT8_EXTENSION_NAME)) {
 		supported.unlink<vk::PhysicalDeviceShaderFloat8FeaturesEXT>();
 	}
+	// Coarse shading takes the extension only when it is asked for: the dynamic state it adds to
+	// every graphics pipeline would otherwise cost something for nothing.
+	if (!Config::CoarseShadingEnabled() || !add(VK_KHR_FRAGMENT_SHADING_RATE_EXTENSION_NAME)) {
+		supported.unlink<vk::PhysicalDeviceFragmentShadingRateFeaturesKHR>();
+	}
 	if (Libs::LibKernel::Memory::UnifiedMemoryFd() >= 0 &&
 	    HasExtension(available_extensions, VK_KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME) &&
 	    HasExtension(available_extensions, VK_EXT_EXTERNAL_MEMORY_DMA_BUF_EXTENSION_NAME)) {
@@ -563,6 +569,10 @@ static vk::Device VulkanCreateDevice(GraphicContext&          graphics,
 		    std::lround(graphics.physical_device_properties.limits.timestampPeriod * 1000.0f));
 	}
 	graphics.conditional_rendering_enabled = conditional_rendering.conditionalRendering;
+	graphics.coarse_shading_enabled =
+	    Config::CoarseShadingEnabled() && shading_rate.pipelineFragmentShadingRate;
+	LOGF("Vulkan coarse shading (2x2 in draws twice the window height): %s\n",
+	     graphics.coarse_shading_enabled ? "true" : "false");
 	LOGF("Vulkan maintenance8 support: %s\n",
 	     graphics.maintenance8_enabled ? "true" : "false");
 	LOGF("Vulkan depth feedback support: %s\n",
@@ -673,6 +683,7 @@ static vk::Device VulkanCreateDevice(GraphicContext&          graphics,
 	    shader_clock, conditional_rendering, compute_derivatives,
 	    vk::PhysicalDeviceAccelerationStructureFeaturesKHR {.accelerationStructure = VK_TRUE},
 	    vk::PhysicalDeviceRayQueryFeaturesKHR {.rayQuery = VK_TRUE}, cooperative_matrix, float8,
+	    vk::PhysicalDeviceFragmentShadingRateFeaturesKHR {.pipelineFragmentShadingRate = VK_TRUE},
 	    // The renderer only uses the Vulkan 1.3 core dynamic states, but RADV (Mesa 26.3) creates
 	    // its PS epilog cache only when this EXT feature is enabled and crashes in vkCmdDraw when
 	    // a depth- or stencil-writing fragment shader needs an epilog.
@@ -710,6 +721,9 @@ static vk::Device VulkanCreateDevice(GraphicContext&          graphics,
 	if (!compute_derivatives.computeDerivativeGroupQuads) {
 		create.unlink<vk::PhysicalDeviceComputeShaderDerivativesFeaturesKHR>();
 	}
+	if (!graphics.coarse_shading_enabled) {
+		create.unlink<vk::PhysicalDeviceFragmentShadingRateFeaturesKHR>();
+	}
 	if (!extended_dynamic_state) {
 		create.unlink<vk::PhysicalDeviceExtendedDynamicStateFeaturesEXT>();
 	}
