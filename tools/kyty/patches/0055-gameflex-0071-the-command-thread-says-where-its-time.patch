+	uint64_t   queued  = 0;
+	uint64_t   buffers = 0;
+	const auto done    = m_master.KnownGpuTick();
+	while (!m_timestamp_pending.empty() && m_timestamp_pending.front() <= done) {
+		const auto tick = m_timestamp_pending.front();
+		m_timestamp_pending.pop_front();
