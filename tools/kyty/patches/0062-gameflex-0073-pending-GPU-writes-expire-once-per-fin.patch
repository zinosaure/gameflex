From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Gino D." <25200363+zinosaure@users.noreply.github.com>
Date: Mon, 9 Nov 2026 09:06:53 +0000
Subject: [PATCH] gameflex 0073: pending GPU writes expire once per finished
 buffer

---
 src/graphics/host_gpu/renderer/cache/bufferCache.cpp      | 7 +++++--
 src/graphics/host_gpu/renderer/cache/bufferCache.h        | 1 +
 src/graphics/host_gpu/renderer/cache/pendingGpuWrites.cpp | 5 +++++
 src/graphics/host_gpu/renderer/cache/pendingGpuWrites.h   | 2 ++
 4 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/src/graphics/host_gpu/renderer/cache/bufferCache.cpp b/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
index 68da01ab..3a645a84 100644
--- a/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
+++ b/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
@@ -1036,8 +1036,11 @@ bool BufferCache::PendingGuestWrite(uint64_t vaddr, uint64_t size, uint64_t* val
 	if (m_pending_guest_writes.empty()) {
 		return false;
 	}
-	const auto done = m_scheduler.GetMasterSemaphore().KnownGpuTick();
-	std::erase_if(m_pending_guest_writes, [done](const auto& entry) { return entry.second.tick <= done; });
+	// Labels written since the last expiry carry later ticks: the same tick has nothing to expire.
+	if (const auto done = m_scheduler.GetMasterSemaphore().KnownGpuTick(); done != m_pending_guest_writes_expired) {
+		m_pending_guest_writes_expired = done;
+		std::erase_if(m_pending_guest_writes, [done](const auto& entry) { return entry.second.tick <= done; });
+	}
 	const auto found = m_pending_guest_writes.find(vaddr);
 	if (found == m_pending_guest_writes.end() || found->second.size != size) {
 		return false;
diff --git a/src/graphics/host_gpu/renderer/cache/bufferCache.h b/src/graphics/host_gpu/renderer/cache/bufferCache.h
index e9f60800..5b3920df 100644
--- a/src/graphics/host_gpu/renderer/cache/bufferCache.h
+++ b/src/graphics/host_gpu/renderer/cache/bufferCache.h
@@ -223,6 +223,7 @@ private:
 		uint64_t value = 0;
 	};
 	std::map<uint64_t, PendingGuestWriteEntry> m_pending_guest_writes;
+	uint64_t                                   m_pending_guest_writes_expired = 0; // the GPU tick of the last expiry
 	// A window of guest addresses starts at every GiB and covers two: any range up to 1 GiB fits
 	// one (the device's buffers stay under 4 GiB).
 	static constexpr uint32_t UnifiedWindowBits = 30;
diff --git a/src/graphics/host_gpu/renderer/cache/pendingGpuWrites.cpp b/src/graphics/host_gpu/renderer/cache/pendingGpuWrites.cpp
index 7e8bcd43..4492f1b6 100644
--- a/src/graphics/host_gpu/renderer/cache/pendingGpuWrites.cpp
+++ b/src/graphics/host_gpu/renderer/cache/pendingGpuWrites.cpp
@@ -35,6 +35,11 @@ void PendingGpuWrites::Add(uint64_t address, uint64_t size, uint64_t tick) {
 }
 
 void PendingGpuWrites::Expire(uint64_t done_tick) {
+	// Asked at every resource-table read and guest wait, mostly with the same tick: a scan only when it moved.
+	if (done_tick == m_expired_tick) {
+		return;
+	}
+	m_expired_tick = done_tick;
 	std::erase_if(m_ranges, [done_tick](const Range& range) { return range.tick <= done_tick; });
 }
 
diff --git a/src/graphics/host_gpu/renderer/cache/pendingGpuWrites.h b/src/graphics/host_gpu/renderer/cache/pendingGpuWrites.h
index 72e35807..fab61802 100644
--- a/src/graphics/host_gpu/renderer/cache/pendingGpuWrites.h
+++ b/src/graphics/host_gpu/renderer/cache/pendingGpuWrites.h
@@ -34,6 +34,8 @@ private:
 	[[nodiscard]] std::vector<Range>::const_iterator FirstEndingAfter(uint64_t address) const noexcept;
 
 	std::vector<Range> m_ranges;
+	// The GPU tick of the last expiry: ranges added since carry later ticks, so the same tick finds nothing.
+	uint64_t           m_expired_tick = 0;
 };
 
 } // namespace Libs::Graphics
