From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artyom Zabroda <52329369+ArtyomZabroda@users.noreply.github.com>
Date: Sat, 7 Nov 2026 08:29:59 +0300
Subject: [PATCH] graphics: optimize TrackingSpinLock with TTAS and cached
 thread ID (cp2077) (#2138)

* graphics: optimize TrackingSpinLock with TTAS and cached thread ID

* graphics: reduce the TrackingSpinLock change to an inner read-wait loop

---------

(cherry picked from commit b9cb08d3dbcb44b1ef938b985c35ea4f21d98fbc)
---
 src/graphics/host_gpu/regionManager.h | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/graphics/host_gpu/regionManager.h b/src/graphics/host_gpu/regionManager.h
index dfd5ea50..6e924eb3 100644
--- a/src/graphics/host_gpu/regionManager.h
+++ b/src/graphics/host_gpu/regionManager.h
@@ -33,13 +33,16 @@ public:
 		const auto thread = CurrentThread();
 		while (m_lock.test_and_set(std::memory_order_acquire)) {
 			EXIT_NOT_IMPLEMENTED(m_owner.load(std::memory_order_relaxed) == thread);
+			// Wait on reads, so the holder's cache line is not written until the lock is free.
+			while (m_lock.test(std::memory_order_relaxed)) {
 #if defined(__x86_64__) || defined(_M_X64)
-			_mm_pause();
+				_mm_pause();
 #elif defined(_M_ARM64)
-			__yield();
+				__yield();
 #elif defined(__aarch64__)
-			asm volatile("yield");
+				asm volatile("yield");
 #endif
+			}
 		}
 		m_owner.store(thread, std::memory_order_relaxed);
 	}
