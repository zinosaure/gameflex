From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Gino D." <25200363+zinosaure@users.noreply.github.com>
Date: Tue, 10 Nov 2026 01:49:40 +0000
Subject: [PATCH] gameflex 0087: a read after a read takes no barrier; a
 read-only depth attachment stores nothing

Image::GetBarriers issued a barrier whenever the access mask changed, even from one read to another in the
same layout, and every barrier waited for all graphics and compute work. In Astro Bot's garden, a depth
buffer the game only reads, bound as a read-only depth attachment and sampled as a texture in turn, took
~560 such barriers per frame and ended the render pass ~350 times (counted with a CPU-only probe). The
depth attachment also declared a write in a read-only layout, since its store op was always STORE.

- A read-only aspect of a depth/stencil attachment stores nothing (store op NONE, Vulkan 1.3), so binding it
  is a read (DepthAttachmentWritableAspects).
- A barrier into a read-only access makes the last write visible to every read (memory read) in its
  stages; the image state remembers those stages (VulkanImageState::read_stages), and a later read in the
  same layout and in those stages takes no barrier, its access gathered into the state.
- Resident image heaps are told when an image leaves the read state whose accesses include the shader read
  (reads now gather there), not only when they are exactly the shader read.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/graphics/host_gpu/graphicContext.h        |  3 +
 src/graphics/host_gpu/renderer/context.cpp    |  8 ++-
 .../host_gpu/renderer/depthRenderTarget.h     | 19 +++++++
 .../host_gpu/renderer/image/image.cpp         | 55 +++++++++++++++++--
 src/graphics/host_gpu/renderer/renderDraw.cpp |  7 ++-
 5 files changed, 82 insertions(+), 10 deletions(-)

diff --git a/src/graphics/host_gpu/graphicContext.h b/src/graphics/host_gpu/graphicContext.h
index c495e9aa..e171726e 100644
--- a/src/graphics/host_gpu/graphicContext.h
+++ b/src/graphics/host_gpu/graphicContext.h
@@ -151,6 +151,9 @@ struct VulkanImageState {
 	vk::PipelineStageFlags2 pl_stage    = vk::PipelineStageFlagBits2::eAllCommands;
 	vk::AccessFlags2        access_mask = vk::AccessFlagBits2::eNone;
 	vk::ImageLayout         layout      = vk::ImageLayout::eUndefined;
+	// GameFlex: the stages in which any read sees the last write, without a barrier: set by a barrier into a
+	// read-only access, which makes the write visible to every read there. None after a barrier into a write.
+	vk::PipelineStageFlags2 read_stages {};
 };
 
 struct VulkanImage {
diff --git a/src/graphics/host_gpu/renderer/context.cpp b/src/graphics/host_gpu/renderer/context.cpp
index f0f2a310..c27fe5b2 100644
--- a/src/graphics/host_gpu/renderer/context.cpp
+++ b/src/graphics/host_gpu/renderer/context.cpp
@@ -63,7 +63,10 @@ void CommandBuffer::BeginRendering(const RenderState& state) const {
 	depth.imageLayout = depth_stencil.image_layout;
 	depth.loadOp =
 	    depth_stencil.depth_clear ? vk::AttachmentLoadOp::eClear : vk::AttachmentLoadOp::eLoad;
-	depth.storeOp                       = vk::AttachmentStoreOp::eStore;
+	// A read-only aspect stores nothing: binding it stays a read, which needs no barrier after another read.
+	const auto writable = DepthAttachmentWritableAspects(depth_stencil.image_layout);
+	depth.storeOp = (writable & vk::ImageAspectFlagBits::eDepth) ? vk::AttachmentStoreOp::eStore
+	                                                              : vk::AttachmentStoreOp::eNone;
 	depth.clearValue.depthStencil.depth = std::bit_cast<float>(depth_stencil.clear_value[0]);
 
 	vk::RenderingAttachmentInfo stencil {};
@@ -71,7 +74,8 @@ void CommandBuffer::BeginRendering(const RenderState& state) const {
 	stencil.imageLayout = depth_stencil.image_layout;
 	stencil.loadOp =
 	    depth_stencil.stencil_clear ? vk::AttachmentLoadOp::eClear : vk::AttachmentLoadOp::eLoad;
-	stencil.storeOp                         = vk::AttachmentStoreOp::eStore;
+	stencil.storeOp = (writable & vk::ImageAspectFlagBits::eStencil) ? vk::AttachmentStoreOp::eStore
+	                                                                  : vk::AttachmentStoreOp::eNone;
 	stencil.clearValue.depthStencil.stencil = depth_stencil.clear_value[1];
 
 	vk::RenderingInfo rendering {};
diff --git a/src/graphics/host_gpu/renderer/depthRenderTarget.h b/src/graphics/host_gpu/renderer/depthRenderTarget.h
index 133d7c95..9766bd48 100644
--- a/src/graphics/host_gpu/renderer/depthRenderTarget.h
+++ b/src/graphics/host_gpu/renderer/depthRenderTarget.h
@@ -61,6 +61,25 @@ inline vk::ImageAspectFlags DepthReadableAspects(vk::ImageLayout layout) {
 	}
 }
 
+// GameFlex: the aspects an attachment in this layout can write. A read-only aspect stores nothing (store op
+// none), so binding it is a read.
+inline vk::ImageAspectFlags DepthAttachmentWritableAspects(vk::ImageLayout layout) {
+	switch (layout) {
+		case vk::ImageLayout::eDepthAttachmentOptimal:
+		case vk::ImageLayout::eDepthAttachmentStencilReadOnlyOptimal:
+			return vk::ImageAspectFlagBits::eDepth;
+		case vk::ImageLayout::eStencilAttachmentOptimal:
+		case vk::ImageLayout::eDepthReadOnlyStencilAttachmentOptimal:
+			return vk::ImageAspectFlagBits::eStencil;
+		case vk::ImageLayout::eDepthStencilAttachmentOptimal:
+		case vk::ImageLayout::eAttachmentFeedbackLoopOptimalEXT:
+		case vk::ImageLayout::eGeneral:
+			return vk::ImageAspectFlagBits::eDepth | vk::ImageAspectFlagBits::eStencil;
+		default:
+			return {};
+	}
+}
+
 inline vk::ImageLayout depth_attachment_layout(const RenderDepthInfo& depth) {
 	const auto available     = ImageViewOps::DepthAspectMask(depth.desc.view_info.format);
 	const auto writes        = depth.AttachmentWriteAspects();
diff --git a/src/graphics/host_gpu/renderer/image/image.cpp b/src/graphics/host_gpu/renderer/image/image.cpp
index 80a85111..059a524c 100644
--- a/src/graphics/host_gpu/renderer/image/image.cpp
+++ b/src/graphics/host_gpu/renderer/image/image.cpp
@@ -121,6 +121,38 @@ vk::ImageAspectFlags Image::FullAspectMask(vk::Format format) noexcept {
 	}
 }
 
+namespace {
+
+// GameFlex: every access that writes. A read after a read, in the same layout, needs no barrier.
+constexpr vk::AccessFlags2 WriteAccesses =
+    vk::AccessFlagBits2::eShaderWrite | vk::AccessFlagBits2::eShaderStorageWrite |
+    vk::AccessFlagBits2::eColorAttachmentWrite | vk::AccessFlagBits2::eDepthStencilAttachmentWrite |
+    vk::AccessFlagBits2::eTransferWrite | vk::AccessFlagBits2::eHostWrite |
+    vk::AccessFlagBits2::eMemoryWrite | vk::AccessFlagBits2::eAccelerationStructureWriteKHR;
+
+[[nodiscard]] bool ReadsOnly(vk::AccessFlags2 access) {
+	return !(access & WriteAccesses);
+}
+
+// A read in a layout the image is already in, in stages a barrier has made every read safe in.
+[[nodiscard]] bool ReadNeedsNoBarrier(const VulkanImageState& state, vk::ImageLayout layout,
+                                      vk::AccessFlags2 access, vk::PipelineStageFlags2 stage) {
+	return state.layout == layout && ReadsOnly(access) && state.read_stages &&
+	       !(stage & ~state.read_stages);
+}
+
+// A barrier into a read makes the write visible to every read, so that another read later needs none.
+[[nodiscard]] vk::AccessFlags2 BarrierDestinationAccess(vk::AccessFlags2 access) {
+	return ReadsOnly(access) ? access | vk::AccessFlagBits2::eMemoryRead : access;
+}
+
+[[nodiscard]] VulkanImageState StateAfterBarrier(vk::PipelineStageFlags2 stage, vk::AccessFlags2 access,
+                                                 vk::ImageLayout layout) {
+	return {stage, access, layout, ReadsOnly(access) ? stage : vk::PipelineStageFlags2 {}};
+}
+
+} // namespace
+
 Image::Barriers Image::GetBarriers(vk::ImageLayout                      destination_layout,
                                    vk::AccessFlags2                     destination_access,
                                    vk::PipelineStageFlags2              destination_stage,
@@ -156,11 +188,16 @@ Image::Barriers Image::GetBarriers(vk::ImageLayout                      destinat
 				// Two writes in a row take no barrier: the game orders them when it needs to (GuestSync).
 				if (subresource_state.layout != destination_layout ||
 				    subresource_state.access_mask != destination_access) {
+					if (ReadNeedsNoBarrier(subresource_state, destination_layout, destination_access,
+					                       destination_stage)) {
+						subresource_state.access_mask |= destination_access;
+						continue;
+					}
 					vk::ImageMemoryBarrier2 barrier {};
 					barrier.srcStageMask                    = subresource_state.pl_stage;
 					barrier.srcAccessMask                   = subresource_state.access_mask;
 					barrier.dstStageMask                    = destination_stage;
-					barrier.dstAccessMask                   = destination_access;
+					barrier.dstAccessMask                   = BarrierDestinationAccess(destination_access);
 					barrier.oldLayout                       = subresource_state.layout;
 					barrier.newLayout                       = destination_layout;
 					barrier.srcQueueFamilyIndex             = VK_QUEUE_FAMILY_IGNORED;
@@ -172,7 +209,7 @@ Image::Barriers Image::GetBarriers(vk::ImageLayout                      destinat
 					barrier.subresourceRange.baseArrayLayer = layer;
 					barrier.subresourceRange.layerCount     = 1;
 					barriers.push_back(barrier);
-					subresource_state = {destination_stage, destination_access, destination_layout};
+					subresource_state = StateAfterBarrier(destination_stage, destination_access, destination_layout);
 				}
 			}
 		}
@@ -184,12 +221,16 @@ Image::Barriers Image::GetBarriers(vk::ImageLayout                      destinat
 		if (state.layout == destination_layout && state.access_mask == destination_access) {
 			return {};
 		}
+		if (ReadNeedsNoBarrier(state, destination_layout, destination_access, destination_stage)) {
+			state.access_mask |= destination_access;
+			return {};
+		}
 
 		vk::ImageMemoryBarrier2 barrier {};
 		barrier.srcStageMask                    = state.pl_stage;
 		barrier.srcAccessMask                   = state.access_mask;
 		barrier.dstStageMask                    = destination_stage;
-		barrier.dstAccessMask                   = destination_access;
+		barrier.dstAccessMask                   = BarrierDestinationAccess(destination_access);
 		barrier.oldLayout                       = state.layout;
 		barrier.newLayout                       = destination_layout;
 		barrier.srcQueueFamilyIndex             = VK_QUEUE_FAMILY_IGNORED;
@@ -203,14 +244,16 @@ Image::Barriers Image::GetBarriers(vk::ImageLayout                      destinat
 		barriers.push_back(barrier);
 	}
 
-	// Resident heaps sample their images in the read state; only leaving it invalidates them.
+	// Resident heaps sample their images in the read state; only leaving it invalidates them. Reads
+	// gather in that state (ReadNeedsNoBarrier), so the shader read is one of its accesses.
 	if (std::ranges::any_of(barriers, [&](const vk::ImageMemoryBarrier2& barrier) {
 		    return barrier.oldLayout == ReadLayout() &&
-		           barrier.srcAccessMask == vk::AccessFlagBits2::eShaderRead;
+		           ReadsOnly(barrier.srcAccessMask) &&
+		           static_cast<bool>(barrier.srcAccessMask & vk::AccessFlagBits2::eShaderRead);
 	    })) {
 		HeapChanged();
 	}
-	state = {destination_stage, destination_access, destination_layout};
+	state = StateAfterBarrier(destination_stage, destination_access, destination_layout);
 	return barriers;
 }
 
diff --git a/src/graphics/host_gpu/renderer/renderDraw.cpp b/src/graphics/host_gpu/renderer/renderDraw.cpp
index 787d70ec..93b1ae56 100644
--- a/src/graphics/host_gpu/renderer/renderDraw.cpp
+++ b/src/graphics/host_gpu/renderer/renderDraw.cpp
@@ -523,9 +523,12 @@ RenderState RenderExecutor::AcquireRenderTargets(CommandBuffer& buffer, RenderCo
 			             ? vk::ImageLayout::eAttachmentFeedbackLoopOptimalEXT
 			             : vk::ImageLayout::eGeneral;
 		}
-		// The attachment store writes even when guest depth/stencil tests do not.
+		// The attachment stores (writes) the aspects its layout lets it write; a read-only one stores
+		// nothing (CommandBuffer::BeginRendering), so binding it is a read.
 		const auto access = vk::AccessFlagBits2::eDepthStencilAttachmentRead |
-		                    vk::AccessFlagBits2::eDepthStencilAttachmentWrite;
+		                    (DepthAttachmentWritableAspects(layout)
+		                         ? vk::AccessFlagBits2::eDepthStencilAttachmentWrite
+		                         : vk::AccessFlags2 {});
 		image.binding.attachment_layout = layout;
 		image.binding.attachment_access = access;
 		const auto& view                = depth.desc.view_info;
