diff --git a/src/graphics/host_gpu/renderer/cache/pendingGpuWrites.cpp b/src/graphics/host_gpu/renderer/cache/pendingGpuWrites.cpp
new file mode 100644
index 00000000..7e8bcd43
--- /dev/null
+++ b/src/graphics/host_gpu/renderer/cache/pendingGpuWrites.cpp
@@ -0,0 +1,62 @@
+#include "graphics/host_gpu/renderer/cache/pendingGpuWrites.h"
+
+#include <algorithm>
+
+namespace Libs::Graphics {
+
+std::vector<PendingGpuWrites::Range>::const_iterator
+PendingGpuWrites::FirstEndingAfter(uint64_t address) const noexcept {
+	// Disjoint and sorted by start, the ranges are sorted by end as well.
+	return std::upper_bound(m_ranges.begin(), m_ranges.end(), address,
+	                        [](uint64_t value, const Range& range) { return value < range.end; });
+}
+
+void PendingGpuWrites::Add(uint64_t address, uint64_t size, uint64_t tick) {
+	if (size == 0) {
+		return;
+	}
+	const uint64_t end = address + size;
+	// The first range that ends at or after the new one starts: it touches or overlaps it, or comes after.
+	auto first = std::lower_bound(m_ranges.begin(), m_ranges.end(), address,
+	                              [](const Range& range, uint64_t value) { return range.end < value; });
+	if (first == m_ranges.end() || first->start > end) {
+		m_ranges.insert(first, {address, end, tick});
+		return;
+	}
+	Range merged {std::min(first->start, address), std::max(first->end, end), std::max(first->tick, tick)};
+	auto  last = first + 1;
+	while (last != m_ranges.end() && last->start <= merged.end) {
+		merged.end  = std::max(merged.end, last->end);
+		merged.tick = std::max(merged.tick, last->tick);
+		++last;
+	}
+	*first = merged;
+	m_ranges.erase(first + 1, last);
+}
+
+void PendingGpuWrites::Expire(uint64_t done_tick) {
+	std::erase_if(m_ranges, [done_tick](const Range& range) { return range.tick <= done_tick; });
+}
+
+const PendingGpuWrites::Range* PendingGpuWrites::Find(uint64_t address) const noexcept {
+	const auto it = FirstEndingAfter(address);
+	return it != m_ranges.end() && it->start <= address ? &*it : nullptr;
+}
+
+bool PendingGpuWrites::Intersects(uint64_t address, uint64_t size) const noexcept {
+	if (size == 0) {
+		return false;
+	}
+	const auto it = FirstEndingAfter(address);
+	return it != m_ranges.end() && it->start < address + size;
+}
+
+uint64_t PendingGpuWrites::Bytes(uint64_t address, uint64_t size) const noexcept {
+	uint64_t bytes = 0;
+	for (auto it = FirstEndingAfter(address); it != m_ranges.end() && it->start < address + size; ++it) {
+		bytes += std::min(it->end, address + size) - std::max(it->start, address);
+	}
+	return bytes;
+}
+
+} // namespace Libs::Graphics
diff --git a/src/graphics/host_gpu/renderer/cache/pendingGpuWrites.h b/src/graphics/host_gpu/renderer/cache/pendingGpuWrites.h
new file mode 100644
index 00000000..72e35807
--- /dev/null
+++ b/src/graphics/host_gpu/renderer/cache/pendingGpuWrites.h
@@ -0,0 +1,41 @@
+#ifndef EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_CACHE_PENDINGGPUWRITES_H_
+#define EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_CACHE_PENDINGGPUWRITES_H_
+
+#include <cstdint>
+#include <vector>
+
+namespace Libs::Graphics {
+
+// The guest ranges the GPU may still be writing: bound for writing in a command buffer the GPU has not finished.
+// Sorted by address, disjoint (overlapping and touching ranges merge), each with the tick of the last buffer
+// that writes it. Every read of a shader's table of resources asks whether its word lies in one: a binary search,
+// where a std::map scanned from the first range in reach cost 7 % of the command thread in Astro Bot.
+class PendingGpuWrites {
+public:
+	struct Range {
+		uint64_t start;
+		uint64_t end;  // one past the last byte
+		uint64_t tick; // the command buffer that writes it last
+	};
+
+	void Add(uint64_t address, uint64_t size, uint64_t tick);
+	// Forgets the ranges whose last writer the GPU has finished.
+	void Expire(uint64_t done_tick);
+	void Clear() noexcept { m_ranges.clear(); }
+
+	[[nodiscard]] bool         Empty() const noexcept { return m_ranges.empty(); }
+	[[nodiscard]] const Range* Find(uint64_t address) const noexcept;
+	[[nodiscard]] bool         Intersects(uint64_t address, uint64_t size) const noexcept;
+	// How many bytes of [address, address + size) the ranges cover.
+	[[nodiscard]] uint64_t     Bytes(uint64_t address, uint64_t size) const noexcept;
+
+private:
+	// The first range that ends after `address`.
+	[[nodiscard]] std::vector<Range>::const_iterator FirstEndingAfter(uint64_t address) const noexcept;
+
+	std::vector<Range> m_ranges;
+};
+
+} // namespace Libs::Graphics
+
+#endif // EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_CACHE_PENDINGGPUWRITES_H_
