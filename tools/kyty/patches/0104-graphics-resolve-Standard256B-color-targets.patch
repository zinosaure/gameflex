From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nmzik <Nmzik@mail.ru>
Date: Sat, 7 Nov 2026 11:30:25 +0100
Subject: [PATCH] graphics: resolve Standard256B color targets

(cherry picked from commit a79c9993839c959e148fc84e31c3f6c1050decbd)
---
 .../host_gpu/renderer/colorRenderTarget.cpp   | 29 +++++++------------
 tests/ShaderRecompilerComputeTests.cpp        | 11 +++----
 2 files changed, 16 insertions(+), 24 deletions(-)

diff --git a/src/graphics/host_gpu/renderer/colorRenderTarget.cpp b/src/graphics/host_gpu/renderer/colorRenderTarget.cpp
index 2b61c49c..56c1f70d 100644
--- a/src/graphics/host_gpu/renderer/colorRenderTarget.cpp
+++ b/src/graphics/host_gpu/renderer/colorRenderTarget.cpp
@@ -140,26 +140,17 @@ void RenderExecutor::ResolveRenderColorTarget(CommandBuffer& buffer, RenderColor
 		}
 	}
 
-	// Color-control state selects the color-buffer operation and logical blend operation.
-	// The normal copy operation is a regular color write, not an attachment clear.
-	// Nonlinear clear values are still stored as normalized components.
-	// Metadata clears are materialized during image discovery; render-pass loads preserve contents.
-	uint32_t   width  = 0;
-	uint32_t       height       = 0;
-	bool       tile   = false;
-	const bool     standard4    = rt.attrib3.tile_mode == Prospero::TileMode::kStandard4KB;
-	const bool     standard64   = rt.attrib3.tile_mode == Prospero::TileMode::kStandard64KB;
-	const bool     depth_tile   = rt.attrib3.tile_mode == Prospero::TileMode::kDepth;
-	const bool     texture_tile = standard4 || standard64 || depth_tile;
-
+	const bool tile         = rt.attrib3.tile_mode != Prospero::TileMode::kLinear;
+	const bool standard64   = rt.attrib3.tile_mode == Prospero::TileMode::kStandard64KB;
+	const bool depth_tile   = rt.attrib3.tile_mode == Prospero::TileMode::kDepth;
+	bool       texture_tile = false;
 	switch (rt.attrib3.tile_mode) {
-		case Prospero::TileMode::kLinear:
+		case Prospero::TileMode::kStandard256B:
 		case Prospero::TileMode::kStandard4KB:
 		case Prospero::TileMode::kStandard64KB:
-		case Prospero::TileMode::kDepth:
-		case Prospero::TileMode::kRenderTarget:
-			tile = rt.attrib3.tile_mode != Prospero::TileMode::kLinear;
-			break;
+		case Prospero::TileMode::kDepth: texture_tile = true; break;
+		case Prospero::TileMode::kLinear:
+		case Prospero::TileMode::kRenderTarget: break;
 		default: EXIT("unknown tile mode: %u\n", static_cast<uint32_t>(rt.attrib3.tile_mode));
 	}
 	if (samples > 1 && (!tile || levels != 1)) {
@@ -172,8 +163,8 @@ void RenderExecutor::ResolveRenderColorTarget(CommandBuffer& buffer, RenderColor
 		EXIT("linear 3D render targets are unsupported\n");
 	}
 
-	width  = rt.attrib2.width + 1;
-	height = rt.attrib2.height + 1;
+	const uint32_t width  = rt.attrib2.width + 1;
+	const uint32_t height = rt.attrib2.height + 1;
 	const auto target_format =
 	    TextureGetRenderTargetFormat(rt.info.format, rt.info.channel_type, rt.info.channel_order);
 	// A surface with one stored level starts every MIP_LEVEL at the base address, so a level with
diff --git a/tests/ShaderRecompilerComputeTests.cpp b/tests/ShaderRecompilerComputeTests.cpp
index f4ed8420..ce14c714 100644
--- a/tests/ShaderRecompilerComputeTests.cpp
+++ b/tests/ShaderRecompilerComputeTests.cpp
@@ -14996,6 +14996,7 @@ public:
       uint64_t alignment;
     };
     constexpr std::array cases{
+        TileCase{Prospero::TileMode::kStandard256B, 0x100, 0x100},
         TileCase{Prospero::TileMode::kStandard4KB, 0x4000, 0x1000},
         TileCase{Prospero::TileMode::kStandard64KB, 0x10000, 0x10000},
     };
@@ -55867,6 +55868,11 @@ int main(int argc, char **argv) {
     RunCase(&vulkan, VectorReadlaneSelectsTwoKeysWithinWave());
     return 0;
   }
+  if (argc == 2 && std::strcmp(argv[1], "--standard-tile-rt-only") == 0) {
+    VulkanHarness vulkan;
+    vulkan.CheckRenderExecutorColorStandardTileDiscovery();
+    return 0;
+  }
   if (argc == 2 && std::strcmp(argv[1], "--rt1d-only") == 0) {
     VulkanHarness vulkan;
     vulkan.CheckRenderExecutorColorDiscovery();
@@ -55895,11 +55901,6 @@ int main(int argc, char **argv) {
     CheckStandard64RenderTargetTileRoundTrip();
     return 0;
   }
-  if (argc == 2 && std::strcmp(argv[1], "--standard-tile-rt-only") == 0) {
-    VulkanHarness vulkan;
-    vulkan.CheckRenderExecutorColorStandardTileDiscovery();
-    return 0;
-  }
   if (argc == 2 && std::strcmp(argv[1], "--image-view-only") == 0) {
     VulkanHarness vulkan;
     CheckSampledColorViews();
