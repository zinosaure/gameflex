From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Gino D." <25200363+zinosaure@users.noreply.github.com>
Date: Sun, 8 Nov 2026 21:49:25 +0000
Subject: [PATCH] gameflex 0016: shader cache from environment
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

le cache de shaders, par l'environnement et marqué de la révision de Kyty

Détail : tools/kyty/README.md du dépôt GameFlex, entrée 0016.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../host_gpu/renderer/pipeline/pipelineSerialization.cpp    | 6 +++++-
 src/main.cpp                                                | 4 ++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/graphics/host_gpu/renderer/pipeline/pipelineSerialization.cpp b/src/graphics/host_gpu/renderer/pipeline/pipelineSerialization.cpp
index d3478c47..0614429e 100644
--- a/src/graphics/host_gpu/renderer/pipeline/pipelineSerialization.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/pipelineSerialization.cpp
@@ -6,6 +6,7 @@
 #include "graphics/host_gpu/vulkanCommon.h"
 #include "graphics/shader/recompiler/ShaderRecompiler.h"
 #include "graphics/shader/recompiler/ir/Serialize.h"
+#include "kytyGitVersion.h"
 
 #include <algorithm>
 #include <chrono>
@@ -67,8 +68,11 @@ std::vector<uint8_t> StoreHeader(const GraphicContext& graphics) {
 	if (stamp == 0) {
 		return {};
 	}
+	// The Kyty revision as well: under Box64, /proc/self/exe is Box64 itself, whose date stays the
+	// same when Kyty changes - a store written by another Kyty would pass for this one's.
+	const uint64_t revision = XXH3_64bits(KYTY_GIT_REVISION, sizeof(KYTY_GIT_REVISION) - 1);
 	Writer header;
-	IoAll(header, stamp, SpirvProfile(graphics),
+	IoAll(header, stamp, revision, SpirvProfile(graphics),
 	      graphics.GetPhysicalDeviceProperties().limits.maxComputeSharedMemorySize);
 	return std::move(header.bytes);
 }
diff --git a/src/main.cpp b/src/main.cpp
index 5f1751f0..b2d6a7eb 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -237,6 +237,10 @@ static bool ParseArgs(int argc, char* argv[], RunOptions& options, bool& show_he
 	if (const char* occlusion = std::getenv("KYTY_OCCLUSION_QUERIES"); occlusion != nullptr) {
 		options.config.occlusion_queries_enabled = std::string_view(occlusion) != "0";
 	}
+	// KYTY_SHADER_CACHE=1 (0 to disable) sets --shader-cache the same way.
+	if (const char* shader_cache = std::getenv("KYTY_SHADER_CACHE"); shader_cache != nullptr) {
+		options.config.shader_cache_enabled = std::string_view(shader_cache) != "0";
+	}
 
 	for (int i = 1; i < argc; i++) {
 		std::string arg = std::string(argv[i]);
