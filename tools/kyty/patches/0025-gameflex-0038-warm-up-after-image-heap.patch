From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Gino D." <25200363+zinosaure@users.noreply.github.com>
Date: Sun, 8 Nov 2026 21:49:26 +0000
Subject: [PATCH] gameflex 0038: warm up after image heap
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

le cache de shaders se relit une fois le tas d'images créé

Détail : tools/kyty/README.md du dépôt GameFlex, entrée 0038.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/generate_version.cmake                                | 5 +++--
 src/graphics/host_gpu/renderer/pipeline/pipelineCache.cpp | 4 +---
 src/graphics/host_gpu/renderer/pipeline/pipelineCache.h   | 8 ++++----
 src/graphics/host_gpu/renderer/renderContext.cpp          | 3 ++-
 4 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/src/generate_version.cmake b/src/generate_version.cmake
index 329ed782..89c89339 100644
--- a/src/generate_version.cmake
+++ b/src/generate_version.cmake
@@ -56,9 +56,10 @@ if(GRAPHICS_SOURCE_DIR)
 		string(SHA256 KYTY_SHADER_STORE_STAMP "${store_digests}")
 	endif()
 endif()
-# GameFlex: 0034 only translates what used to stop Kyty, so the records stored before it stay valid.
+# GameFlex: 0034 only translates what used to stop Kyty, and 0038 only moves when the store is read,
+# so the records stored before them stay valid.
 # Any other change to these sources gives another stamp, and a new store.
-if(KYTY_SHADER_STORE_STAMP STREQUAL "bf9f6220764c26d849fdc7e2b13e9eea5492ca0bccb658855448164ac6d215be")
+if(KYTY_SHADER_STORE_STAMP STREQUAL "58af55fba97c6709ae1c05a25943a503c1fe2bec899d2f11ba69c593a259f71c")
 	set(KYTY_SHADER_STORE_STAMP "1a2216d3d966cf7b1b6e8ec85cd3a0a1a0f2115d9453cbf36d9a6c909aa85b7d")
 endif()
 configure_file("${INPUT_FILE}" "${OUTPUT_FILE}")
diff --git a/src/graphics/host_gpu/renderer/pipeline/pipelineCache.cpp b/src/graphics/host_gpu/renderer/pipeline/pipelineCache.cpp
index a3caf50f..8aa92351 100644
--- a/src/graphics/host_gpu/renderer/pipeline/pipelineCache.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/pipelineCache.cpp
@@ -395,13 +395,11 @@ const ShaderModule* PipelineCache::GetProgram(const ShaderParams& params, InputI
 }
 
 PipelineCache::PipelineCache(GraphicContext&                         graphics,
-                             ShaderRecompiler::IR::ImageHeapSource* image_heap,
-                             const std::filesystem::path&           shader_store)
+                             ShaderRecompiler::IR::ImageHeapSource* image_heap)
     : m_graphics(graphics), m_image_heap(image_heap),
       m_next_driver_cache_save(std::chrono::steady_clock::now() + DriverCacheSaveInterval) {
 	EXIT_NOT_IMPLEMENTED(!Common::Thread::IsMainThread());
 	InitializeDriverCache();
-	WarmUp(shader_store);
 }
 
 PipelineCache::~PipelineCache() {
diff --git a/src/graphics/host_gpu/renderer/pipeline/pipelineCache.h b/src/graphics/host_gpu/renderer/pipeline/pipelineCache.h
index 4e79a378..f126f65c 100644
--- a/src/graphics/host_gpu/renderer/pipeline/pipelineCache.h
+++ b/src/graphics/host_gpu/renderer/pipeline/pipelineCache.h
@@ -179,9 +179,10 @@ private:
 // The owning renderer serializes access, including saves while the GPU is running.
 class PipelineCache {
 public:
-	// Without a shader store path nothing is kept across runs.
-	PipelineCache(GraphicContext& graphics, ShaderRecompiler::IR::ImageHeapSource* image_heap,
-	              const std::filesystem::path& shader_store = {});
+	PipelineCache(GraphicContext& graphics, ShaderRecompiler::IR::ImageHeapSource* image_heap);
+	// Without a shader store path nothing is kept across runs. Once the image heap exists: a
+	// pipeline that samples it needs its descriptor set layout (RenderContext).
+	void WarmUp(const std::filesystem::path& path);
 	~PipelineCache();
 	KYTY_CLASS_NO_COPY(PipelineCache);
 	// Finishes the queued writes and stops the store thread, then writes the driver cache if it
@@ -275,7 +276,6 @@ private:
 	void WriteDriverCache() const;
 
 	// pipelineSerialization.cpp
-	void WarmUp(const std::filesystem::path& path);
 	bool LoadRecord(std::span<const uint8_t>& records);
 	void StoreModule(const ProgramKey& key, const Program& program, const ShaderModule& module,
 	                 const std::vector<uint32_t>& spirv);
diff --git a/src/graphics/host_gpu/renderer/renderContext.cpp b/src/graphics/host_gpu/renderer/renderContext.cpp
index da814508..8c63c9b5 100644
--- a/src/graphics/host_gpu/renderer/renderContext.cpp
+++ b/src/graphics/host_gpu/renderer/renderContext.cpp
@@ -13,7 +13,7 @@ namespace Libs::Graphics {
 RenderContext::RenderContext(GraphicContext& graphics, const std::filesystem::path& shader_store)
     : m_graphics(graphics), m_render_executor(*this), m_command_scheduler(*this, graphics),
       m_descriptor_heap(graphics, m_command_scheduler.GetMasterSemaphore()),
-      m_pipeline_cache(graphics, &m_image_heap, shader_store), m_sampler_cache(graphics),
+      m_pipeline_cache(graphics, &m_image_heap), m_sampler_cache(graphics),
       m_buffer_cache(graphics, m_command_scheduler, m_page_manager, m_texture_cache),
       m_texture_cache(graphics, m_command_scheduler, m_page_manager, m_buffer_cache),
       m_image_heap(*this, m_page_manager), m_occlusion_queries(graphics, m_command_scheduler) {
@@ -21,6 +21,7 @@ RenderContext::RenderContext(GraphicContext& graphics, const std::filesystem::pa
 	if (graphics.ray_query_enabled) {
 		m_ray_tracing = std::make_unique<RayTracing>(*this);
 	}
+	m_pipeline_cache.WarmUp(shader_store);
 }
 
 RenderContext::~RenderContext() {
