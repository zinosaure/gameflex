From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nmzik <Nmzik@mail.ru>
Date: Sat, 7 Nov 2026 19:40:58 +0100
Subject: [PATCH] graphics: rebase texture views that lie entirely past MAX_MIP

(cherry picked from commit bd41e2f6cab4987670d6ba3a43a0394f701753ef)
---
 .../renderer/pipeline/descriptors.cpp         |  9 ++++++-
 tests/ShaderRecompilerComputeTests.cpp        | 24 +++++++++++++++++++
 2 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp b/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp
index 13151458..5304146e 100644
--- a/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/descriptors.cpp
@@ -424,7 +424,14 @@ static bool ResolveTextureMipView(ImageInfo& info, uint32_t physical_levels, boo
 	if (!info.IsTiled()) {
 		return false;
 	}
-	ImageInfo physical        = info;
+	ImageInfo physical = info;
+	// A view entirely past MAX_MIP addresses its own chain starting at its base mip (PPSA02110
+	// compresses mip 1 through a T# that declares one level).
+	if (base_level >= physical_levels) {
+		const auto mip  = info.MipExtent(base_level);
+		physical.extent = {mip.width, mip.height, info.IsVolume() ? mip.depth : 1u};
+		physical_levels = view_levels;
+	}
 	physical.resources.levels = physical_levels;
 	physical.UpdateSize();
 	info.UpdateSize();
diff --git a/tests/ShaderRecompilerComputeTests.cpp b/tests/ShaderRecompilerComputeTests.cpp
index d302e93a..6d0ba949 100644
--- a/tests/ShaderRecompilerComputeTests.cpp
+++ b/tests/ShaderRecompilerComputeTests.cpp
@@ -15921,6 +15921,30 @@ public:
                     std::vector<uint32_t>{1, 1},
                 "query/store did not access the standalone 1x1 mip");
       }
+      {
+        // No Man's Sky compresses mip 1 through a T# that declares one level.
+        constexpr uint64_t address = base + 0x400000;
+        ShaderRecompiler::IR::DescriptorValue descriptor{};
+        descriptor.dwords = {static_cast<uint32_t>(address >> 8u),
+                             0xc3e00000u, 0x003fc03fu, 0xd051102cu, 0, 0x00700000u, 0, 0};
+        descriptor.dword_count = 8;
+        const auto store =
+            RenderExecutorTestAccess::ResolveTexture(executor, storage_resource, descriptor);
+        Require(name, "mip view past MAX_MIP",
+                store.desc.info.extent.width == 128 &&
+                    store.desc.info.extent.height == 128 &&
+                    store.desc.info.resources.levels == 1 &&
+                    store.desc.info.data.size == 0x20000 &&
+                    store.desc.view_info.base_level == 0,
+                "a view past MAX_MIP did not rebase to its own 128x128 chain");
+#if KYTY_PLATFORM != KYTY_PLATFORM_WINDOWS
+        ExpectFatal("TailMipViewPastMaxMip", [&] {
+          auto tail = descriptor;
+          tail.dwords[3] = 0xd054402cu;
+          (void)RenderExecutorTestAccess::ResolveTexture(executor, storage_resource, tail);
+        });
+#endif
+      }
       auto plain_mipped_storage_binding =
           RenderExecutorTestAccess::ResolveTexture(executor, storage_resource,
                                                    mipped_storage_descriptor);
