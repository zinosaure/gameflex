From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Gino D." <25200363+zinosaure@users.noreply.github.com>
Date: Sun, 8 Nov 2026 22:02:33 +0000
Subject: [PATCH] gameflex 0063: table-of-resources reads speculate on stable
 words
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The recompiler reads a shader's tables of resources on the CPU when it
records a draw or a dispatch. When a word lies in a range the GPU may still
write, Kyty submitted everything and waited for the GPU (Finish), which then
ran dry while the thread recorded what follows: in Astro Bot, 40 times an
image, 1.9 ms each, on two 32-byte counters that a compute pass rewrites
every frame to the same value, unchanged 5 196 times out of 5 218.

A word that came out of eight waits unchanged, inside a range of at most 256
bytes, is read as it is. Once the GPU work it skipped is done, the landed
value is compared with the one used; a difference revokes the word for good
and is said on the console (the first fifty).

Measured on Astro Bot in the Celestial Garden: 6.55 → 6.70 images/s.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../host_gpu/renderer/cache/bufferCache.cpp   | 73 +++++++++++++++++--
 .../host_gpu/renderer/cache/bufferCache.h     | 11 +++
 2 files changed, 79 insertions(+), 5 deletions(-)

diff --git a/src/graphics/host_gpu/renderer/cache/bufferCache.cpp b/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
index fd9a175c..f9adab60 100644
--- a/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
+++ b/src/graphics/host_gpu/renderer/cache/bufferCache.cpp
@@ -17,6 +17,7 @@
 #include <algorithm>
 #include <bit>
 #include <cinttypes>
+#include <cstdio>
 #include <cstring>
 #include <memory>
 #include <utility>
@@ -1101,12 +1102,50 @@ bool BufferCache::HasPendingGpuWrites(uint64_t vaddr, uint64_t size) {
 	return false;
 }
 
+// The recompiler reads a shader's tables of resources on the CPU when it records a draw or a dispatch. When a
+// word it reads lies in a range the GPU may still write, the only safe value is the GPU's: submit everything and
+// wait for it (Finish), which leaves the GPU dry while the thread records what follows. Games keep small counters
+// there that a compute pass rewrites every frame to the same value (Astro Bot: two 32-byte counters, 40 waits an
+// image, unchanged 5 196 times out of 5 218): once a word came out of eight waits unchanged, the read takes the
+// value in memory without waiting, and the GPU's value is checked once its work is done. A difference revokes the
+// word for good and says so on the console.
+namespace {
+constexpr uint32_t kSpeculationConfirmations = 8;
+constexpr uint64_t kSpeculationRangeBytes    = 256; // a counter, not a table the GPU fills
+} // namespace
+
+void BufferCache::VerifySrtSpeculations() {
+	const auto done = m_scheduler.GetMasterSemaphore().KnownGpuTick();
+	for (auto& [address, speculation]: m_srt_speculation) {
+		if (speculation.verify_tick == 0 || speculation.verify_tick > done) {
+			continue;
+		}
+		speculation.verify_tick = 0;
+		uint32_t landed = 0;
+		if (!LibKernel::Memory::TryReadBacking(address, &landed, sizeof(landed)) ||
+		    landed == speculation.used) {
+			continue;
+		}
+		speculation.trusted = false;
+		speculation.revoked = true;
+		static uint32_t misses = 0;
+		if (misses++ < 50) {
+			std::printf("SRT speculation: the GPU wrote 0x%08x at 0x%016" PRIx64 " after 0x%08x was used; "
+			            "this word waits again from now on\n",
+			            landed, address, speculation.used);
+		}
+	}
+}
+
 bool BufferCache::FinishPendingGpuWritesUnder(std::span<const uint64_t> addresses) {
 	if (m_pending_gpu_writes.empty()) {
 		return false;
 	}
 	const auto done = m_scheduler.GetMasterSemaphore().KnownGpuTick();
 	std::erase_if(m_pending_gpu_writes, [done](const auto& entry) { return entry.second.second <= done; });
+	if (!m_srt_speculation.empty()) {
+		VerifySrtSpeculations();
+	}
 	if (m_pending_gpu_writes.empty()) {
 		m_pending_gpu_writes_span = 0;
 		return false;
@@ -1115,12 +1154,36 @@ bool BufferCache::FinishPendingGpuWritesUnder(std::span<const uint64_t> addresse
 		const auto from = address > m_pending_gpu_writes_span ? address - m_pending_gpu_writes_span : 0;
 		const auto last = m_pending_gpu_writes.upper_bound(address + sizeof(uint32_t) - 1);
 		for (auto it = m_pending_gpu_writes.lower_bound(from); it != last; ++it) {
-			if (it->second.first > address) {
-				m_scheduler.Finish();
-				m_pending_gpu_writes.clear();
-				m_pending_gpu_writes_span = 0;
-				return true;
+			if (it->second.first <= address) {
+				continue;
 			}
+			auto& speculation = m_srt_speculation[address];
+			if (speculation.trusted) {
+				uint32_t used = 0;
+				if (LibKernel::Memory::TryReadBacking(address, &used, sizeof(used))) {
+					if (speculation.verify_tick == 0) {
+						speculation.used = used;
+					}
+					speculation.verify_tick = std::max(speculation.verify_tick, it->second.second);
+					break;
+				}
+			}
+			uint32_t before = 0;
+			LibKernel::Memory::TryReadBacking(address, &before, sizeof(before));
+			const auto range_size = it->second.first - it->first;
+			m_scheduler.Finish();
+			m_pending_gpu_writes.clear();
+			m_pending_gpu_writes_span = 0;
+			if (!speculation.revoked && range_size <= kSpeculationRangeBytes) {
+				uint32_t after = 0;
+				LibKernel::Memory::TryReadBacking(address, &after, sizeof(after));
+				if (after != before) {
+					speculation.confirmations = 0;
+				} else if (++speculation.confirmations >= kSpeculationConfirmations) {
+					speculation.trusted = true;
+				}
+			}
+			return true;
 		}
 	}
 	return false;
diff --git a/src/graphics/host_gpu/renderer/cache/bufferCache.h b/src/graphics/host_gpu/renderer/cache/bufferCache.h
index 888937f6..362df7a2 100644
--- a/src/graphics/host_gpu/renderer/cache/bufferCache.h
+++ b/src/graphics/host_gpu/renderer/cache/bufferCache.h
@@ -96,6 +96,16 @@ public:
 	[[nodiscard]] bool HasPendingGpuWrites(uint64_t vaddr, uint64_t size);
 	// As FinishPendingGpuWrites, for the 4-byte reads of the SRT walker; true when it waited.
 	bool FinishPendingGpuWritesUnder(std::span<const uint64_t> addresses);
+	// A word of a table of resources inside a range the GPU may still write, read without waiting once its value
+	// came out of eight waits unchanged; the GPU's value is compared afterwards, a difference revokes it for good.
+	struct SrtSpeculation {
+		uint32_t confirmations = 0; // consecutive waits that changed nothing
+		bool     trusted       = false;
+		bool     revoked       = false; // once wrong, never trusted again
+		uint32_t used          = 0;     // the value read without waiting
+		uint64_t verify_tick   = 0;     // the GPU work it skipped waiting for; 0 when nothing is to verify
+	};
+	void VerifySrtSpeculations();
 	// Unified memory: whether the GPU wrote [vaddr, vaddr + size) since the last call for it. GPU
 	// writes leave no fault: a reader that keeps its own copy (the image heap) asks.
 	[[nodiscard]] bool TakeUnifiedGpuWrites(uint64_t vaddr, uint64_t size);
@@ -221,6 +231,7 @@ private:
 	vk::Fence                                         m_unified_bind_fence {};
 	// Ranges bound for writing, by start: (end, tick of the command buffer that may write them).
 	std::map<uint64_t, std::pair<uint64_t, uint64_t>> m_pending_gpu_writes;
+	std::unordered_map<uint64_t, SrtSpeculation>      m_srt_speculation;
 	// The longest of them: no range starting further before an address can reach it.
 	uint64_t                                          m_pending_gpu_writes_span = 0;
 	// Ranges bound for writing that no TakeUnifiedGpuWrites has taken yet, and all of them.
