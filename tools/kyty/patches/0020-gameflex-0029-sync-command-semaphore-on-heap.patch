From: "Gino D." <25200363+zinosaure@users.noreply.github.com>
Date: Sun, 8 Nov 2026 21:49:26 +0000
Subject: [PATCH] gameflex 0029: sync command semaphore on heap
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

l'attente d'une commande du GPU hors de la pile du jeu

Détail : tools/kyty/README.md du dépôt GameFlex, entrée 0029.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/graphics/guest_gpu/graphicsRun.cpp | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/src/graphics/guest_gpu/graphicsRun.cpp b/src/graphics/guest_gpu/graphicsRun.cpp
index 781f50e1..07cbafe7 100644
--- a/src/graphics/guest_gpu/graphicsRun.cpp
+++ b/src/graphics/guest_gpu/graphicsRun.cpp
@@ -101,12 +101,15 @@ void GuestGpu::SendCommandSync(Common::UniqueFunction<void>&& command) {
 		command();
 		return;
 	}
-	std::binary_semaphore done {0};
-	SendCommand([operation = std::move(command), &done]() mutable {
+	// GameFlex: on the heap. The caller may be a guest thread, whose stack is guest memory: in
+	// unified memory a dma-buf mapping, where the shared futex behind std::binary_semaphore fails
+	// with EFAULT: libstdc++ throws std::system_error (Tekken 8) or a wake is lost (FF XVI).
+	auto done = std::make_shared<std::binary_semaphore>(0);
+	SendCommand([operation = std::move(command), done]() mutable {
 		operation();
-		done.release();
+		done->release();
 	});
-	done.acquire();
+	done->acquire();
 }
 
 void GuestGpu::Submit(std::span<const uint32_t> commands) {
