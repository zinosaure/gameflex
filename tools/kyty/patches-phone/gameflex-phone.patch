+	std::string  content;
+	Common::File original;
+	if (original.Open(real_name, Common::File::Mode::Read)) {
+		content.resize(original.Size());
+		original.Read(content.data(), static_cast<uint32_t>(content.size()));
+		original.Close();
+	}
+	const auto value = UnrealScreenPercentage();
+	if (value == 0) {
+		return {};
