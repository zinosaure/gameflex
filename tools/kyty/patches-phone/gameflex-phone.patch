+      {"K=0", {sub(4, InlineU32(0), 3), exec_prefix}, true},
+      {"K=64, s3 & 0xff",
+       {EncodeSop2(0x0e, 4, 3, 255), 0xffu, sub(4, InlineU32(64), 4), exec_prefix},
+       true},
+      {"K=64, 0xff & s3",
+       {EncodeSop2(0x0e, 4, 255, 3), 0xffu, sub(4, InlineU32(64), 4), exec_prefix},
