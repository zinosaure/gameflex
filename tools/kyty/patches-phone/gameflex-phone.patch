+	for (size_t i = 0; i < windows.size(); i++) {
+		const auto first = windows[i].second;
+		const auto last  = i + 1 < windows.size() ? windows[i + 1].second : static_cast<uint32_t>(binds.size());
+		buffer_binds.push_back({windows[i].first->Handle(), last - first, binds.data() + first});
+	}
+	vk::BindSparseInfo info {};
+	info.bufferBindCount = static_cast<uint32_t>(buffer_binds.size());
+	info.pBufferBinds    = buffer_binds.data();
+	if (!m_unified_bind_fence) {
+		vk::FenceCreateInfo fence_info {};
+		EXIT_NOT_IMPLEMENTED(m_graphics.device.createFence(&fence_info, nullptr, &m_unified_bind_fence) !=
+		                     vk::Result::eSuccess);
+	}
+	{
+		Common::LockGuard lock(m_graphics.queue_mutex);
+		EXIT_NOT_IMPLEMENTED(m_graphics.queue.bindSparse(1, &info, m_unified_bind_fence) !=
+		                     vk::Result::eSuccess);
+	}
+	{
+		Common::CommandThreadProfile::Scope ctp_wait(Common::CommandThreadProfile::WaitCause());
+		EXIT_NOT_IMPLEMENTED(m_graphics.device.waitForFences(1, &m_unified_bind_fence, VK_TRUE, UINT64_MAX) !=
+		                     vk::Result::eSuccess);
+	}
+	EXIT_NOT_IMPLEMENTED(m_graphics.device.resetFences(1, &m_unified_bind_fence) != vk::Result::eSuccess);
+
+	// The record of what is bound.
+	{
+		auto it = m_unified_views.upper_bound(begin);
+		if (it != m_unified_views.begin() && std::prev(it)->first + std::prev(it)->second.first > begin) {
+			--it;
+		}
+		std::vector<std::pair<uint64_t, std::pair<uint64_t, uint64_t>>> kept;
+		while (it != m_unified_views.end() && it->first < end) {
+			const auto view_begin = it->first;
+			const auto view_end   = it->first + it->second.first;
+			const auto offset     = it->second.second;
+			if (view_begin < begin) {
+				kept.push_back({view_begin, {begin - view_begin, offset}});
+			}
+			if (view_end > end) {
+				kept.push_back({end, {view_end - end, offset + (end - view_begin)}});
+			}
+			it = m_unified_views.erase(it);
+		}
+		for (const auto& entry: kept) {
+			m_unified_views.insert(entry);
+		}
+		for (const auto& [address, bytes, offset]: pieces) {
+			m_unified_views[address] = {bytes, offset};
+		}
+	}
+
+	// The BDA table: each page through the window of its GiB, or nothing.
+	std::vector<vk::DeviceAddress> addresses((end - begin) >> CACHING_PAGEBITS, 0);
+	for (const auto& [address, bytes, offset]: pieces) {
+		for (auto page = address; page < address + bytes; page += CACHING_PAGESIZE) {
+			const auto& window = m_slot_buffers[m_unified_windows[page >> UnifiedWindowBits]];
+			addresses[(page - begin) >> CACHING_PAGEBITS] =
+			    window.BufferDeviceAddress() + (page - window.CpuAddress());
+		}
+	}
+	if (!addresses.empty() && m_scheduler.Active() && !m_scheduler.Current().IsInvalid()) {
+		WriteDataBuffer(m_bda_pagetable_buffer, PageIndex(begin) * sizeof(vk::DeviceAddress),
+		                addresses.data(), addresses.size() * sizeof(vk::DeviceAddress));
+	}
+}
+
+bool BufferCache::PendingGuestWrite(uint64_t vaddr, uint64_t size, uint64_t* value) {
+	if (m_pending_guest_writes.empty()) {
+		return false;
+	}
+	// Labels written since the last expiry carry later ticks: the same tick has nothing to expire.
+	if (const auto done = m_scheduler.GetMasterSemaphore().KnownGpuTick(); done != m_pending_guest_writes_expired) {
+		m_pending_guest_writes_expired = done;
+		std::erase_if(m_pending_guest_writes, [done](const auto& entry) { return entry.second.tick <= done; });
+	}
+	const auto found = m_pending_guest_writes.find(vaddr);
+	if (found == m_pending_guest_writes.end() || found->second.size != size) {
+		return false;
+	}
+	*value = found->second.value;
+	return true;
+}
+
+void BufferCache::RecordUnifiedGpuWrite(uint64_t vaddr, uint64_t size) {
+	m_pending_gpu_writes.Add(vaddr, size, m_scheduler.CurrentTick());
+	m_unified_gpu_writes.Add(vaddr, size);
+	m_unified_gpu_written.Add(vaddr, size);
+}
+
+void BufferCache::FinishPendingGpuWrites(uint64_t vaddr, uint64_t size) {
+	if (HasPendingGpuWrites(vaddr, size)) {
+		Common::CommandThreadProfile::WaitReasonScope ctp_reason(Common::CommandThreadProfile::WaitReason::Read);
+		const auto ctp_wait = WordWaitAt(m_scheduler, m_pending_gpu_writes.LatestTick(vaddr, size));
+		m_scheduler.Finish();
+		Common::CommandThreadProfile::EndWordWait(ctp_wait);
+		m_pending_gpu_writes.Clear();
+	}
+}
+
+bool BufferCache::HasPendingGpuWrites(uint64_t vaddr, uint64_t size) {
+	if (m_pending_gpu_writes.Empty() || size == 0) {
+		return false;
+	}
+	m_pending_gpu_writes.Expire(m_scheduler.GetMasterSemaphore().KnownGpuTick());
+	return m_pending_gpu_writes.Intersects(vaddr, size);
+}
+
+// The recompiler reads a shader's tables of resources on the CPU when it records a draw or a dispatch. When a
+// word it reads lies in a range the GPU may still write, the only safe value is the GPU's: submit everything and
+// wait for it (Finish), which leaves the GPU dry while the thread records what follows. Games keep small counters
+// there that a compute pass rewrites every frame to the same value (Astro Bot: two 32-byte counters, 40 waits an
+// image, unchanged 5 196 times out of 5 218): once a word came out of eight waits unchanged, the read takes the
+// value in memory without waiting, and the GPU's value is checked once its work is done. A difference withdraws
+// the trust and says so on the console. A word that changes once, when a level loads, and then holds still
+// (Astro Bot's light counter: 4 then 6 for good) earned it back nowhere and cost two full drains an image,
+// 33 ms, once the thread stopped waiting for labels (0072): the trust comes back after twice as many unchanged
+// waits as the time before, and only the fifth difference revokes the word for good.
+//
+// GameFlex (0098): words of large ranges too. Clair Obscur waits four times an image for words of its tables, two of
+// them always 0 in ranges of 1.9 and 2.4 MB a pass rewrites every frame: 3.6 ms of the command thread and two drains
+// of the GPU an image. 0078 let any range speculate and was wrong five times, each a draw recorded with a wrong
+// resource: a word Clair Obscur alternates with another, a frame in four, held 0xffffffff in memory when the game came
+// back to it, which the GPU then cleared to 0. The value in memory was not the one the GPU had left there: the
+// region served something else meanwhile. A trusted word is now read ahead only while memory holds the value it
+// settled at, after its last wait or check; otherwise it waits, and keeps its trust. A word of a range larger than a
+// counter that is still wrong is a table entry that moves: its first difference revokes it for good.
+namespace {
+constexpr uint32_t kSpeculationConfirmations = 8;
+constexpr uint32_t kSpeculationMisses        = 5;   // differences before the word is revoked for good
+constexpr uint64_t kCounterRangeBytes        = 256; // a counter, not a table the GPU fills
+} // namespace
+
+void BufferCache::VerifySrtSpeculations() {
+	const auto done = m_scheduler.GetMasterSemaphore().KnownGpuTick();
+	std::erase_if(m_srt_verifications, [&](uint64_t address) {
+		auto& speculation = m_srt_speculation[address];
+		if (speculation.verify_tick == 0) {
+			return true;
+		}
+		if (speculation.verify_tick > done) {
+			return false;
+		}
+		speculation.verify_tick = 0;
+		uint32_t landed = 0;
+		if (!LibKernel::Memory::TryReadBacking(address, &landed, sizeof(landed))) {
+			return true;
+		}
+		speculation.settled = landed;
+		if (landed == speculation.used) {
+			return true;
+		}
+		Common::CommandThreadProfile::Count(Common::CommandThreadProfile::Event::SrtMissed);
+		speculation.trusted       = false;
+		speculation.confirmations = 0;
+		speculation.revoked       = ++speculation.misses >= (speculation.large ? 1u : kSpeculationMisses);
+		static uint32_t misses = 0;
+		if (misses++ < 50) {
+			std::printf("SRT speculation: the GPU wrote 0x%08x at 0x%016" PRIx64 " after 0x%08x was used%s; "
+			            "this word waits again%s\n",
+			            landed, address, speculation.used, speculation.large ? " (large range)" : "",
+			            speculation.revoked ? " from now on" : " until it holds still for longer");
+		}
+		return true;
+	});
+}
+
+bool BufferCache::FinishPendingGpuWritesUnder(std::span<const uint64_t> addresses) {
+	Common::CommandThreadProfile::WaitReasonScope ctp_reason(Common::CommandThreadProfile::WaitReason::Srt);
+	if (m_pending_gpu_writes.Empty()) {
+		return false;
+	}
+	m_pending_gpu_writes.Expire(m_scheduler.GetMasterSemaphore().KnownGpuTick());
+	if (!m_srt_verifications.empty()) {
+		VerifySrtSpeculations();
+	}
+	if (m_pending_gpu_writes.Empty()) {
+		return false;
+	}
+	for (const auto address: addresses) {
+		const auto* range = m_pending_gpu_writes.Find(address);
+		if (range == nullptr) {
+			continue;
+		}
+		auto& speculation = m_srt_speculation[address];
+		if (speculation.trusted) {
+			uint32_t used = 0;
+			if (LibKernel::Memory::TryReadBacking(address, &used, sizeof(used))) {
+				// Memory holds what the GPU left there last (or what an unchecked read ahead took): read ahead.
+				if (used == (speculation.verify_tick != 0 ? speculation.used : speculation.settled)) {
+					if (speculation.verify_tick == 0) {
+						speculation.used = used;
+						m_srt_verifications.push_back(address);
+					}
+					speculation.verify_tick = std::max(speculation.verify_tick, range->tick);
+					Common::CommandThreadProfile::Count(Common::CommandThreadProfile::Event::SrtReadAhead);
+					continue;
+				}
+				Common::CommandThreadProfile::Count(Common::CommandThreadProfile::Event::SrtHeld);
+			}
+		}
+		uint32_t before = 0;
+		LibKernel::Memory::TryReadBacking(address, &before, sizeof(before));
+		const auto range_size = range->end - range->start;
+		// GameFlex: this Finish settles every word of the table the GPU may still write, not this one alone: a wait
+		// for their writers alone would wait for the latest of those not trusted (CommandThreadProfile).
+		auto ctp_writer = range->tick;
+		if (Common::CommandThreadProfile::Counting()) {
+			for (const auto other: addresses) {
+				const auto* other_range = m_pending_gpu_writes.Find(other);
+				const auto  trust       = m_srt_speculation.find(other);
+				if (other_range != nullptr && (trust == m_srt_speculation.end() || !trust->second.trusted)) {
+					ctp_writer = std::max(ctp_writer, other_range->tick);
+				}
+			}
+		}
+		const auto ctp_wait = WordWaitAt(m_scheduler, ctp_writer);
+		m_scheduler.Finish();
+		Common::CommandThreadProfile::EndWordWait(ctp_wait);
+		m_pending_gpu_writes.Clear();
+		uint32_t after = 0;
+		LibKernel::Memory::TryReadBacking(address, &after, sizeof(after));
+		speculation.settled = after;
+		speculation.large   = range_size > kCounterRangeBytes;
+		if (!speculation.revoked) {
+			if (after != before) {
+				speculation.confirmations = 0;
+			} else if (++speculation.confirmations >= kSpeculationConfirmations << speculation.misses) {
+				speculation.trusted = true;
+			}
+		}
+		return true;
+	}
+	return false;
+}
+
+// The command processor's own comparison (graphicsRun.cpp).
+bool TestWaitRegMemValue(uint64_t value, uint64_t ref, uint64_t mask, uint32_t func);
+
+// Astro Bot's graphics queue waits about nine times an image for a flag its compute work sets to 1, each time
+// submitting, then polling until the GPU wrote it: 35 ms an image, the GPU and the thread taking turns. The
+// compute work is recorded before, on the same Vulkan queue: the wait needs only a barrier, if the flag lands.
+// The check read the flag in memory once the writer's work was done, which may be long after: the game clears
+// its flags once it saw them, and Astro Bot's three busiest ones were revoked while the level loaded, each wait
+// then a 40 ms drain. The GPU copies the value where the wait is in the stream, which is what the wait saw.
+namespace {
+constexpr uint32_t kFlagConfirmations = 4;
+constexpr uint32_t kFlagCaptureSlots  = 1024; // trusted waits not checked yet, 8 bytes each
+} // namespace
+
+void BufferCache::VerifyFlagSpeculations() {
+	const auto done = m_scheduler.GetMasterSemaphore().KnownGpuTick();
+	std::erase_if(m_flag_verifications, [&](const FlagCheck& check) {
+		if (check.tick > done) {
+			return false;
+		}
+		const auto offset = uint64_t {check.slot} * sizeof(uint64_t);
+		m_flag_captures->Invalidate(offset, sizeof(uint64_t));
+		uint64_t seen = 0;
+		std::memcpy(&seen, m_flag_captures->Mapped().data() + offset, check.size);
+		if (TestWaitRegMemValue(seen, check.ref, check.mask, check.func)) {
+			return true;
+		}
+		auto& flag   = m_flag_speculation[check.address];
+		flag.trusted = false;
+		flag.revoked = true;
+		static uint32_t misses = 0;
+		if (misses++ < 50) {
+			std::printf("Guest wait speculation: 0x%016" PRIx64 " held 0x%" PRIx64 " where the wait was, which "
+			            "wanted 0x%" PRIx64 "; this address waits again from now on\n",
+			            check.address, seen, check.ref);
+		}
+		return true;
+	});
+}
+
+bool BufferCache::TrustPendingGpuWrite(uint64_t vaddr, uint64_t size, uint32_t func, uint64_t ref, uint64_t mask) {
+	if (m_pending_gpu_writes.Empty()) {
+		return false;
+	}
+	m_pending_gpu_writes.Expire(m_scheduler.GetMasterSemaphore().KnownGpuTick());
+	if (!m_flag_verifications.empty()) {
+		VerifyFlagSpeculations();
+	}
+	const auto* range = m_pending_gpu_writes.Find(vaddr);
+	if (range == nullptr) {
+		return false;
+	}
+	auto& flag = m_flag_speculation[vaddr];
+	if (flag.revoked) {
+		return false;
+	}
+	if (!flag.trusted) {
+		flag.waiting = true;
+		return false;
+	}
+	// Checks end in the order they were recorded: with fewer than kFlagCaptureSlots waiting, the next slot is free.
+	const auto window = UnifiedWindow(vaddr, size);
+	if (!window || m_flag_verifications.size() >= kFlagCaptureSlots) {
+		return false;
+	}
+	if (!m_flag_captures) {
+		m_flag_captures = std::make_unique<Buffer>(m_graphics, m_scheduler, MemoryUsage::Download, 0,
+		                                           vk::BufferUsageFlagBits::eTransferDst,
+		                                           kFlagCaptureSlots * sizeof(uint64_t));
+	}
+	const auto slot = m_flag_capture_next;
+	m_flag_capture_next = (m_flag_capture_next + 1) % kFlagCaptureSlots;
+	auto& source  = m_slot_buffers[window];
+	auto& command = m_scheduler.Current();
+	command.EndRendering();
+	const auto native = command.Handle();
+	// Everything recorded before is done and its writes land first, as the wait asks of the command processor.
+	vk::MemoryBarrier before {};
+	before.srcAccessMask = vk::AccessFlagBits::eMemoryWrite;
+	before.dstAccessMask = vk::AccessFlagBits::eTransferRead;
+	native.pipelineBarrier(vk::PipelineStageFlagBits::eAllCommands, vk::PipelineStageFlagBits::eTransfer, {}, 1,
+	                       &before, 0, nullptr, 0, nullptr);
+	const vk::BufferCopy copy {source.Offset(vaddr), uint64_t {slot} * sizeof(uint64_t), size};
+	native.copyBuffer(source.Handle(), m_flag_captures->Handle(), 1, &copy);
+	vk::MemoryBarrier after {};
+	after.srcAccessMask = vk::AccessFlagBits::eTransferWrite;
+	after.dstAccessMask = vk::AccessFlagBits::eHostRead;
+	native.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer, vk::PipelineStageFlagBits::eHost, {}, 1, &after, 0,
+	                       nullptr, 0, nullptr);
+	m_flag_verifications.push_back({vaddr, m_scheduler.CurrentTick(), ref, mask, func, static_cast<uint32_t>(size),
+	                                slot});
+	return true;
+}
+
+void BufferCache::GuestWaitPassed(uint64_t vaddr) {
+	if (m_flag_speculation.empty()) {
+		return;
+	}
+	const auto found = m_flag_speculation.find(vaddr);
+	if (found == m_flag_speculation.end() || !found->second.waiting) {
+		return;
+	}
+	auto& flag   = found->second;
+	flag.waiting = false;
+	if (!flag.revoked && ++flag.confirmations >= kFlagConfirmations) {
+		flag.trusted = true;
+	}
+}
+
+bool BufferCache::TakeUnifiedGpuWrites(uint64_t vaddr, uint64_t size) {
+	if (!m_unified_gpu_writes.Intersects(vaddr, size)) {
+		return false;
+	}
+	m_unified_gpu_writes.Subtract(vaddr, size);
+	return true;
+}
+
+bool BufferCache::IsUnifiedGpuWritten(uint64_t vaddr, uint64_t size) const {
+	return m_unified_gpu_written.Intersects(vaddr, size);
+}
+
+void BufferCache::ForgetUnifiedRange(uint64_t vaddr, uint64_t size) {
+	if (!IsUnified() || size == 0) {
+		return;
+	}
+	const auto begin = Common::AlignDown(vaddr, CACHING_PAGESIZE);
+	const auto end   = Common::AlignUp(vaddr + size, CACHING_PAGESIZE);
+	m_unified_gpu_writes.Subtract(begin, end - begin);
+	m_unified_gpu_written.Subtract(begin, end - begin);
+	auto       it    = m_unified_views.upper_bound(begin);
+	if (it != m_unified_views.begin() && std::prev(it)->first + std::prev(it)->second.first > begin) {
+		--it;
+	}
+	if (it == m_unified_views.end() || it->first >= end) {
+		return;
+	}
+	BindUnifiedPieces(begin, end, {});
+}
+
+bool BufferCache::WriteGuestMemory(uint64_t vaddr, const void* data, uint64_t size) {
+	if (!IsUnified() || ((vaddr | size) & 3u) != 0 || size == 0 || size > 65536) {
+		return false;
+	}
+	const auto id = UnifiedWindow(vaddr, size);
+	if (!id) {
+		return false;
+	}
+	auto&      buffer = m_slot_buffers[id];
+	const auto offset = buffer.Offset(vaddr);
+	auto&      command = m_scheduler.Current();
+	// A label is the console's end-of-pipe write: written once everything recorded before is done, without
+	// stopping what follows. The buffer marker is that write; the low word first, so a reader waiting for a
+	// growing value never sees it early. Only the CPU and WAIT_REG_MEM read labels: nothing to release.
+	if (m_graphics.buffer_marker_enabled && (size == 4u || size == 8u)) {
+		uint32_t words[2] {};
+		std::memcpy(words, data, size);
+		for (uint32_t i = 0; i < size / 4u; i++) {
+			command.Handle().writeBufferMarker2AMD(vk::PipelineStageFlagBits2::eAllCommands, buffer.Handle(),
+			                                       offset + i * 4u, words[i]);
+		}
+		uint64_t value = 0;
+		std::memcpy(&value, data, size);
+		m_pending_guest_writes[vaddr] = {size, m_scheduler.CurrentTick(), value};
+		RecordUnifiedGpuWrite(vaddr, size);
+		return true;
+	}
+	command.EndRendering();
+	const auto native = command.Handle();
+	// Everything recorded before lands first, as the GPU's own end-of-pipe write would.
+	vk::MemoryBarrier before {};
+	before.srcAccessMask = vk::AccessFlagBits::eMemoryWrite;
+	before.dstAccessMask = vk::AccessFlagBits::eTransferWrite;
+	native.pipelineBarrier(vk::PipelineStageFlagBits::eAllCommands,
+	                       vk::PipelineStageFlagBits::eTransfer, {}, 1, &before, 0, nullptr, 0,
+	                       nullptr);
+	native.updateBuffer(buffer.Handle(), offset, size, data);
+	if (size <= sizeof(uint64_t)) {
+		uint64_t value = 0;
+		std::memcpy(&value, data, size);
+		m_pending_guest_writes[vaddr] = {size, m_scheduler.CurrentTick(), value};
+	}
+	RecordUnifiedGpuWrite(vaddr, size);
+	vk::MemoryBarrier after {};
+	after.srcAccessMask = vk::AccessFlagBits::eTransferWrite;
+	after.dstAccessMask = vk::AccessFlagBits::eMemoryRead | vk::AccessFlagBits::eMemoryWrite |
+	                      vk::AccessFlagBits::eHostRead;
+	native.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer,
+	                       vk::PipelineStageFlagBits::eAllCommands |
+	                           vk::PipelineStageFlagBits::eHost,
+	                       {}, 1, &after, 0, nullptr, 0, nullptr);
+	return true;
+}
+
+std::pair<Buffer*, uint64_t> BufferCache::UnifiedGpuWriteTarget(uint64_t vaddr, uint64_t size) {
+	if (!IsUnified()) {
+		return {nullptr, 0};
+	}
+	const auto id = UnifiedWindow(vaddr, size);
+	if (!id) {
+		return {nullptr, 0};
+	}
+	auto& buffer = m_slot_buffers[id];
+	ForgetColorMetadataChecks(vaddr, size);
+	RecordUnifiedGpuWrite(vaddr, size);
+	return {&buffer, buffer.Offset(vaddr)};
+}
+
 } // namespace Libs::Graphics
