{
    "name": "gameflex-edge",
    "version": "0.1.0",
    "private": true,
    "description": "GameFlex edge — the interface (chantier 56): the development server (npm start) and the production build (npm run build)",
    "scripts": {
        "start": "webpack serve --config webpack.config.mjs --mode development --host 0.0.0.0 --port 3000",
        "build": "webpack --config webpack.config.mjs --mode production",
        "build:federation": "webpack --config webpack.config.mjs --mode production --env target=federation"
    },
    "dependencies": {
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.11.0",
        "i18next": "^23.16.8",
        "jquery": "^3.7.1",
        "qrcode-generator": "^1.4.4",
        "react": "^18.2.0",
        "react-bootstrap": "^2.10.10",
        "react-dom": "^18.2.0",
        "react-i18next": "^14.1.3",
        "react-router-dom": "^6.22.3"
    },
    "devDependencies": {
        "@babel/core": "^7.23.7",
        "@babel/preset-env": "^7.23.8",
        "@babel/preset-react": "^7.23.3",
        "babel-loader": "^9.1.3",
        "copy-webpack-plugin": "^11.0.0",
        "css-loader": "^6.9.0",
        "html-webpack-plugin": "^5.6.0",
        "sass": "^1.77.8",
        "sass-loader": "^14.2.1",
        "style-loader": "^3.3.4",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^4.15.0"
    }
}
