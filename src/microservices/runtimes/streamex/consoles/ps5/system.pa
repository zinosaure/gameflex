# Configuration PulseAudio minimale pour le conteneur PS4 (mode --system).
#
# - auth-anonymous=1 : pas de cookie d'authentification.
# - sink null kyty_sink : KytyPS5 y envoie son audio, streamex capture son monitor.

load-module module-null-sink sink_name=kyty_sink sink_properties=device.description=KytyPS5
load-module module-native-protocol-unix auth-anonymous=1
set-default-sink kyty_sink
set-default-source kyty_sink.monitor
