{
  "window_name": "eden",
  "emulator_fps": {
    "accessible_name": "^Game: ([0-9.]+) FPS"
  },
  "games": {
    "dir": "/opt/game",
    "rules": [
      {
        "extension": ".xci"
      },
      {
        "extension": ".nsp"
      }
    ]
  },
  "launch": {
    "bin": "/opt/eden/AppRun",
    "cwd": "/opt/eden",
    "base_args": [
      "eden",
      "-f",
      "-g"
    ],
    "process_group": false
  },
  "stop": {
    "mode": "pkill",
    "process_name": "eden"
  },
  "gamepad": {
    "enabled": true,
    "swap_xy_from_slot": -1
  },
  "tools": [
    {
      "name": "cemuhook"
    },
